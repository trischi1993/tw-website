{
  // PRODUKTIONS-Worker: statische Assets plus ein schmaler API-Endpunkt für
  // den Systeme.io-Lead des Instagram-Erfolgs-Checks.
  //
  // Statische Treffer werden weiterhin direkt und kostenlos ausgeliefert. Nur
  // `/api/*` läuft zuerst durch `src/workers/prod.ts`; alle Website-Assets
  // umgehen den Worker-Code. Der Systeme.io-API-Key ist ein Cloudflare-Secret
  // namens `SYSTEME_API_KEY` und darf niemals in dieser Datei stehen.
  //
  // Warum ein Worker statt Cloudflare Pages: Pages ist eingefroren, und der
  // Astro-Cloudflare-Adapter hat Pages-Support seit v13 entfernt. Der statische
  // Output bleibt identisch - nur der Host davor wechselt. Static-Requests sind
  // wie bei Pages gratis & unlimitiert; kein Token, kein React im Output.
  //
  // Deploy (lokal oder in Workers Builds):
  //   npm run build && npx wrangler deploy -c wrangler.prod.jsonc
  //
  // Cloudflare respektiert die von Astro erzeugten `dist/_headers` und
  // `dist/_redirects` genau wie unter Pages.
  //
  // Pro Projekt umbenennen (Platzhalter, wird von scripts/init.mjs ersetzt):
  "name": "tristanweithaler-prod",
  // Fest gepinnt auf TRISTANS Cloudflare-Konto (Tristanweithaler@gmail.com) -
  // verhindert versehentliche Deploys in Julians upgreight-Konto.
  "account_id": "ee216d2fdff2e29b5093ae6287b5eb8f",
  "compatibility_date": "2025-05-05",
  "main": "./src/workers/prod.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Fehlende Pfade liefern die statische 404-Seite (Astro erzeugt dist/404.html)
    // mit HTTP-404 statt eines nackten Worker-404.
    "not_found_handling": "404-page"
  },
  "vars": {
    "SYSTEME_TAG_NAME": "Freebies - Download"
  },
  "observability": {
    "enabled": true
  }
}
