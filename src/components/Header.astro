---
import arrowWhite from '../assets/images/icon-arrow-white.svg';
import { getSiteSettings } from '../lib/content';
import { safeHref } from '../lib/safe-href';
import { siteNavigationHref } from '../lib/site-navigation';
import { UI as t } from '../lib/i18n';

interface Props {
  context?: 'main' | 'ebook';
}

const { context = 'main' } = Astro.props;
const MAIN_ORIGIN = 'https://tristanweithaler.com';
const EBOOK_ORIGIN = 'https://ebook.tristanweithaler.com';

/**
 * Fixe Navbar (Webflow .navbar, global-chrome.md §5) — Struktur 1:1 nach dem
 * Export: Split-Wortmarke mit Overflow-Masken (Load-Anim schiebt die Texte
 * aus ±140 % ein, motion/home-load u. a. via data-nav-logo-text), Goldlinie,
 * Desktop-Links mit Underline-Wipe (motion/buttons.ts), Glow-CTA, Burger NUR
 * ≤991 (im Original ist .navbar_menu-button auf Desktop display:none — das
 * Fullscreen-Menü existiert nur auf Tablet/Mobile, IX2 a-121/a-122).
 * Mobile Menü- und Rotationslogik laufen parser-früh im Inline-Controller
 * unten, ohne ein Menü-/GSAP-Modul im kritischen Ladepfad.
 */
const settings = await getSiteSettings();
const isExternal = (href: string) => {
  if (!/^https?:\/\//.test(href)) return false;
  const origin = new URL(href).origin;
  return origin !== MAIN_ORIGIN && origin !== EBOOK_ORIGIN;
};
const contextHref = (href: string) => {
  const safe = siteNavigationHref(href);
  if (context !== 'ebook') return safe;
  if (safe === '/e-book/') return `${EBOOK_ORIGIN}/`;
  return safe.startsWith('/') ? new URL(safe, MAIN_ORIGIN).href : safe;
};
const homeHref = context === 'ebook' ? `${MAIN_ORIGIN}/` : '/';

/** Fullscreen-Menü: Startseite + Hauptnavigation (global-chrome.md §5). */
const navItems = settings.nav.map((item) => ({
  ...item,
  href: contextHref(item.href),
}));
const menuItems = [{ label: 'Startseite', href: homeHref }, ...navItems];
const headerCtaHref = settings.headerCta
  ? contextHref(safeHref(settings.headerCta.href))
  : undefined;
---
<header class="navbar" data-site-header data-navigation-context={context}>
  <div class="navbar__container">
  {/* Eine einzige Wortmarke fuer alle Breakpoints. Die auf Mobile sichtbaren
      Anfangsbuchstaben sind dieselben Textknoten wie in der Langform; nur die
      Suffixe werden ausgeblendet. So muss WebKit beim Drehen keine zweite
      T|W-Zeichenebene gegen Tristan|Weithaler austauschen. */}
  <a href={homeHref} class="navbar__logo">
    <span class="navbar__logo-word is-1">
      <span class="navbar__logo-text" data-nav-logo-text="1">T<span class="navbar__logo-suffix">ristan</span></span>
    </span>
    <span class="navbar__logo-line" data-nav-logo-line aria-hidden="true"></span>
    <span class="navbar__logo-word is-2">
      <span class="navbar__logo-text" data-nav-logo-text="2">W<span class="navbar__logo-suffix">eithaler</span></span>
    </span>
    <span class="visually-hidden">{`, ${t.toStart}`}</span>
  </a>

  <div class="navbar__right" data-nav-right>
    <div class="navbar__right-inner" data-nav-right-inner>
      <nav class="navbar__menu" aria-label={t.mainNav}>
        <ul role="list" class="navbar__list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="navbar__link link-underline"
                  data-underline
                  target={isExternal(item.href) ? '_blank' : undefined}
                  rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
                >
                  <span class="link-underline__label">{item.label}</span>
                  <span class="link-underline__line" aria-hidden="true"></span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        class="navbar__burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-nav-toggle
      >
        <span class="visually-hidden">{t.menu}</span>
        <span class="navbar__burger-line is-top" data-burger-top aria-hidden="true"></span>
        <span class="navbar__burger-line is-middle" data-burger-middle aria-hidden="true"></span>
        <span class="navbar__burger-line is-bottom" data-burger-bottom aria-hidden="true"></span>
      </button>

      {
        settings.headerCta && (
          <a
            class="btn-glow navbar__cta"
            href={headerCtaHref}
            rel="nofollow"
            data-glow
          >
            <span class="btn-glow__circle" aria-hidden="true" data-glow-circle="" />
            <span class="btn-glow__wrapper">
              <span class="btn-glow__content">
                <svg
                  class="navbar__cta-gift"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="8" width="18" height="4" rx="1" />
                  <path d="M12 8v13" />
                  <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                  <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8Z" />
                  <path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8Z" />
                </svg>
                <span class="btn-glow__label">{settings.headerCta.label}</span>
              </span>
            </span>
          </a>
        )
      }
    </div>
  </div>
  </div>
</header>

<div class="menu" id="site-menu" data-site-menu hidden>
  <nav class="menu__panel" aria-label={t.menu} data-menu-panel>
    <div class="menu__spacer" aria-hidden="true"></div>
    {
      menuItems.map((item) => (
        <a
          href={item.href}
          class="menu__link"
          data-menu-link
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
        >
          <span class="menu__wipe" data-menu-wipe aria-hidden="true"></span>
          <span class="menu__click-wipe" data-menu-click-wipe aria-hidden="true"></span>
          <span class="menu__text" data-menu-text>{item.label}</span>
          <img
            class="menu__arrow"
            data-menu-arrow
            src={arrowWhite.src}
            alt=""
            width="36"
            height="36"
            loading="lazy"
          />
        </a>
      ))
    }
  </nav>
</div>

<!-- Diese zwei kritischen Regeln stehen bewusst vor dem parser-fruehen
     Controller. So kennt der Browser den geschlossenen Compositor-Zustand
     bereits beim allerersten moeglichen Touch – auch bevor der nachfolgende
     komplette Komponenten-Style verarbeitet wurde. -->
<style is:inline>
  @media (max-width: 991px) {
    .menu[data-menu-prepared] .menu__panel {
      transform: translate3d(-100%, 0, 0);
      will-change: transform;
      transition: transform 520ms cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .menu[data-menu-prepared].is-menu-open .menu__panel {
      transform: translate3d(0, 0, 0);
      transition-duration: 720ms;
    }
  }
</style>

<!-- Der mobile Menue-Controller laeuft absichtlich inline waehrend des
     HTML-Parsens. Damit steht er auf jeder Seite vor allen deferred Modulen
     bereit und beginnt die sichtbare Bewegung direkt mit dem Fingerkontakt.
     Es gibt mobil keine spaetere Uebergabe an einen zweiten Controller. -->
<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const toggle = document.querySelector('[data-nav-toggle]');
    const menu = document.querySelector('[data-site-menu]');
    const panel = menu?.querySelector('[data-menu-panel]');
    if (!header || !toggle || !menu || !panel) return;

    const links = Array.from(menu.querySelectorAll('[data-menu-link]'));
    const texts = links.map((link) => link.querySelector('[data-menu-text]'));
    const wipes = links.map((link) => link.querySelector('[data-menu-wipe]'));
    const arrows = Array.from(menu.querySelectorAll('[data-menu-arrow]'));
    const burgerTop = header.querySelector('[data-burger-top]');
    const burgerMiddle = header.querySelector('[data-burger-middle]');
    const burgerBottom = header.querySelector('[data-burger-bottom]');
    const navRight = header.querySelector('[data-nav-right]');
    const rightInner = header.querySelector('[data-nav-right-inner]');
    const headerCta = header.querySelector('.navbar__cta');
    const mobile = window.matchMedia('(max-width: 991px)');
    const portrait = window.matchMedia('(orientation: portrait)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ease = 'cubic-bezier(0.25, 0.1, 0.25, 1)';
    const outQuart = 'cubic-bezier(0.165, 0.84, 0.44, 1)';
    const inOutQuart = 'cubic-bezier(0.76, 0, 0.24, 1)';
    /* Marker fuer Tests und optionale Progressive-Enhancement-Fallbacks: Der
       mobile Controller ist bereits waehrend des Parsens vollstaendig aktiv. */
    toggle.setAttribute('data-inline-mobile-menu', '');

    let isOpen = false;
    let menuPhase = 'closed';
    let transitionId = 0;
    let completionTimer;
    let suppressNextClick = false;
    let aioVideoPauseTimer;
    let inputModality = 'pointer';
    let lastTouchAt = -Infinity;
    let lastFocused = null;
    let runningAnimations = [];
    let inertBackdrop = [];
    let aioHeroVideo = null;
    let pausedAioHeroVideo = null;
    const hoverAnimations = new Map();

    document.addEventListener('DOMContentLoaded', () => {
      const video = document.querySelector('[data-aio-hero] video');
      aioHeroVideo = video instanceof HTMLVideoElement ? video : null;
    }, { once: true });

    const computed = (element, property) =>
      element ? getComputedStyle(element)[property] : '';

    const cancelAnimations = () => {
      runningAnimations.forEach((animation) => animation.cancel());
      runningAnimations = [];
    };

    const play = (element, keyframes, options) => {
      if (!element) return undefined;
      const animation = element.animate(keyframes, { fill: 'both', ...options });
      runningAnimations.push(animation);
      return animation;
    };

    const setInputModality = (modality) => {
      inputModality = modality;
      header.dataset.menuInput = modality;
      menu.dataset.menuInput = modality;
    };

    const pauseAioVideoBehindMenu = () => {
      if (!(aioHeroVideo instanceof HTMLVideoElement)) {
        const video = document.querySelector('[data-aio-hero] video');
        aioHeroVideo = video instanceof HTMLVideoElement ? video : null;
      }
      if (
        !(aioHeroVideo instanceof HTMLVideoElement) ||
        aioHeroVideo.paused ||
        !aioHeroVideo.muted
      ) return;
      pausedAioHeroVideo = aioHeroVideo;
      aioHeroVideo.pause();
    };

    const clearScheduledVideoPause = () => {
      if (aioVideoPauseTimer !== undefined) clearTimeout(aioVideoPauseTimer);
      aioVideoPauseTimer = undefined;
    };

    const scheduleAioVideoPause = () => {
      clearScheduledVideoPause();
      /* Der erste sichtbare Menue-Frame hat Vorrang. Das Video wird erst kurz
         danach pausiert, damit weder DOM-Suche noch Decoder-Umschaltung den
         unmittelbaren Touch-Feedback-Pfad auf Mobile Safari blockieren. */
      aioVideoPauseTimer = setTimeout(() => {
        aioVideoPauseTimer = undefined;
        if (isOpen) pauseAioVideoBehindMenu();
      }, 80);
    };

    const resumeAioVideoAfterMenu = () => {
      if (!(pausedAioHeroVideo instanceof HTMLVideoElement)) return;
      const video = pausedAioHeroVideo;
      pausedAioHeroVideo = null;
      void video.play().catch(() => {});
    };

    /* ---------------------------------------------------------------------
       Parser-fruehe Header-Rotationssicherung. Sie ersetzt die fruehere
       menu.ts/GSAP-Abhaengigkeit vollständig, sodass die ganze fixe Navbar
       schon vor `window.load` verborgen werden kann. Wartezeiten und sichtbare
       Replay-Choreografie entsprechen exakt dem bisherigen Ablauf. */
    const logoText1 = Array.from(header.querySelectorAll('[data-nav-logo-text="1"]'));
    const logoText2 = Array.from(header.querySelectorAll('[data-nav-logo-text="2"]'));
    const logoLines = Array.from(header.querySelectorAll('[data-nav-logo-line]'));
    const headerMotionTargets = [
      ...logoText1,
      ...logoText2,
      ...logoLines,
      ...(navRight ? [navRight] : []),
    ];
    const MIN_HIDE_MS = 600;
    const VIEWPORT_QUIET_MS = 160;
    const HARD_SETTLE_MS = 1500;
    let orientationPending = false;
    let pendingPortrait = portrait.matches;
    let orientationStartedAt = 0;
    let lastViewportChangeAt = 0;
    let orientationSettleTimer;
    let orientationHardTimer;
    let orientationCleanupTimer;
    let orientationReplayId = 0;
    let orientationAnimations = [];
    let orientationMenuWasOpen = false;

    const cancelOrientationAnimations = () => {
      orientationReplayId += 1;
      if (orientationCleanupTimer !== undefined) clearTimeout(orientationCleanupTimer);
      orientationCleanupTimer = undefined;
      orientationAnimations.forEach((animation) => animation.cancel());
      orientationAnimations = [];
      headerMotionTargets.forEach((target) => {
        target.getAnimations().forEach((animation) => animation.cancel());
      });
    };

    const clearOrientationStyles = () => {
      [...logoText1, ...logoText2].forEach((element) => {
        element.style.removeProperty('transform');
        element.style.removeProperty('will-change');
      });
      logoLines.forEach((element) => {
        element.style.removeProperty('height');
        element.style.removeProperty('transform');
        element.style.removeProperty('transform-origin');
        element.style.removeProperty('will-change');
      });
      if (navRight) {
        navRight.style.removeProperty('transform');
        navRight.style.removeProperty('opacity');
        navRight.style.removeProperty('will-change');
      }
    };

    const playOrientation = (element, keyframes, options) => {
      if (!element) return;
      const animation = element.animate(keyframes, { fill: 'both', ...options });
      orientationAnimations.push(animation);
    };

    const finishOrientationChange = () => {
      if (!orientationPending) return;
      orientationPending = false;
      if (orientationSettleTimer !== undefined) clearTimeout(orientationSettleTimer);
      if (orientationHardTimer !== undefined) clearTimeout(orientationHardTimer);
      orientationSettleTimer = undefined;
      orientationHardTimer = undefined;

      cancelOrientationAnimations();
      clearOrientationStyles();
      const keepMenuState = orientationMenuWasOpen || isOpen;
      orientationMenuWasOpen = false;
      if (reducedMotion.matches || keepMenuState) {
        header.classList.remove('is-orientation-changing');
        menu.classList.remove('is-orientation-changing');
        return;
      }

      const replayId = ++orientationReplayId;
      logoText1.forEach((element) => {
        element.style.transform = 'translate3d(0, 0, 0)';
        element.style.willChange = 'transform';
        playOrientation(element, [
          { transform: 'translate3d(140%, 0, 0)' },
          { transform: 'translate3d(0, 0, 0)' },
        ], { duration: 900, delay: 60, easing: outQuart });
      });
      logoText2.forEach((element) => {
        element.style.transform = 'translate3d(0, 0, 0)';
        element.style.willChange = 'transform';
        playOrientation(element, [
          { transform: 'translate3d(-140%, 0, 0)' },
          { transform: 'translate3d(0, 0, 0)' },
        ], { duration: 900, delay: 60, easing: outQuart });
      });
      logoLines.forEach((element) => {
        element.style.transform = 'scaleY(1)';
        element.style.transformOrigin = '50% 50%';
        element.style.willChange = 'transform';
        playOrientation(element, [
          { transform: 'scaleY(0)' },
          { transform: 'scaleY(1)' },
        ], { duration: 500, easing: outQuart });
      });
      if (navRight) {
        navRight.style.opacity = '1';
        navRight.style.transform = 'translate3d(0, 0, 0)';
        navRight.style.willChange = 'transform, opacity';
        playOrientation(navRight, [{ opacity: 0 }, { opacity: 1 }], {
          duration: 1080,
          delay: 60,
          easing: ease,
        });
        playOrientation(navRight, [
          { transform: 'translate3d(2.5rem, 0, 0)' },
          { transform: 'translate3d(0, 0, 0)' },
        ], { duration: 900, delay: 60, easing: outQuart });
      }

      // Alle Startwerte stehen noch hinter dem Whole-Navbar-Guard. Erst jetzt
      // wird der definierte erste Replay-Frame sichtbar.
      header.classList.remove('is-orientation-changing');
      menu.classList.remove('is-orientation-changing');
      orientationCleanupTimer = setTimeout(() => {
        if (replayId !== orientationReplayId) return;
        orientationAnimations.forEach((animation) => animation.cancel());
        orientationAnimations = [];
        orientationCleanupTimer = undefined;
        clearOrientationStyles();
      }, 1150);
    };

    const scheduleOrientationFinish = () => {
      if (!orientationPending) return;
      if (orientationSettleTimer !== undefined) clearTimeout(orientationSettleTimer);
      const now = performance.now();
      const earliestFinish = Math.max(
        orientationStartedAt + MIN_HIDE_MS,
        lastViewportChangeAt + VIEWPORT_QUIET_MS,
      );
      orientationSettleTimer = setTimeout(
        finishOrientationChange,
        Math.max(0, earliestFinish - now),
      );
    };

    const beginOrientationChange = () => {
      const isPortrait = portrait.matches;
      const now = performance.now();
      if (orientationPending && isPortrait === pendingPortrait) {
        lastViewportChangeAt = now;
        scheduleOrientationFinish();
        return;
      }

      orientationPending = true;
      pendingPortrait = isPortrait;
      orientationStartedAt = now;
      lastViewportChangeAt = now;
      orientationMenuWasOpen = isOpen;
      header.classList.add('is-orientation-changing');
      menu.classList.add('is-orientation-changing');
      cancelOrientationAnimations();
      if (orientationSettleTimer !== undefined) clearTimeout(orientationSettleTimer);
      if (orientationHardTimer !== undefined) clearTimeout(orientationHardTimer);
      scheduleOrientationFinish();
      orientationHardTimer = setTimeout(finishOrientationChange, HARD_SETTLE_MS);
    };

    const handleViewportResize = () => {
      if (!orientationPending) return;
      lastViewportChangeAt = performance.now();
      scheduleOrientationFinish();
    };

    window.addEventListener('orientationchange', beginOrientationChange, { passive: true });
    screen.orientation?.addEventListener('change', beginOrientationChange);
    portrait.addEventListener('change', beginOrientationChange);
    window.addEventListener('resize', handleViewportResize, { passive: true });
    window.visualViewport?.addEventListener('resize', handleViewportResize, { passive: true });
    window.addEventListener('lp:orientation-settled', scheduleOrientationFinish);

    const releaseBackdrop = () => {
      inertBackdrop.forEach((element) => element.removeAttribute('inert'));
      inertBackdrop = [];
    };

    const isolateBackdrop = () => {
      releaseBackdrop();
      inertBackdrop = Array.from(document.body.children).filter(
        (element) =>
          element instanceof HTMLElement &&
          element !== header &&
          element !== menu &&
          !element.hasAttribute('inert'),
      );
      inertBackdrop.forEach((element) => element.setAttribute('inert', ''));
    };

    const trapStops = () => [toggle, ...links].filter(
      (element) => element.getClientRects().length > 0,
    );

    const clearCompletionTimer = () => {
      if (completionTimer !== undefined) clearTimeout(completionTimer);
      completionTimer = undefined;
    };

    const scheduleCompletion = (id, delay) => {
      clearCompletionTimer();
      completionTimer = setTimeout(() => {
        completionTimer = undefined;
        if (id !== transitionId) return;
        if (isOpen && menuPhase === 'opening') finishOpen(id);
        else if (!isOpen && menuPhase === 'closing') finishClose(id);
      }, delay);
    };

    const cancelHoverAnimations = () => {
      hoverAnimations.forEach((animation) => animation.cancel());
      hoverAnimations.clear();
    };

    const resetHoverStyles = (remove = false) => {
      cancelHoverAnimations();
      wipes.forEach((wipe) => {
        if (!wipe) return;
        if (remove) wipe.style.removeProperty('height');
        else wipe.style.height = '0px';
      });
      texts.forEach((text) => {
        if (!text) return;
        if (remove) text.style.removeProperty('transform');
        else text.style.transform = 'translate3d(0, 0, 0)';
      });
      arrows.forEach((arrow) => {
        if (remove) arrow.style.removeProperty('transform');
        else arrow.style.transform = 'rotate(0deg)';
      });
    };

    const animateHoverProperty = (element, property, target, duration, easing) => {
      if (!element) return;
      const start = computed(element, property);
      hoverAnimations.get(element)?.cancel();
      element.style[property] = target;
      const animation = element.animate(
        [{ [property]: start }, { [property]: target }],
        { duration, easing, fill: 'both' },
      );
      hoverAnimations.set(element, animation);
      animation.finished.then(() => {
        if (hoverAnimations.get(element) !== animation) return;
        animation.cancel();
        hoverAnimations.delete(element);
      }, () => {});
    };

    const setLinkHover = (index, active) => {
      if (!mobile.matches || !finePointer.matches || reducedMotion.matches) return;
      animateHoverProperty(
        wipes[index],
        'height',
        active ? '100%' : '0px',
        500,
        inOutQuart,
      );
      animateHoverProperty(
        arrows[index],
        'transform',
        active ? 'rotate(90deg)' : 'rotate(0deg)',
        500,
        outQuart,
      );
      animateHoverProperty(
        texts[index],
        'transform',
        active ? 'translate3d(40px, 0, 0)' : 'translate3d(0, 0, 0)',
        500,
        outQuart,
      );
    };

    const prepareMobileMenu = () => {
      transitionId += 1;
      clearCompletionTimer();
      clearScheduledVideoPause();
      cancelAnimations();
      releaseBackdrop();
      resetHoverStyles();
      resumeAioVideoAfterMenu();
      isOpen = false;
      menuPhase = 'closed';
      document.body.classList.remove('no-scroll');
      header.classList.remove('is-menu-open');
      header.classList.remove('is-menu-closing');
      headerCta?.removeAttribute('inert');
      header.removeAttribute('data-menu-has-closed');
      header.setAttribute('data-mobile-menu-prepared', '');
      toggle.setAttribute('aria-expanded', 'false');
      menu.removeAttribute('hidden');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menu.setAttribute('data-menu-prepared', '');
      menu.classList.remove('is-menu-open', 'is-menu-closing');
      menu.removeAttribute('data-menu-has-opened');
      menu.style.removeProperty('pointer-events');
      menu.style.removeProperty('visibility');
      panel.style.removeProperty('transform');
      panel.style.removeProperty('will-change');
      links.forEach((link, index) => {
        link.style.removeProperty('transform');
        link.style.removeProperty('opacity');
        link.style.setProperty('--menu-open-delay', `${180 + index * 70}ms`);
      });
      arrows.forEach((arrow) => {
        arrow.style.removeProperty('opacity');
      });
      [burgerTop, burgerMiddle, burgerBottom, rightInner].forEach((element) => {
        element?.style.removeProperty('transform');
      });
      /* Ein Transition braucht einen berechneten Ausgangszustand. Dieser
         einmalige, parser-fruehe Style-Commit betrifft nur den bereits
         vorhandenen Header und verhindert, dass ein extrem schneller erster
         Touch direkt in den offenen Endzustand springt. */
      void getComputedStyle(panel).transform;
    };

    const leaveMobileMenu = () => {
      const activeElement = document.activeElement;
      const mustRestoreFocus = isOpen || (activeElement && menu.contains(activeElement));
      transitionId += 1;
      clearCompletionTimer();
      clearScheduledVideoPause();
      cancelAnimations();
      releaseBackdrop();
      resetHoverStyles(true);
      resumeAioVideoAfterMenu();
      if (mustRestoreFocus && inputModality === 'keyboard') {
        const visibleHeaderTarget = Array.from(
          header.querySelectorAll('a[href], button:not([disabled])'),
        ).find((element) => element.getClientRects().length > 0);
        visibleHeaderTarget?.focus({ preventScroll: true });
      }
      isOpen = false;
      menuPhase = 'closed';
      document.body.classList.remove('no-scroll');
      header.classList.remove('is-menu-open');
      header.classList.remove('is-menu-closing');
      headerCta?.removeAttribute('inert');
      header.removeAttribute('data-mobile-menu-prepared');
      header.removeAttribute('data-menu-has-closed');
      header.style.removeProperty('background-color');
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('hidden', '');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menu.removeAttribute('data-menu-prepared');
      menu.removeAttribute('data-menu-has-opened');
      menu.classList.remove('is-menu-open', 'is-menu-closing');
      menu.style.removeProperty('pointer-events');
      menu.style.removeProperty('visibility');
      panel.style.removeProperty('transform');
      panel.style.removeProperty('will-change');
      links.forEach((link) => {
        link.style.removeProperty('transform');
        link.style.removeProperty('opacity');
        link.style.removeProperty('--menu-open-delay');
      });
      arrows.forEach((arrow) => arrow.style.removeProperty('opacity'));
      [burgerTop, burgerMiddle, burgerBottom, rightInner].forEach((element) => {
        element?.style.removeProperty('transform');
      });
    };

    const finishOpen = (id) => {
      if (id !== transitionId || !isOpen) return;
      clearCompletionTimer();
      menuPhase = 'open';
      document.body.classList.add('no-scroll');
      isolateBackdrop();
      if (inputModality === 'keyboard') links[0]?.focus({ preventScroll: true });
    };

    const openMenu = () => {
      if (!mobile.matches || isOpen) return;
      isOpen = true;
      const id = ++transitionId;
      menuPhase = 'opening';
      cancelAnimations();
      releaseBackdrop();
      lastFocused =
        document.activeElement instanceof HTMLElement &&
        document.activeElement !== document.body
          ? document.activeElement
          : toggle;

      headerCta?.setAttribute('inert', '');
      header.classList.remove('is-menu-closing');
      header.classList.add('is-menu-open');
      menu.classList.remove('is-menu-closing');
      menu.classList.add('is-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      menu.removeAttribute('inert');
      menu.removeAttribute('aria-hidden');
      menu.style.removeProperty('pointer-events');
      menu.style.removeProperty('visibility');

      /* Der sichtbare Zustand wird zuerst gesetzt. Das AIO-Load-Modul kann
         danach ausschließlich seine eigenen Header-Animationen abbrechen,
         ohne hier getAnimations() und damit einen Style-Sync zu erzwingen. */
      window.dispatchEvent(new CustomEvent('tw:mobile-menu-open'));
      scheduleAioVideoPause();

      if (reducedMotion.matches) {
        finishOpen(id);
      } else {
        scheduleCompletion(id, 900);
      }
    };

    const finishClose = (id) => {
      if (id !== transitionId || isOpen) return;
      clearCompletionTimer();
      menuPhase = 'closed';
      clearScheduledVideoPause();
      header.classList.remove('is-menu-closing');
      menu.classList.remove('is-menu-closing');
      menu.setAttribute('data-menu-has-opened', '');
      headerCta?.removeAttribute('inert');
      menu.style.removeProperty('visibility');
      releaseBackdrop();
      document.body.classList.remove('no-scroll');
      resumeAioVideoAfterMenu();
      if (inputModality === 'keyboard') {
        const focusTarget = lastFocused?.isConnected ? lastFocused : toggle;
        focusTarget.focus({ preventScroll: true });
      }
    };

    const closeMenu = () => {
      if (!mobile.matches || !isOpen) return;
      isOpen = false;
      const id = ++transitionId;
      menuPhase = 'closing';
      clearScheduledVideoPause();
      cancelAnimations();
      resetHoverStyles();

      if (inputModality === 'keyboard') {
        (lastFocused?.isConnected ? lastFocused : toggle).focus({ preventScroll: true });
      }
      header.setAttribute('data-menu-has-closed', '');
      header.classList.remove('is-menu-open');
      header.classList.add('is-menu-closing');
      menu.classList.remove('is-menu-open');
      menu.classList.add('is-menu-closing');
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menu.style.removeProperty('visibility');
      if (reducedMotion.matches) {
        finishClose(id);
      } else {
        scheduleCompletion(id, 700);
      }
    };

    /* Die sichtbare Menuebewegung ist eine CSS-Zustandsmaschine. Dadurch kann
       WebKit die bereits vorgerenderte Ebene auf dem Compositor bewegen, auch
       wenn die lange AIO-Seite parallel Bilder dekodiert oder Module startet.
       transitionend finalisiert nur A11y/Scroll-Lock und setzt keinen
       sichtbaren Endzustand. */
    panel.addEventListener('transitionend', (event) => {
      if (event.target !== panel || event.propertyName !== 'transform') return;
      const id = transitionId;
      if (isOpen && menuPhase === 'opening') finishOpen(id);
      else if (!isOpen && menuPhase === 'closing') finishClose(id);
    });

    const toggleMenu = () => {
      if (isOpen) closeMenu();
      else openMenu();
    };

    let navigationPending = false;
    links.forEach((link, index) => {
      link.addEventListener('mouseenter', () => setLinkHover(index, true));
      link.addEventListener('mouseleave', () => setLinkHover(index, false));
      link.addEventListener('click', (event) => {
        const modifiedClick =
          event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
        const opensSeparateContext = link.target === '_blank' || link.hasAttribute('download');
        if (modifiedClick || opensSeparateContext || navigationPending) return;

        event.preventDefault();
        navigationPending = true;
        const navigate = () => window.location.assign(link.href);
        if (reducedMotion.matches) {
          navigate();
          return;
        }

        const clickWipe = link.querySelector('[data-menu-click-wipe]');
        const arrow = arrows[index];
        if (arrow) {
          hoverAnimations.get(arrow)?.cancel();
          hoverAnimations.delete(arrow);
          const startTransform = computed(arrow, 'transform');
          arrow.style.transform = 'rotate(45deg)';
          play(arrow, [
            { transform: startTransform },
            { transform: 'rotate(45deg)' },
          ], { duration: 300, easing: outQuart });
        }
        if (clickWipe) {
          clickWipe.style.height = '100%';
          const animation = clickWipe.animate(
            [{ height: '0%' }, { height: '100%' }],
            { duration: 300, easing: outQuart, fill: 'both' },
          );
          animation.finished.then(navigate, navigate);
        } else {
          setTimeout(navigate, 300);
        }
      });
    });

    const activateOnTouch = (event) => {
      if (!mobile.matches) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      lastTouchAt = performance.now();
      setInputModality('touch');
      suppressNextClick = true;
      toggleMenu();
    };

    if ('PointerEvent' in window) {
      toggle.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'touch' || event.pointerType === 'pen') {
          activateOnTouch(event);
          return;
        }
        suppressNextClick = false;
        setInputModality('pointer');
      }, { passive: false });
      toggle.addEventListener('pointerup', (event) => {
        if (event.pointerType === 'touch' || event.pointerType === 'pen') {
          /* Bezugspunkt ist das Loslassen, damit auch ein langes Gedrueckthalten
             den anschliessenden Safari-Kompatibilitaetsklick sicher schluckt. */
          lastTouchAt = performance.now();
        }
      }, { passive: true });
      toggle.addEventListener('pointercancel', (event) => {
        if (event.pointerType === 'touch' || event.pointerType === 'pen') {
          suppressNextClick = false;
        }
      }, { passive: true });
    } else {
      toggle.addEventListener('touchstart', activateOnTouch, { passive: false });
      toggle.addEventListener('touchend', () => {
        lastTouchAt = performance.now();
      }, { passive: true });
      toggle.addEventListener('touchcancel', () => {
        suppressNextClick = false;
      }, { passive: true });
    }
    if ('PointerEvent' in window) {
      toggle.addEventListener('touchstart', () => {
        lastTouchAt = performance.now();
        setInputModality('touch');
      }, { passive: true });
    }

    toggle.addEventListener('click', (event) => {
      if (!mobile.matches) return;
      if (suppressNextClick && performance.now() - lastTouchAt < 1500) {
        suppressNextClick = false;
        event.preventDefault();
        event.stopImmediatePropagation();
        return;
      }
      suppressNextClick = false;
      event.preventDefault();
      event.stopImmediatePropagation();
      const recentTouch = performance.now() - lastTouchAt < 1200;
      setInputModality(event.detail === 0 ? (recentTouch ? 'touch' : 'keyboard') : 'pointer');
      toggleMenu();
    });

    window.addEventListener('keydown', (event) => {
      setInputModality('keyboard');
      suppressNextClick = false;
      if (!mobile.matches || !isOpen) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== 'Tab') return;
      const stops = trapStops();
      if (!stops.length) return;
      const first = stops[0];
      const last = stops[stops.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    mobile.addEventListener('change', (event) => {
      if (event.matches) prepareMobileMenu();
      else leaveMobileMenu();
    });

    if (mobile.matches) prepareMobileMenu();

  })();
</script>

<style>
  /* --- Navbar (fix, Blur; BG-Farbe getrennt vom Verlauf, weil IX2 beim
         Menü-Öffnen NUR die background-color animiert) ------------------- */
  .navbar {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 499;
    display: flex;
    align-items: center;
    width: auto;
    height: var(--header-h);
    max-height: 80px;
    margin-inline: auto;
    padding: 0.125rem 5vw;
    background-color: var(--overlay-navbar);
    background-image: linear-gradient(var(--overlay-navbar-tint), var(--overlay-navbar-tint));
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
  }

  /* Hinter dem deckenden Fullscreen-Menue ist der Navbar-Blur unsichtbar.
     Ihn dort abzuschalten vermeidet auf iOS eine teure Kombination aus
     Backdrop-Filter und gleichzeitig transformierter Vollbild-Ebene. */
  .navbar.is-menu-open {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Stabiler Inhalts-Container wie `.navbar_container` im Webflow-Original:
     Die fixe Blur-Fläche bleibt dadurch beim Breakpoint-Wechsel strukturell
     unverändert; nur Logo und rechter Bereich wechseln bzw. animieren. */
  .navbar__container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: 100%;
    margin-inline: auto;
  }

  /* iOS kann beim Drehen alte Grafikschichten der fixierten Navbar oder des
     vorbereiteten Fullscreen-Menues mit der vorherigen Viewportgeometrie im
     Seiteninhalt weiterzeichnen. Waehrend der kurzen Stabilisierungsphase
     werden deshalb beide Paint-Ebenen gemeinsam unterdrueckt. Als fixed
     Elemente belegen sie keinen Platz im Dokument. */
  .navbar.is-orientation-changing,
  .menu.is-orientation-changing {
    visibility: hidden;
    pointer-events: none;
  }

  /* --- Split-Wortmarke (Word-Wrapper = Overflow-Masken der Load-Anim) ------ */
  .navbar__logo {
    grid-area: 1 / 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .navbar__logo-word { display: inline-block; position: relative; overflow: hidden; }
  .navbar__logo-word.is-1 { padding-right: 0.625rem; }
  .navbar__logo-word.is-2 { padding-left: 0.75rem; }
  .navbar__logo-text {
    display: block;
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .navbar__logo-suffix { display: inline; }
  .navbar__logo-line {
    width: 1.75px;
    height: 2rem;
    background: var(--brand);
    flex: none;
  }
  /* --- Rechte Seite: Overflow-Maske (Load-Anim + responsiver Menü-Shift) ---- */
  .navbar__right {
    grid-area: 1 / 2;
    justify-self: end;
    z-index: 99999;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .navbar__right-inner {
    --navbar-burger-size: 3rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    position: relative;
  }
  .navbar__list { display: flex; align-items: center; gap: 1.5rem; margin: 0; padding: 0; }
  /* Jedes <li> als Flexbox: zentriert den Link vertikal und nimmt dem
     inline-block-Anker die Grundlinien-Macke (overflow:hidden → Baseline =
     Unterkante; die Zeilenbox reserviert dann die Font-Unterlänge DARUNTER und
     schöbe den Text sonst ~4px zu hoch). Im Original ist der Link ein direktes
     Flex-Kind von .navbar_menu-desktop und hat das Problem nicht. */
  .navbar__list li { display: flex; align-items: center; }
  .navbar__link {
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 300;
  }
  .navbar__link:hover { color: var(--ink); }
  .navbar__cta .btn-glow__content { gap: 0.55rem; }
  .navbar__cta-gift {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--brand-readable);
    flex: none;
  }

  /* --- Burger (nur ≤991, wie im Original; Morph macht der Inline-Controller) */
  .navbar__burger {
    display: none;
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: var(--navbar-burger-size, 3rem);
    height: var(--navbar-burger-size, 3rem);
    padding: 0.375rem 0.5rem;
    background: var(--paper-2);
    border: 0;
    border-radius: 100%;
    cursor: pointer;
    flex: none;
    overflow: hidden;
    touch-action: manipulation;
  }
  .navbar__burger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    flex: none;
  }

  /* --- Fullscreen-Menü (nur ≤991 erreichbar; Panel #121212 von links) ------ */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    width: 100%;
    /* 100vh als Fallback; dvh folgt auf Mobilgeräten der ein-/ausgeblendeten
       Browserleiste und hält den Wischbereich im tatsächlich sichtbaren Raum. */
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }
  .menu[hidden] { display: none; }
  .menu__panel {
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    background: var(--panel);
    overflow-y: auto;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
  }
  .menu__spacer { width: 100%; height: 15%; flex: none; }

  .menu__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 15.34%;
    flex: none;
    padding: 0.75rem 4.5rem 0.75rem 3.5rem;
    border-bottom: 1.5px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
  }
  /* Klick-Wipe: Höhe animiert der Inline-Controller (IX2 a-74); Basis 0,
     damit die Fläche ohne JS nie Inhalte überdeckt. */
  .menu__wipe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0;
    background: var(--paper);
    pointer-events: none;
  }
  .menu__click-wipe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0;
    background: var(--paper-2);
    pointer-events: none;
  }
  .menu__text {
    position: relative;
    z-index: 1;
    font-size: 3.25rem;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .menu__arrow {
    position: relative;
    z-index: 1;
    width: auto;
    height: 2.25rem;
    flex: none;
  }

  /* Safari behandelt Fokus nach Touch bzw. Pointer-Klick teilweise wie
     Tastaturfokus. Nur fuer diese beiden Eingabemodi wird die goldene Kontur
     lokal unterdrueckt; sobald eine Taste benutzt wird, bleibt die globale
     barrierefreie Focus-Visible-Kontur erhalten. */
  .navbar[data-menu-input='touch'] .navbar__burger:focus-visible,
  .menu[data-menu-input='touch'] .menu__link:focus-visible,
  .navbar[data-menu-input='pointer'] .navbar__burger:focus-visible,
  .menu[data-menu-input='pointer'] .menu__link:focus-visible {
    outline: none;
  }

  /* --- Breakpoints (1:1 Export) -------------------------------------------- */
  @media (max-width: 991px) {
    /* Auf iOS kann eine fixe backdrop-filter-Ebene beim Drehen noch mit der
       alten Viewportgeometrie gerastert werden. Der ohnehin fast deckende
       Navbar-Tint bleibt erhalten; nur die mobile Blur-Ebene entfaellt. */
    .navbar {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .navbar__menu { display: none; }
    .navbar__burger { display: inline-flex; }
    .navbar__right-inner { gap: 0.75rem; }

    /* Das Fullscreen-Menü ist bereits vor dem ersten Tap links ausserhalb des
       Viewports gerendert. Ein Tap ändert nur Klassen; Transform und Opacity
       laufen dadurch compositorseitig und werden nicht von AIO-Initialisierung
       oder einem ausgelassenen JavaScript-Frame übersprungen. */
    .navbar[data-mobile-menu-prepared] {
      transition: background-color 300ms cubic-bezier(0.25, 0.1, 0.25, 1) 200ms;
    }
    .navbar[data-mobile-menu-prepared][data-menu-has-closed] {
      background-color: rgba(231, 226, 220, 0.12);
    }
    .navbar[data-mobile-menu-prepared].is-menu-open {
      background-color: rgba(0, 0, 0, 0);
      transition-duration: 200ms;
      transition-delay: 0ms;
    }

    .menu[data-menu-prepared] {
      pointer-events: none;
    }
    .menu[data-menu-prepared].is-menu-open,
    .menu[data-menu-prepared].is-menu-closing {
      pointer-events: auto;
    }
    .menu[data-menu-prepared] .menu__panel {
      transform: translate3d(-100%, 0, 0);
      will-change: transform;
      transition: transform 520ms cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .menu[data-menu-prepared].is-menu-open .menu__panel {
      transform: translate3d(0, 0, 0);
      transition-duration: 720ms;
    }

    .menu[data-menu-prepared] .menu__link {
      opacity: 0;
      transform: translate3d(-80px, 0, 0);
      transition:
        transform 350ms cubic-bezier(0.165, 0.84, 0.44, 1),
        opacity 180ms cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    .menu[data-menu-prepared][data-menu-has-opened] .menu__link {
      transform: translate3d(-70px, 0, 0);
    }
    .menu[data-menu-prepared].is-menu-open .menu__link {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      transition-duration: 350ms, 250ms;
      transition-delay:
        var(--menu-open-delay, 180ms),
        var(--menu-open-delay, 180ms);
    }
    .menu[data-menu-prepared].is-menu-closing .menu__link {
      opacity: 0;
      transform: translate3d(0, 0, 0);
      transition-duration: 0ms, 180ms;
      transition-delay: 0ms;
    }

    .menu[data-menu-prepared] .menu__arrow {
      opacity: 0;
      transition: opacity 180ms cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    .menu[data-menu-prepared].is-menu-open .menu__arrow {
      opacity: 1;
      transition-duration: 250ms;
      transition-delay: 450ms;
    }
    .menu[data-menu-prepared].is-menu-closing .menu__arrow {
      opacity: 0;
      transition-delay: 0ms;
    }

    .navbar[data-mobile-menu-prepared] .navbar__burger-line {
      transform: none;
    }
    .navbar[data-mobile-menu-prepared] .navbar__burger-line.is-top,
    .navbar[data-mobile-menu-prepared] .navbar__burger-line.is-bottom {
      transition: transform 250ms cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .navbar[data-mobile-menu-prepared] .navbar__burger-line.is-middle {
      transition: transform 250ms cubic-bezier(0.165, 0.84, 0.44, 1) 150ms;
    }
    .navbar[data-mobile-menu-prepared].is-menu-open .navbar__burger-line.is-top {
      transform: translate3d(0, 3.5px, 0) rotate(45deg);
      transition-duration: 300ms;
      transition-delay: 200ms;
    }
    .navbar[data-mobile-menu-prepared].is-menu-open .navbar__burger-line.is-middle {
      transform: translate3d(200%, 0, 0);
      transition-duration: 500ms;
      transition-delay: 100ms;
    }
    .navbar[data-mobile-menu-prepared].is-menu-open .navbar__burger-line.is-bottom {
      transform: translate3d(0, -3.5px, 0) rotate(-45deg);
      transition-duration: 300ms;
      transition-delay: 200ms;
    }
    .navbar[data-mobile-menu-prepared]:is(.is-menu-open, .is-menu-closing)
      .navbar__burger-line {
      will-change: transform;
    }

    .navbar[data-mobile-menu-prepared] .navbar__right-inner {
      transform: none;
      transition: transform 350ms cubic-bezier(0.165, 0.84, 0.44, 1) 100ms;
    }
    .navbar[data-mobile-menu-prepared].is-menu-open .navbar__right-inner {
      /* 100 % = Burger + Gap + CTA. Abzüglich Burgerbreite bleibt exakt die
         aktuelle CTA-Breite samt Gap – unabhängig von Text und Viewport. */
      transform: translate3d(calc(100% - var(--navbar-burger-size)), 0, 0);
      transition-delay: 0ms;
    }
    .navbar[data-mobile-menu-prepared]:is(.is-menu-open, .is-menu-closing)
      .navbar__right-inner {
      will-change: transform;
    }
  }

  @media (max-width: 991px) and (prefers-reduced-motion: reduce) {
    .navbar[data-mobile-menu-prepared],
    .navbar[data-mobile-menu-prepared] .navbar__right-inner,
    .navbar[data-mobile-menu-prepared] .navbar__burger-line,
    .menu[data-menu-prepared] .menu__panel,
    .menu[data-menu-prepared] .menu__link,
    .menu[data-menu-prepared] .menu__arrow {
      transition-duration: 0ms !important;
      transition-delay: 0ms !important;
    }
  }
  @media (max-width: 767px) {
    .navbar__logo { height: 3rem; }
    .navbar__logo-suffix { display: none; }
    .navbar__logo-word.is-1 { padding-right: 0.25rem; }
    .navbar__logo-word.is-2 { padding-left: 0.25rem; }
  }
  @media (max-width: 991px) and (max-height: 500px) and (orientation: landscape) {
    /* 15 % sind auf kurzen Querformat-Viewports niedriger als die fixe
       Navbar. Der erste Menuepunkt wuerde dadurch unter der Navbar beginnen
       und Safari schneidet seine oberen Glyphen ab. */
    .menu__spacer { height: calc(var(--header-h) + 0.5rem); }
  }
  @media (max-width: 479px) {
    .menu__link { padding-left: 6vw; padding-right: 6vw; }
    .menu__text { font-size: 2.75rem; letter-spacing: -0.03em; }
    .menu__arrow { height: 2rem; }
  }
</style>
