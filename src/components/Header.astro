---
import arrowWhite from '../assets/images/icon-arrow-white.svg';
import { getSiteSettings } from '../lib/content';
import { safeHref } from '../lib/safe-href';
import { siteNavigationHref } from '../lib/site-navigation';
import { UI as t } from '../lib/i18n';

interface Props {
  context?: 'main' | 'ebook';
}

const { context = 'main' } = Astro.props;
const MAIN_ORIGIN = 'https://tristanweithaler.com';
const EBOOK_ORIGIN = 'https://ebook.tristanweithaler.com';

/**
 * Fixe Navbar (Webflow .navbar, global-chrome.md §5) — Struktur 1:1 nach dem
 * Export: Split-Wortmarke mit Overflow-Masken (Load-Anim schiebt die Texte
 * aus ±140 % ein, motion/home-load u. a. via data-nav-logo-text), Goldlinie,
 * Desktop-Links mit Underline-Wipe (motion/buttons.ts), Glow-CTA, Burger NUR
 * ≤991 (im Original ist .navbar_menu-button auf Desktop display:none — das
 * Fullscreen-Menü existiert nur auf Tablet/Mobile, IX2 a-121/a-122).
 * Menü-Logik + exakte IX2-Choreografie in src/scripts/menu.ts.
 */
const settings = await getSiteSettings();
const isExternal = (href: string) => {
  if (!/^https?:\/\//.test(href)) return false;
  const origin = new URL(href).origin;
  return origin !== MAIN_ORIGIN && origin !== EBOOK_ORIGIN;
};
const contextHref = (href: string) => {
  const safe = siteNavigationHref(href);
  if (context !== 'ebook') return safe;
  if (safe === '/e-book/') return `${EBOOK_ORIGIN}/`;
  return safe.startsWith('/') ? new URL(safe, MAIN_ORIGIN).href : safe;
};
const homeHref = context === 'ebook' ? `${MAIN_ORIGIN}/` : '/';

/** Fullscreen-Menü: Startseite + Hauptnavigation (global-chrome.md §5). */
const navItems = settings.nav.map((item) => ({
  ...item,
  href: contextHref(item.href),
}));
const menuItems = [{ label: 'Startseite', href: homeHref }, ...navItems];
const headerCtaHref = settings.headerCta
  ? contextHref(safeHref(settings.headerCta.href))
  : undefined;
---
<header class="navbar" data-site-header data-navigation-context={context}>
  <div class="navbar__container">
  {/* Eine einzige Wortmarke fuer alle Breakpoints. Die auf Mobile sichtbaren
      Anfangsbuchstaben sind dieselben Textknoten wie in der Langform; nur die
      Suffixe werden ausgeblendet. So muss WebKit beim Drehen keine zweite
      T|W-Zeichenebene gegen Tristan|Weithaler austauschen. */}
  <a href={homeHref} class="navbar__logo">
    <span class="navbar__logo-word is-1">
      <span class="navbar__logo-text" data-nav-logo-text="1">T<span class="navbar__logo-suffix">ristan</span></span>
    </span>
    <span class="navbar__logo-line" data-nav-logo-line aria-hidden="true"></span>
    <span class="navbar__logo-word is-2">
      <span class="navbar__logo-text" data-nav-logo-text="2">W<span class="navbar__logo-suffix">eithaler</span></span>
    </span>
    <span class="visually-hidden">{`, ${t.toStart}`}</span>
  </a>

  <div class="navbar__right" data-nav-right>
    <div class="navbar__right-inner" data-nav-right-inner>
      <nav class="navbar__menu" aria-label={t.mainNav}>
        <ul role="list" class="navbar__list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="navbar__link link-underline"
                  data-underline
                  target={isExternal(item.href) ? '_blank' : undefined}
                  rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
                >
                  <span class="link-underline__label">{item.label}</span>
                  <span class="link-underline__line" aria-hidden="true"></span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        class="navbar__burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-nav-toggle
      >
        <span class="visually-hidden">{t.menu}</span>
        <span class="navbar__burger-line is-top" data-burger-top aria-hidden="true"></span>
        <span class="navbar__burger-line is-middle" data-burger-middle aria-hidden="true"></span>
        <span class="navbar__burger-line is-bottom" data-burger-bottom aria-hidden="true"></span>
      </button>

      {
        settings.headerCta && (
          <a
            class="btn-glow navbar__cta"
            href={headerCtaHref}
            rel="nofollow"
            data-glow
          >
            <span class="btn-glow__circle" aria-hidden="true" data-glow-circle="" />
            <span class="btn-glow__wrapper">
              <span class="btn-glow__content">
                <svg
                  class="navbar__cta-gift"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="8" width="18" height="4" rx="1" />
                  <path d="M12 8v13" />
                  <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                  <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8Z" />
                  <path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8Z" />
                </svg>
                <span class="btn-glow__label">{settings.headerCta.label}</span>
              </span>
            </span>
          </a>
        )
      }
    </div>
  </div>
  </div>
</header>

<div class="menu" id="site-menu" data-site-menu hidden>
  <nav class="menu__panel" aria-label={t.menu} data-menu-panel>
    <div class="menu__spacer" aria-hidden="true"></div>
    {
      menuItems.map((item) => (
        <a
          href={item.href}
          class="menu__link"
          data-menu-link
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
        >
          <span class="menu__wipe" data-menu-wipe aria-hidden="true"></span>
          <span class="menu__click-wipe" data-menu-click-wipe aria-hidden="true"></span>
          <span class="menu__text" data-menu-text>{item.label}</span>
          <img
            class="menu__arrow"
            data-menu-arrow
            src={arrowWhite.src}
            alt=""
            width="36"
            height="36"
            loading="lazy"
          />
        </a>
      ))
    }
  </nav>
</div>

<!-- Ein klassisches Inline-Script wird waehrend des HTML-Parsens ausgefuehrt.
     Das ist fuer die lange AIO-Seite entscheidend: Das normale gebuendelte
     Menue-Modul ist als ES-Modul absichtlich deferred und kann seinen
     Click-Listener deshalb erst nach dem vollstaendigen Dokument anhaengen.
     Bis dahin uebernimmt dieser kleine, abhaengigkeitsfreie Bootstrap exakt
     den kompakten mobilen Oeffnungszustand. Auf der mobilen AIO-Seite bleibt
     er bewusst allein zustaendig; alle anderen Seiten werden spaeter wie
     bisher von menu.ts uebernommen. -->
<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const toggle = document.querySelector('[data-nav-toggle]');
    const menu = document.querySelector('[data-site-menu]');
    const panel = menu?.querySelector('[data-menu-panel]');
    if (!header || !toggle || !menu || !panel) return;

    const links = Array.from(menu.querySelectorAll('[data-menu-link]'));
    const arrows = Array.from(menu.querySelectorAll('[data-menu-arrow]'));
    const burgerTop = header.querySelector('[data-burger-top]');
    const burgerMiddle = header.querySelector('[data-burger-middle]');
    const burgerBottom = header.querySelector('[data-burger-bottom]');
    const navRight = header.querySelector('[data-nav-right]');
    const rightInner = header.querySelector('[data-nav-right-inner]');
    const headerCta = header.querySelector('.navbar__cta');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = 'cubic-bezier(0.25, 0.1, 0.25, 1)';
    const outQuart = 'cubic-bezier(0.165, 0.84, 0.44, 1)';
    const mobileMenu = window.matchMedia('(max-width: 991px)');
    const persistentAioMenu =
      document.documentElement.classList.contains('is-aio-route') && mobileMenu.matches;
    if (persistentAioMenu) menu.setAttribute('data-aio-native-menu', '');

    /* Die Menue-Ebene wird auf mobilen Breakpoints bereits waehrend des
       Parsens offscreen zusammengesetzt. Der erste Tap muss sie dadurch nur
       noch auf den Compositor schieben; er darf nicht gleichzeitig auf der
       langen AIO-Seite `display:none` aufloesen und das gesamte Dokument neu
       vermessen. Inert + pointer-events halten die vorbereitete Ebene bis zum
       Oeffnen vollstaendig aus Bedienung und Hit-Testing heraus. */
    if (mobileMenu.matches) {
      menu.removeAttribute('hidden');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menu.setAttribute('data-menu-prepared', '');
      menu.style.pointerEvents = 'none';
      panel.style.transform = 'translate3d(-100%, 0, 0)';
      panel.style.willChange = 'transform';
      links.forEach((link) => {
        link.style.transform = 'translate3d(-80px, 0, 0)';
        link.style.opacity = '0';
      });
      arrows.forEach((arrow) => {
        arrow.style.opacity = '0';
      });
    }

    const openShift = () => {
      if (!rightInner || !headerCta) return 9.2 * 16;
      const gap = Number.parseFloat(getComputedStyle(rightInner).columnGap) || 0;
      return headerCta.getBoundingClientRect().width + gap;
    };

    const backdrop = () =>
      Array.from(document.body.children).filter(
        (element) => element !== header && element !== menu,
      );
    const setBackdropInert = (inert) => {
      backdrop().forEach((element) =>
        inert ? element.setAttribute('inert', '') : element.removeAttribute('inert'),
      );
    };
    const trapStops = () =>
      [
        ...Array.from(header.querySelectorAll('a[href], button:not([disabled])')),
        ...Array.from(menu.querySelectorAll('a[href], button:not([disabled])')),
      ].filter((element) => element.getClientRects().length > 0);
    let lastFocused = null;

    const resetEarlyStyles = () => {
      panel.style.removeProperty('transform');
      panel.style.removeProperty('will-change');
      links.forEach((link) => {
        link.style.removeProperty('transform');
        link.style.removeProperty('opacity');
      });
      arrows.forEach((arrow) => arrow.style.removeProperty('opacity'));
      [burgerTop, burgerMiddle, burgerBottom, rightInner].forEach((element) => {
        element?.style.removeProperty('transform');
      });
      header.style.removeProperty('background-color');
    };

    const freezeCurrentStyles = () => {
      const freeze = (element, properties) => {
        if (!element) return;
        const computed = getComputedStyle(element);
        properties.forEach((property) => {
          element.style.setProperty(property, computed.getPropertyValue(property));
        });
      };
      freeze(header, ['background-color']);
      freeze(panel, ['transform']);
      links.forEach((link) => freeze(link, ['transform', 'opacity']));
      arrows.forEach((arrow) => freeze(arrow, ['opacity']));
      [burgerTop, burgerMiddle, burgerBottom, rightInner].forEach((element) =>
        freeze(element, ['transform']),
      );
    };

    const preparePersistentClosedState = () => {
      menu.removeAttribute('hidden');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menu.setAttribute('data-menu-prepared', '');
      menu.style.pointerEvents = 'none';
      panel.style.transform = 'translate3d(-100%, 0, 0)';
      panel.style.willChange = 'transform';
      links.forEach((link) => {
        link.style.transform = 'translate3d(-80px, 0, 0)';
        link.style.opacity = '0';
      });
      arrows.forEach((arrow) => {
        arrow.style.opacity = '0';
      });
      [burgerTop, burgerMiddle, burgerBottom, rightInner].forEach((element) => {
        element?.style.removeProperty('transform');
      });
      header.style.removeProperty('background-color');
    };

    const closeBeforeMainModule = () => {
      menu.__earlyMenuBridge?.cancel();
      resetEarlyStyles();
      menu.setAttribute('hidden', '');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menu.removeAttribute('data-menu-prepared');
      menu.style.removeProperty('pointer-events');
      header.classList.remove('is-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('no-scroll');
      delete menu.__earlyMenuBridge;
    };

    const closePersistentAioMenu = () => {
      freezeCurrentStyles();
      menu.__earlyMenuBridge?.cancel();

      let stopped = false;
      const animations = [];
      const play = (element, keyframes, options) => {
        if (!element || stopped) return;
        animations.push(element.animate(keyframes, { fill: 'both', ...options }));
      };
      const cancel = () => {
        stopped = true;
        animations.forEach((animation) => animation.cancel());
      };
      menu.__earlyMenuBridge = { cancel };

      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      setBackdropInert(false);

      if (reduced) {
        document.body.classList.remove('no-scroll');
        header.classList.remove('is-menu-open');
        preparePersistentClosedState();
        (lastFocused ?? toggle).focus();
        delete menu.__earlyMenuBridge;
        return;
      }

      play(panel, [{ transform: panel.style.transform }, { transform: 'translate3d(-100%, 0, 0)' }], {
        duration: 520,
        easing: outQuart,
      });
      links.forEach((link) => {
        play(link, [{ opacity: link.style.opacity }, { opacity: 0 }], {
          duration: 180,
          easing: ease,
        });
      });
      arrows.forEach((arrow) => {
        play(arrow, [{ opacity: arrow.style.opacity }, { opacity: 0 }], {
          duration: 180,
          easing: ease,
        });
      });
      play(burgerTop, [{ transform: burgerTop?.style.transform }, { transform: 'translate3d(0, 0, 0) rotate(0deg)' }], {
        duration: 250,
        easing: outQuart,
      });
      play(burgerBottom, [{ transform: burgerBottom?.style.transform }, { transform: 'translate3d(0, 0, 0) rotate(0deg)' }], {
        duration: 250,
        easing: outQuart,
      });
      play(burgerMiddle, [{ transform: burgerMiddle?.style.transform }, { transform: 'translate3d(0, 0, 0)' }], {
        duration: 250,
        delay: 150,
        easing: outQuart,
      });
      play(rightInner, [{ transform: rightInner?.style.transform }, { transform: 'translate3d(0, 0, 0)' }], {
        duration: 350,
        delay: 100,
        easing: outQuart,
      });
      play(header, [{ backgroundColor: header.style.backgroundColor }, { backgroundColor: 'rgba(231, 226, 220, 0.12)' }], {
        duration: 300,
        delay: 200,
        easing: ease,
      });

      void Promise.allSettled(animations.map((animation) => animation.finished)).then(() => {
        if (stopped || toggle.getAttribute('aria-expanded') === 'true') return;
        animations.forEach((animation) => animation.cancel());
        document.body.classList.remove('no-scroll');
        header.classList.remove('is-menu-open');
        preparePersistentClosedState();
        (lastFocused ?? toggle).focus();
        delete menu.__earlyMenuBridge;
      });
    };

    const openBeforeMainModule = () => {
      menu.__earlyMenuBridge?.cancel();
      delete menu.__earlyMenuBridge;
      if (persistentAioMenu) {
        lastFocused = document.activeElement;
        setBackdropInert(true);
      }
      const animations = [];
      let followUpFrame;
      let stopped = false;

      const cancel = () => {
        stopped = true;
        if (followUpFrame !== undefined) cancelAnimationFrame(followUpFrame);
        animations.forEach((animation) => animation.cancel());
      };
      menu.__earlyMenuBridge = { cancel };

      // Eine noch laufende AIO-Load-Animation der rechten Kopfzeile wird bei
      // echter Bedienung in ihren normalen CSS-Endzustand ueberfuehrt. Sie
      // darf weder die Trefferflaeche noch die Menuebewegung weiter versetzen.
      navRight?.getAnimations().forEach((animation) => animation.cancel());
      header.classList.add('is-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      menu.removeAttribute('inert');
      menu.removeAttribute('aria-hidden');
      menu.style.removeProperty('pointer-events');

      panel.style.transform = 'translate3d(-100%, 0, 0)';
      panel.style.willChange = 'transform';
      links.forEach((link) => {
        link.style.transform = 'translate3d(-80px, 0, 0)';
        link.style.opacity = '0';
      });
      arrows.forEach((arrow) => {
        arrow.style.opacity = '0';
      });
      menu.removeAttribute('hidden');

      if (reduced) {
        document.body.classList.add('no-scroll');
        panel.style.transform = 'translate3d(0, 0, 0)';
        links.forEach((link) => {
          link.style.transform = 'translate3d(0, 0, 0)';
          link.style.opacity = '1';
        });
        arrows.forEach((arrow) => {
          arrow.style.opacity = '1';
        });
        return;
      }

      const play = (element, keyframes, options) => {
        if (!element || stopped) return;
        animations.push(element.animate(keyframes, { fill: 'both', ...options }));
      };

      /* Der sichtbare Compositor-Start geschieht synchron zum Fingerkontakt.
         Scroll-Lock und die einzige benoetigte Breitenmessung folgen erst im
         naechsten Frame, nachdem das Panel bereits unterwegs ist. */
      play(header, [{ backgroundColor: 'rgba(21, 21, 21, 0.12)' }, { backgroundColor: 'rgba(0, 0, 0, 0)' }], {
        duration: 200,
        easing: ease,
      });
      play(panel, [{ transform: 'translate3d(-100%, 0, 0)' }, { transform: 'translate3d(0, 0, 0)' }], {
        duration: 720,
        easing: outQuart,
      });
      play(burgerMiddle, [{ transform: 'translate3d(0, 0, 0)' }, { transform: 'translate3d(200%, 0, 0)' }], {
        duration: 500,
        delay: 100,
        easing: outQuart,
      });
      play(burgerTop, [{ transform: 'translate3d(0, 0, 0) rotate(0deg)' }, { transform: 'translate3d(0, 3.5px, 0) rotate(45deg)' }], {
        duration: 300,
        delay: 200,
        easing: outQuart,
      });
      play(burgerBottom, [{ transform: 'translate3d(0, 0, 0) rotate(0deg)' }, { transform: 'translate3d(0, -3.5px, 0) rotate(-45deg)' }], {
        duration: 300,
        delay: 200,
        easing: outQuart,
      });
      links.forEach((link, index) => {
        const delay = 180 + index * 70;
        play(link, [{ transform: 'translate3d(-80px, 0, 0)' }, { transform: 'translate3d(0, 0, 0)' }], {
          duration: 350,
          delay,
          easing: outQuart,
        });
        play(link, [{ opacity: 0 }, { opacity: 1 }], {
          duration: 250,
          delay,
          easing: ease,
        });
      });
      arrows.forEach((arrow) => {
        play(arrow, [{ opacity: 0 }, { opacity: 1 }], {
          duration: 250,
          delay: 450,
          easing: ease,
        });
      });

      followUpFrame = requestAnimationFrame(() => {
        followUpFrame = undefined;
        if (stopped || toggle.getAttribute('aria-expanded') !== 'true') return;
        document.body.classList.add('no-scroll');
        play(rightInner, [{ transform: 'translate3d(0, 0, 0)' }, { transform: `translate3d(${openShift()}px, 0, 0)` }], {
          duration: 350,
          easing: outQuart,
        });
      });
    };

    let suppressNextEarlyClick = false;
    let suppressEarlyClickTimer;

    const signalEarlyInteraction = () => {
      /* Außerhalb der mobilen AIO-Seite signalisiert dies dem Loader, dass
         die Fruehsteuerung bereits uebernommen hat. Auf AIO bleibt dieselbe
         native Steuerung dauerhaft zustaendig; dort gibt es bewusst keine
         spaetere Uebergabe mehr. */
      toggle.setAttribute('data-menu-early-interacted', '');
      if (!persistentAioMenu) {
        document.dispatchEvent(new Event('site:early-menu-interaction'));
      }
    };

    const toggleBeforeMainModule = () => {
      signalEarlyInteraction();
      if (toggle.getAttribute('aria-expanded') === 'true') {
        if (persistentAioMenu) closePersistentAioMenu();
        else closeBeforeMainModule();
      }
      else openBeforeMainModule();
    };

    /* Auf iOS kann ein Element, das waehrend der Startchoreografie noch per
       transform in seine Endposition faehrt, seinen normalen `click` erst
       nach stabiler Geometrie erhalten. Der Fingerkontakt selbst kommt jedoch
       sofort an. Nur fuer Touch/Stift und nur vor der vollstaendigen
       Menueinitialisierung reagieren wir deshalb schon auf `pointerdown`.
       Der danach vom Browser erzeugte Click wird genau einmal geschluckt,
       damit er das gerade geoeffnete Menue nicht wieder schliesst. */
    const activateOnEarlyTouch = (event) => {
      if (toggle.hasAttribute('data-menu-ready')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      suppressNextEarlyClick = true;
      if (suppressEarlyClickTimer !== undefined) clearTimeout(suppressEarlyClickTimer);
      suppressEarlyClickTimer = setTimeout(() => {
        suppressNextEarlyClick = false;
        suppressEarlyClickTimer = undefined;
      }, 900);
      toggleBeforeMainModule();
    };

    if ('PointerEvent' in window) {
      toggle.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
        activateOnEarlyTouch(event);
      }, { passive: false });
    } else {
      /* Fallback fuer aeltere WebKit-Versionen ohne Pointer Events. */
      toggle.addEventListener('touchstart', activateOnEarlyTouch, { passive: false });
    }

    toggle.addEventListener('click', (event) => {
      if (suppressNextEarlyClick) {
        suppressNextEarlyClick = false;
        if (suppressEarlyClickTimer !== undefined) clearTimeout(suppressEarlyClickTimer);
        suppressEarlyClickTimer = undefined;
        event.preventDefault();
        event.stopImmediatePropagation();
        return;
      }
      if (toggle.hasAttribute('data-menu-ready')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      toggleBeforeMainModule();
    });

    if (persistentAioMenu) {
      document.addEventListener('DOMContentLoaded', () => {
        if (toggle.getAttribute('aria-expanded') === 'true') setBackdropInert(true);
      }, { once: true });

      window.addEventListener('keydown', (event) => {
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        if (event.key === 'Escape') {
          closePersistentAioMenu();
          return;
        }
        if (event.key !== 'Tab') return;
        const stops = trapStops();
        if (!stops.length) return;
        const first = stops[0];
        const last = stops[stops.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    }
  })();
</script>

<style>
  /* --- Navbar (fix, Blur; BG-Farbe getrennt vom Verlauf, weil IX2 beim
         Menü-Öffnen NUR die background-color animiert) ------------------- */
  .navbar {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 499;
    display: flex;
    align-items: center;
    width: auto;
    height: var(--header-h);
    max-height: 80px;
    margin-inline: auto;
    padding: 0.125rem 5vw;
    background-color: var(--overlay-navbar);
    background-image: linear-gradient(var(--overlay-navbar-tint), var(--overlay-navbar-tint));
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
  }

  /* Hinter dem deckenden Fullscreen-Menue ist der Navbar-Blur unsichtbar.
     Ihn dort abzuschalten vermeidet auf iOS eine teure Kombination aus
     Backdrop-Filter und gleichzeitig transformierter Vollbild-Ebene. */
  .navbar.is-menu-open {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Stabiler Inhalts-Container wie `.navbar_container` im Webflow-Original:
     Die fixe Blur-Fläche bleibt dadurch beim Breakpoint-Wechsel strukturell
     unverändert; nur Logo und rechter Bereich wechseln bzw. animieren. */
  .navbar__container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: 100%;
    margin-inline: auto;
  }

