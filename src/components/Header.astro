---
import arrowWhite from '../assets/images/icon-arrow-white.svg';
import { getSiteSettings } from '../lib/content';
import { safeHref } from '../lib/safe-href';
import { siteNavigationHref } from '../lib/site-navigation';
import { UI as t } from '../lib/i18n';

interface Props {
  context?: 'main' | 'ebook';
}

const { context = 'main' } = Astro.props;
const MAIN_ORIGIN = 'https://tristanweithaler.com';
const EBOOK_ORIGIN = 'https://ebook.tristanweithaler.com';

/**
 * Fixe Navbar (Webflow .navbar, global-chrome.md §5) — Struktur 1:1 nach dem
 * Export: Split-Wortmarke mit Overflow-Masken (Load-Anim schiebt die Texte
 * aus ±140 % ein, motion/home-load u. a. via data-nav-logo-text), Goldlinie,
 * Desktop-Links mit Underline-Wipe (motion/buttons.ts), Glow-CTA, Burger NUR
 * ≤991 (im Original ist .navbar_menu-button auf Desktop display:none — das
 * Fullscreen-Menü existiert nur auf Tablet/Mobile, IX2 a-121/a-122).
 * Menü-Logik + exakte IX2-Choreografie in src/scripts/menu.ts.
 */
const settings = await getSiteSettings();
const isExternal = (href: string) => {
  if (!/^https?:\/\//.test(href)) return false;
  const origin = new URL(href).origin;
  return origin !== MAIN_ORIGIN && origin !== EBOOK_ORIGIN;
};
const contextHref = (href: string) => {
  const safe = siteNavigationHref(href);
  if (context !== 'ebook') return safe;
  if (safe === '/e-book/') return `${EBOOK_ORIGIN}/`;
  return safe.startsWith('/') ? new URL(safe, MAIN_ORIGIN).href : safe;
};
const homeHref = context === 'ebook' ? `${MAIN_ORIGIN}/` : '/';

/** Fullscreen-Menü: Startseite + Hauptnavigation (global-chrome.md §5). */
const navItems = settings.nav.map((item) => ({
  ...item,
  href: contextHref(item.href),
}));
const menuItems = [{ label: 'Startseite', href: homeHref }, ...navItems];
const headerCtaHref = settings.headerCta
  ? contextHref(safeHref(settings.headerCta.href))
  : undefined;
---
<header class="navbar" data-site-header>
  <div class="navbar__container">
  <a href={homeHref} class="navbar__logo is-desktop" aria-label={`${settings.siteName}, ${t.toStart}`}>
    <span class="navbar__logo-word is-1" aria-hidden="true">
      <span class="navbar__logo-text" data-nav-logo-text="1">Tristan</span>
    </span>
    <span class="navbar__logo-line" data-nav-logo-line aria-hidden="true"></span>
    <span class="navbar__logo-word is-2" aria-hidden="true">
      <span class="navbar__logo-text" data-nav-logo-text="2">Weithaler</span>
    </span>
  </a>
  {/* Mobiles Kürzel „T|W": die Buchstaben bleiben sichtbar UND Teil des
      Accessible-Name (Präfix), sonst meldet axe label-content-name-mismatch
      (sichtbarer Text „TW" nicht im aria-label enthalten). Voller Name folgt
      visually-hidden; die Gold-Linie bleibt dekorativ (aria-hidden). */}
  <a href={homeHref} class="navbar__logo is-mobile">
    <span class="navbar__logo-word is-1">
      <span class="navbar__logo-text" data-nav-logo-text="1">T</span>
    </span>
    <span class="navbar__logo-line" data-nav-logo-line aria-hidden="true"></span>
    <span class="navbar__logo-word is-2">
      <span class="navbar__logo-text" data-nav-logo-text="2">W</span>
    </span>
    <span class="visually-hidden">{`${settings.siteName}, ${t.toStart}`}</span>
  </a>

  <div class="navbar__right" data-nav-right>
    <div class="navbar__right-inner" data-nav-right-inner>
      <nav class="navbar__menu" aria-label={t.mainNav}>
        <ul role="list" class="navbar__list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="navbar__link link-underline"
                  data-underline
                  target={isExternal(item.href) ? '_blank' : undefined}
                  rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
                >
                  <span class="link-underline__label">{item.label}</span>
                  <span class="link-underline__line" aria-hidden="true"></span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        class="navbar__burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-nav-toggle
      >
        <span class="visually-hidden">{t.menu}</span>
        <span class="navbar__burger-line is-top" data-burger-top aria-hidden="true"></span>
        <span class="navbar__burger-line is-middle" data-burger-middle aria-hidden="true"></span>
        <span class="navbar__burger-line is-bottom" data-burger-bottom aria-hidden="true"></span>
      </button>

      {
        settings.headerCta && (
          <a
            class="btn-glow navbar__cta"
            href={headerCtaHref}
            rel="nofollow"
            data-glow
          >
            <span class="btn-glow__circle" aria-hidden="true" data-glow-circle="" />
            <span class="btn-glow__wrapper">
              <span class="btn-glow__content">
                <svg
                  class="navbar__cta-gift"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="8" width="18" height="4" rx="1" />
                  <path d="M12 8v13" />
                  <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                  <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8Z" />
                  <path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8Z" />
                </svg>
                <span class="btn-glow__label">{settings.headerCta.label}</span>
              </span>
            </span>
          </a>
        )
      }
    </div>
  </div>
  </div>
</header>

<div class="menu" id="site-menu" data-site-menu hidden>
  <nav class="menu__panel" aria-label={t.menu} data-menu-panel>
    <div class="menu__spacer" aria-hidden="true"></div>
    {
      menuItems.map((item) => (
        <a
          href={item.href}
          class="menu__link"
          data-menu-link
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
        >
          <span class="menu__wipe" data-menu-wipe aria-hidden="true"></span>
          <span class="menu__click-wipe" data-menu-click-wipe aria-hidden="true"></span>
          <span class="menu__text" data-menu-text>{item.label}</span>
          <img
            class="menu__arrow"
            data-menu-arrow
            src={arrowWhite.src}
            alt=""
            width="36"
            height="36"
            loading="lazy"
          />
        </a>
      ))
    }
  </nav>
</div>

<style>
  /* --- Navbar (fix, Blur; BG-Farbe getrennt vom Verlauf, weil IX2 beim
         Menü-Öffnen NUR die background-color animiert) ------------------- */
  .navbar {
    position: fixed;
    inset: 0 0 auto auto;
    z-index: 499;
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--header-h);
    max-height: 80px;
    margin-inline: auto;
    padding: 0.125rem 5vw;
    background-color: var(--overlay-navbar);
    background-image: linear-gradient(var(--overlay-navbar-tint), var(--overlay-navbar-tint));
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
  }

  /* Stabiler Inhalts-Container wie `.navbar_container` im Webflow-Original:
     Die fixe Blur-Fläche bleibt dadurch beim Breakpoint-Wechsel strukturell
     unverändert; nur Logo und rechter Bereich wechseln bzw. animieren. */
  .navbar__container {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-inline: auto;
  }

  /* --- Split-Wortmarke (Word-Wrapper = Overflow-Masken der Load-Anim) ------ */
  .navbar__logo { display: inline-flex; align-items: center; text-decoration: none; }
  .navbar__logo-word { display: inline-block; position: relative; overflow: hidden; }
  .navbar__logo-word.is-1 { padding-right: 0.625rem; }
  .navbar__logo-word.is-2 { padding-left: 0.75rem; }
  .navbar__logo-text {
    display: block;
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .navbar__logo-line {
    width: 1.75px;
    height: 2rem;
    background: var(--brand);
    flex: none;
  }
  .navbar__logo.is-mobile { display: none; }

  /* --- Rechte Seite: Overflow-Maske (Load-Anim + 9.2rem-Menü-Shift) -------- */
  .navbar__right {
    z-index: 99999;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    transform: translate3d(0, 0, 0);
    transform-style: preserve-3d;
  }
  .navbar__right-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    position: relative;
    transform: translate3d(0, 0, 0);
    transform-style: preserve-3d;
  }
  .navbar__list { display: flex; align-items: center; gap: 1.5rem; margin: 0; padding: 0; }
  /* Jedes <li> als Flexbox: zentriert den Link vertikal und nimmt dem
     inline-block-Anker die Grundlinien-Macke (overflow:hidden → Baseline =
     Unterkante; die Zeilenbox reserviert dann die Font-Unterlänge DARUNTER und
     schöbe den Text sonst ~4px zu hoch). Im Original ist der Link ein direktes
     Flex-Kind von .navbar_menu-desktop und hat das Problem nicht. */
  .navbar__list li { display: flex; align-items: center; }
  .navbar__link {
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 300;
  }
  .navbar__link:hover { color: var(--ink); }
  .navbar__cta .btn-glow__content { gap: 0.55rem; }
  .navbar__cta-gift {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--brand-readable);
    flex: none;
  }

  /* --- Burger (nur ≤991, wie im Original; Linien-Morph macht menu.ts) ------ */
  .navbar__burger {
    display: none;
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 3rem;
    height: 3rem;
    padding: 0.375rem 0.5rem;
    background: var(--paper-2);
    border: 0;
    border-radius: 100%;
    cursor: pointer;
    flex: none;
    overflow: hidden;
  }
  .navbar__burger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    flex: none;
  }

  /* --- Fullscreen-Menü (nur ≤991 erreichbar; Panel #121212 von links) ------ */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    width: 100%;
    /* 100vh als Fallback; dvh folgt auf Mobilgeräten der ein-/ausgeblendeten
       Browserleiste und hält den Wischbereich im tatsächlich sichtbaren Raum. */
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }
  .menu[hidden] { display: none; }
  .menu__panel {
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    background: var(--panel);
    overflow-y: auto;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
  }
  .menu__spacer { width: 100%; height: 15%; flex: none; }

  .menu__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 15.34%;
    flex: none;
    padding: 0.75rem 4.5rem 0.75rem 3.5rem;
    border-bottom: 1.5px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
  }
  /* Hover-/Klick-Wipes: Höhe animiert menu.ts (IX2 a-56/a-57/a-74);
     Basis 0, damit sie ohne JS nie Inhalte überdecken. */
  .menu__wipe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0;
    background: var(--paper);
    pointer-events: none;
  }
  .menu__click-wipe {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0;
    background: var(--paper-2);
    pointer-events: none;
  }
  .menu__text {
    position: relative;
    z-index: 1;
    font-size: 3.25rem;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .menu__arrow {
    position: relative;
    z-index: 1;
    width: auto;
    height: 2.25rem;
    flex: none;
  }

  /* --- Breakpoints (1:1 Export) -------------------------------------------- */
  @media (max-width: 991px) {
    .navbar__menu { display: none; }
    .navbar__burger { display: inline-flex; }
    .navbar__right-inner { gap: 0.75rem; }
  }
  @media (max-width: 767px) {
    .navbar__logo.is-desktop { display: none; }
    .navbar__logo.is-mobile { display: inline-flex; height: 3rem; }
    .navbar__logo-word.is-1 { padding-right: 0.25rem; }
    .navbar__logo-word.is-2 { padding-left: 0.25rem; }
    .navbar__logo.is-mobile .navbar__logo-line { background: var(--brand); }
  }
  @media (max-width: 479px) {
    .menu__link { padding-left: 6vw; padding-right: 6vw; }
    .menu__text { font-size: 2.75rem; letter-spacing: -0.03em; }
    .menu__arrow { height: 2rem; }
  }
</style>

<script>
  import '../scripts/menu.ts';
</script>
