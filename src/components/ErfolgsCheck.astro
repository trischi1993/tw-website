---
import {
  ERFOLGS_CHECK_AREAS,
  ERFOLGS_CHECK_ICONS,
} from '../data/erfolgs-check';
import arrowIcon from '../assets/images/icon-arrow-white.svg';
import '../styles/erfolgs-check.css';
---

<section class="success-check" data-erfolgs-check aria-labelledby="success-check-title">
  <div class="success-check__ambient is-one" aria-hidden="true"></div>
  <div class="success-check__ambient is-two" aria-hidden="true"></div>

  <div class="success-check__container">
    <header class="success-check__hero" data-check-hero>
      <p class="success-check__eyebrow">
        <span aria-hidden="true"></span> 100 % kostenlos · Ergebnis in nur 5 Min.
      </p>
      <h1 id="success-check-title">
        Dein persönlicher <span>Instagram-<wbr />Erfolgs‑Check</span>
      </h1>
      <p class="success-check__hero-copy">
        Fast jeder Instagram-Account lässt irgendwo Potenzial liegen – oft ohne es zu merken.
        Dieser Selbst-Check zeigt dir, wo deine größten Hebel liegen, um endlich aufs nächste
        Level zu kommen.
      </p>
      <ul class="success-check__meta" role="list">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5" y="3" width="14" height="18" rx="2"></rect>
            <path d="M9 8h6M9 12h6M9 16h4"></path>
          </svg>
          18 interaktive Praxisfragen
        </li>
        <li class="success-check__meta-arrow" aria-hidden="true">→</li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 3h7l4 4v14H7zM14 3v5h4"></path>
            <path d="M12.5 11v6m0 0 2.5-2.5M12.5 17 10 14.5"></path>
          </svg>
          Direktes Ergebnis + PDF-Download
        </li>
      </ul>
    </header>

    <div class="success-check__compact-title" data-check-compact hidden>
      <span class="success-check__compact-mark" aria-hidden="true">TW</span>
      <div>
        <span>Instagram</span>
        <strong>Erfolgs-Check</strong>
      </div>
    </div>

    <div class="success-check__progress" data-check-progress hidden>
      <div class="success-check__progress-copy">
        <span data-check-progress-label>Frage 1 von 18</span>
        <span class="success-check__progress-status">
          <em data-check-progress-motivation>Gleich weißt du mehr über deinen Account</em>
          <strong data-check-progress-value>6%</strong>
        </span>
      </div>
      <div
        class="success-check__progress-track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label="Fortschritt"
        data-check-progress-track
      >
        <span></span>
      </div>
    </div>

    <div data-check-stage>
      <div class="success-check__start-card">
        <button
          class="btn-glow success-check__primary-button"
          type="button"
          data-check-start
          data-check-glow
        >
          <span class="btn-glow__circle" aria-hidden="true" data-check-glow-circle></span>
          <span class="btn-glow__wrapper">
            <span class="btn-glow__content">
              <span class="btn-glow__label">Check starten</span>
              <span class="btn-arrows" aria-hidden="true">
                <img src={arrowIcon.src} alt="" data-check-icon-1 />
                <img src={arrowIcon.src} alt="" data-check-icon-2 />
              </span>
            </span>
          </span>
        </button>
        <small>100 % kostenlos · in nur 5 Minuten zum Ergebnis</small>

        <div class="success-check__start-layout">
          <section class="success-check__start-section success-check__areas-section">
            <h2 class="success-check__start-section-heading">
              <span>Alle 6 Erfolgsbereiche werden gecheckt</span>
            </h2>
            <div class="success-check__area-grid">
              {
                ERFOLGS_CHECK_AREAS.map((area, index) => (
                  <div class="success-check__area-tile">
                    <span class="success-check__area-icon" set:html={ERFOLGS_CHECK_ICONS[index]} />
                    <span>{area.short}</span>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="success-check__start-section success-check__profile-section">
            <h2 class="success-check__start-section-heading">
              <span>Dein Ergebnisprofil enthält</span>
            </h2>
            <div class="success-check__profile-layout">
              <div class="success-check__start-preview" data-check-start-preview aria-hidden="true">
                <div class="success-check__start-preview-head">
                  <span class="success-check__preview-heading-desktop">Diagramme</span>
                </div>
                <div class="success-check__start-preview-score">
                  <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="success-check__start-preview-score-track" cx="60" cy="60" r="57" pathLength="100"></circle>
                    <circle class="success-check__start-preview-score-value" data-check-preview-score-ring cx="60" cy="60" r="57" pathLength="100" stroke-dasharray="100" stroke-dashoffset="27" transform="rotate(-90 60 60)"></circle>
                  </svg>
                  <div>
                    <strong data-check-preview-score data-preview-value="73">73%</strong>
                    <span>Gesamt-Score</span>
                  </div>
                </div>
                <div class="success-check__start-preview-metrics">
                  <small>Bereichs-Scores</small>
                  <div class="success-check__start-preview-metric">
                    <span><b>Strategie</b><strong>78%</strong></span>
                    <i><em data-preview-value="78" style="--preview-value: 78%"></em></i>
                  </div>
                  <div class="success-check__start-preview-metric">
                    <span><b>Content</b><strong>64%</strong></span>
                    <i><em data-preview-value="64" style="--preview-value: 64%"></em></i>
                  </div>
                  <div class="success-check__start-preview-metric">
                    <span><b>Analyse</b><strong>58%</strong></span>
                    <i><em data-preview-value="58" style="--preview-value: 58%"></em></i>
                  </div>
                </div>
              </div>
              <div class="success-check__start-benefits">
                <small class="success-check__profile-features-heading">Auswertungen</small>
                <ul role="list">
                  <li>
                    <span class="success-check__profile-feature-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path d="m12 12 4-3M12 7v1"></path></svg>
                    </span>
                    <span class="success-check__profile-feature-label">Score-Übersicht</span>
                    <small class="success-check__profile-feature-value">7 Werte</small>
                  </li>
                  <li>
                    <span class="success-check__profile-feature-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="m4 17 5-5 3 3 7-8M15 7h4v4"></path></svg>
                    </span>
                    <span class="success-check__profile-feature-label">Wachstumshebel</span>
                    <small class="success-check__profile-feature-value">priorisiert</small>
                  </li>
                  <li>
                    <span class="success-check__profile-feature-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M8.5 14.5A6 6 0 1 1 15.5 14.5c-.8.6-1.2 1.2-1.3 2h-4.4c-.1-.8-.5-1.4-1.3-2Z"></path></svg>
                    </span>
                    <span class="success-check__profile-feature-label">Tipps &amp; Empfehlungen</span>
                    <small class="success-check__profile-feature-value">individuell</small>
                  </li>
                  <li>
                    <span class="success-check__profile-feature-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v5h4M12.5 11v6m0 0 2.5-2.5M12.5 17 10 14.5"></path></svg>
                    </span>
                    <span class="success-check__profile-feature-label">PDF-Version zum Download</span>
                    <small class="success-check__profile-feature-value">inklusive</small>
                  </li>
                </ul>
              </div>
            </div>
          </section>
        </div>

        <p>
          Beantworte jede Frage so ehrlich wie möglich, um das bestmögliche Ergebnis zu
          erhalten.
        </p>
        <button
          class="success-check__mobile-start-link"
          type="button"
          data-check-start
        >
          <span>Jetzt Check starten</span>
          <img src={arrowIcon.src} alt="" aria-hidden="true" />
        </button>
      </div>
    </div>

    <noscript>
      <p class="success-check__noscript">
        Für den interaktiven Erfolgs-Check muss JavaScript in deinem Browser aktiviert sein.
      </p>
    </noscript>
  </div>
</section>

<script>
  import '../scripts/erfolgs-check';
</script>
