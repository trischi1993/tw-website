---
import CmsImage from './CmsImage.astro';
import GlowButton from './sections/GlowButton';
import FaqSection from './sections/FaqSection';
import type { EbookContent, SectionFaq } from '../lib/content/types';
import '../styles/ebook.css';

interface Props {
  content: EbookContent;
}

const { content } = Astro.props;
const BUY_URL = '/bestellen/';
const {
  product,
  hero,
  press,
  intro,
  benefits,
  author,
  chapters,
  evergreen,
  bundle,
  audience,
  reviews,
  finalCta,
  faq,
} = content;

const ebookFaq: SectionFaq = {
  _type: 'sectionFaq',
  _key: 'ebook-faq',
  name: 'FAQs',
  heading: faq.heading,
  items: faq.items,
};
---

<div class="ebook">
  <section class="ebook-hero" aria-labelledby="ebook-hero-title" data-ebook-hero>
    <div class="ebook-hero__ambient is-one" aria-hidden="true"></div>
    <div class="ebook-hero__ambient is-two" aria-hidden="true"></div>
    <div class="container ebook-hero__grid">
      <div class="ebook-hero__content">
        <div data-ebook-heading>
          <p class="ebook-eyebrow">{hero.eyebrow}</p>
          <h1 id="ebook-hero-title">
            {hero.title}
            <strong>{hero.titleHighlight}</strong>
          </h1>
        </div>
        <div data-ebook-intro>
          <p class="ebook-hero__lead">{hero.lead}</p>
          <p class="ebook-hero__copy">{hero.text}</p>
        </div>
        <ul class="ebook-hero__facts" role="list" aria-label="E-Book-Umfang" data-ebook-facts>
          <li><strong>{product.pageCount}</strong><span>Seiten</span></li>
          <li><strong>{product.chapterCount}</strong><span>Kapitel</span></li>
          <li><strong>{product.bonusCount}</strong><span>Boni</span></li>
        </ul>
        <div class="ebook-hero__action" data-ebook-buttons>
          <GlowButton label={hero.ctaLabel} href={BUY_URL} />
          <p><span>{hero.pricePrefix}</span><strong>{hero.priceText}</strong></p>
        </div>
      </div>

      <div class="ebook-hero__visual" data-ebook-visual>
        <span class="ebook-hero__stamp" aria-hidden="true">
          <span class="ebook-hero__stamp-content">
            {hero.stampText.split('\n').map((line, index) => (
              <>{index > 0 && <br />}{line}</>
            ))}
          </span>
        </span>
        <CmsImage
          image={hero.image}
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 991px) 92vw, 50vw"
          format="webp"
          quality={84}
          decoding="async"
          loading="eager"
          fetchpriority="auto"
        />
        <div class="ebook-hero-phone-screen" aria-hidden="true">
          <CmsImage
            class="ebook-hero-phone-screen__image"
            image={hero.phoneImage}
            alt=""
            widths={[180, 300, 480]}
            sizes="(max-width: 991px) 16vw, 9vw"
            format="webp"
            quality={90}
          />
          <span class="ebook-hero-phone-screen__island"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="ebook-trust" aria-labelledby="ebook-press-title">
    <div class="container ebook-trust__head">
      <p id="ebook-press-title">{press.heading}</p>
    </div>
    <div class="ebook-trust__viewport">
      <div class="ebook-trust__track">
        {[0, 1, 2].map((copy) => (
          <div class="ebook-trust__sequence" aria-hidden={copy > 0 ? 'true' : undefined}>
            {press.items.map((item) => (
              <span class="ebook-trust__logo">
                <CmsImage
                  image={item.image}
                  alt={copy === 0 ? item.image?.alt ?? '' : ''}
                  widths={[160, 240, 320]}
                  sizes="160px"
                  format="webp"
                  quality={90}
                />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ebook-intro section" aria-labelledby="ebook-intro-title">
    <div class="container">
      <p class="ebook-kicker" data-anim="reveal">{intro.kicker}</p>
      <h2
        id="ebook-intro-title"
        data-anim="lines"
        data-delay="0.2"
        data-stagger="0.5"
      >
        {intro.heading}{' '}
        <span>{intro.headingHighlight}</span>
      </h2>
      <p class="ebook-intro__copy" data-anim="reveal" data-delay="0.16">{intro.text}</p>
    </div>
  </section>

  <section class="ebook-benefits section is-alt" aria-labelledby="ebook-benefits-title">
    <div class="container">
      <div class="ebook-section-head">
        <div>
          <p class="ebook-kicker" data-anim="reveal">{benefits.kicker}</p>
          <h2 id="ebook-benefits-title" data-anim="reveal">{benefits.heading}</h2>
        </div>
        <p data-anim="reveal">{benefits.intro}</p>
      </div>
      <div class="ebook-benefits__grid">
        {benefits.items.map((benefit, index) => (
          <article
            class="ebook-benefit"
            data-anim="reveal"
            data-delay={String(index * 0.06)}
            data-ebook-mobile-benefit
          >
            <div class="ebook-benefit__top">
              <span class="ebook-benefit__icon" aria-hidden="true">
                {benefit.icon === 'insights' && (
                  <svg viewBox="0 0 48 48">
                    <rect x="5.75" y="6.75" width="36.5" height="34.5" rx="6" />
                    <path d="m11 33 8-8 6 4 11-13" />
                    <path d="M29.5 16H36v6.5" />
                    <path d="M11 14h8" />
                  </svg>
                )}
                {benefit.icon === 'strategy' && (
                  <svg viewBox="0 0 48 48">
                    <circle cx="34" cy="14" r="8" />
                    <circle cx="34" cy="14" r="3" />
                    <path d="M7 38c0-7 4-11 11-11h7c5 0 9-4 9-9" />
                    <circle cx="7" cy="38" r="2.5" />
                    <path d="M13 38h7" />
                  </svg>
                )}
                {benefit.icon === 'steps' && (
                  <svg viewBox="0 0 48 48">
                    <rect x="7" y="8" width="34" height="32" rx="6" />
                    <circle cx="15" cy="17" r="2.5" />
                    <circle cx="15" cy="31" r="2.5" />
                    <path d="M21 17h12M21 31h12M15 19.5v9" />
                    <path d="m29 23 2.5 2.5L37 20" />
                  </svg>
                )}
                {benefit.icon === 'learnings' && (
                  <svg viewBox="0 0 48 48">
                    <path d="M15 24.5a12 12 0 1 1 18 0c-2.5 2.2-3.7 4.1-3.7 6.5H18.7c0-2.4-1.2-4.3-3.7-6.5Z" />
                    <path d="M19 36h10M21.5 41h5" />
                    <path d="m20 19 3 3 5.5-6" />
                    <path d="M24 4V1M9.5 10 7 7.5M38.5 10 41 7.5" />
                  </svg>
                )}
              </span>
              <small>{String(index + 1).padStart(2, '0')}</small>
            </div>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
      <div class="ebook-section-cta" data-anim="reveal" data-delay="0.12">
        <p>{benefits.note}</p>
        <GlowButton label={benefits.ctaLabel} href={BUY_URL} />
      </div>
    </div>
  </section>

  <section class="ebook-author section" aria-labelledby="ebook-author-title">
    <div class="container ebook-author__grid">
      <div class="ebook-author__media" data-anim="reveal">
        <CmsImage
          image={author.image}
          widths={[480, 720, 960]}
          sizes="(max-width: 991px) 90vw, 45vw"
          format="webp"
          quality={82}
        />
        <p>{author.caption}<br /><strong>{author.captionHighlight}</strong></p>
      </div>
      <div class="ebook-author__content">
        <p class="ebook-kicker" data-anim="reveal">{author.kicker}</p>
        <h2 id="ebook-author-title" data-anim="reveal">{author.heading}</h2>
        <div class="ebook-author__copy" data-anim="reveal" data-delay="0.08">
          {author.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <dl class="ebook-author__stats" data-anim="reveal" data-delay="0.14">
          {author.stats.map((stat) => (
            <div>
              <dt
                data-ebook-count={stat.value}
                data-ebook-count-suffix={stat.suffix}
                aria-label={`${stat.value}${stat.suffix}`}
              >{stat.value}{stat.suffix}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="ebook-chapters section is-alt" aria-labelledby="ebook-chapters-title">
    <div class="container">
      <div class="ebook-chapters__head">
        <div>
          <p class="ebook-kicker" data-anim="reveal">{chapters.kicker}</p>
          <h2 id="ebook-chapters-title" data-anim="reveal">{chapters.heading}</h2>
        </div>
        <p data-anim="reveal">{chapters.intro}</p>
      </div>
      <div class="ebook-chapters__layout">
        <div class="ebook-chapters__visual" data-anim="reveal">
          <div class="ebook-chapters__mockup">
            <CmsImage
              class="ebook-chapters__base"
              image={chapters.image}
              widths={[420, 640, 843]}
              sizes="(max-width: 991px) 84vw, 36vw"
              format="webp"
              quality={82}
            />
            <div class="ebook-chapters-phone-screen" aria-hidden="true">
              <CmsImage
                class="ebook-chapters-phone-screen__image"
                image={chapters.phoneImage}
                alt=""
                widths={[120, 180, 260]}
                sizes="(max-width: 991px) 16vw, 7vw"
                format="webp"
                quality={90}
              />
              <span class="ebook-chapters-phone-screen__island"></span>
            </div>
          </div>
        </div>
        <ol class="ebook-chapters__list">
          {chapters.items.map((chapter, index) => (
            <li data-anim="reveal" data-delay={String((index % 3) * 0.04)}>
              <span>{chapter.number}</span>
              <div><h3>{chapter.title}</h3><p>{chapter.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="ebook-section-cta is-centered" data-anim="reveal">
        <p>{chapters.note}</p>
        <GlowButton label={chapters.ctaLabel} href={BUY_URL} />
      </div>
    </div>
  </section>

  <section class="ebook-evergreen" aria-labelledby="ebook-evergreen-title">
    <div class="container ebook-evergreen__inner">
      <div class="ebook-evergreen__visual" data-anim="reveal">
        <div
          class="ebook-results-carousel"
          data-ebook-carousel
          role="region"
          aria-roledescription="Karussell"
          aria-label={evergreen.carouselLabel}
          data-ebook-effect="spotlight"
        >
          <div class="ebook-results-carousel__effect" aria-hidden="true">
            <span class="ebook-results-carousel__spotlight"></span>
            <span class="ebook-results-carousel__orbit is-outer"></span>
            <span class="ebook-results-carousel__orbit is-inner"></span>
            <span class="ebook-results-carousel__pulse"></span>
          </div>
          <div class="ebook-results-carousel__viewport" aria-live="polite">
          {evergreen.results.map((result, index) => (
            <figure
              class:list={['ebook-results-carousel__slide', { 'is-active': index === 0 }]}
              data-ebook-slide
              data-state={index === 0 ? '0' : index === 1 ? '1' : index === evergreen.results.length - 1 ? '-1' : 'far'}
              aria-hidden={index === 0 ? 'false' : 'true'}
              aria-label={`${index + 1} von ${evergreen.results.length}`}
            >
              <div class="ebook-results-carousel__device">
                <CmsImage
                  image={result.image}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 767px) 68vw, 25vw"
                  format="webp"
                  quality={90}
                />
                <span class="ebook-results-carousel__device-sheen" aria-hidden="true"></span>
              </div>
            </figure>
          ))}
          </div>
          <div class="ebook-results-carousel__engagement" aria-hidden="true">
            <span class="ebook-engagement-icon is-heart is-near">
              <svg viewBox="0 0 48 48"><path d="M24 41S7 31.2 7 18.5C7 12.7 11.1 9 16.2 9c3.2 0 6.1 1.7 7.8 4.3C25.7 10.7 28.6 9 31.8 9 36.9 9 41 12.7 41 18.5 41 31.2 24 41 24 41Z" /></svg>
            </span>
            <span class="ebook-engagement-icon is-comment is-far">
              <svg viewBox="0 0 48 48"><path d="M8 9h32v25H20l-10 7v-7H8V9Z" /><path d="M16 21h.1M24 21h.1M32 21h.1" /></svg>
            </span>
            <span class="ebook-engagement-icon is-bookmark is-far">
              <svg viewBox="0 0 48 48"><path d="M13 6h22v36l-11-8-11 8V6Z" /></svg>
            </span>
            <span class="ebook-engagement-icon is-share is-near">
              <svg viewBox="0 0 48 48"><path d="M5 22 43 6 30 43l-7-14-18-7Z" /><path d="M23 29 43 6" /></svg>
            </span>
          </div>
          <div class="ebook-results-carousel__controls">
            <button class="ebook-results-carousel__arrow is-prev" type="button" data-ebook-carousel-prev aria-label="Vorheriges Ergebnis">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
            </button>
            <button class="ebook-results-carousel__arrow is-next" type="button" data-ebook-carousel-next aria-label="Nächstes Ergebnis">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
            </button>
            <div class="ebook-results-carousel__dots" aria-label="Ergebnis auswählen">
              {evergreen.results.map((_, index) => (
                <button
                  class:list={['ebook-results-carousel__dot', { 'is-active': index === 0 }]}
                  type="button"
                  data-ebook-carousel-dot={index}
                  aria-label={`Ergebnis ${index + 1} anzeigen`}
                  aria-current={index === 0 ? 'true' : undefined}
                ></button>
              ))}
            </div>
            <p class="ebook-results-carousel__meta" aria-hidden="true">
              <span data-ebook-carousel-current>01</span>
              <small>/ {String(evergreen.results.length).padStart(2, '0')} &nbsp; {evergreen.carouselMeta}</small>
            </p>
          </div>
        </div>
        <div class="ebook-effect-tester" data-ebook-effect-tester hidden>
          <span>Mockup-Animation testen</span>
          <div role="group" aria-label="Animationsvariante auswählen">
            <button type="button" data-ebook-effect-button="spotlight" aria-pressed="true">Spotlight</button>
            <button type="button" data-ebook-effect-button="orbit" aria-pressed="false">Orbit</button>
            <button type="button" data-ebook-effect-button="pulse" aria-pressed="false">Insight-Pulse</button>
            <button type="button" data-ebook-effect-button="engagement" aria-pressed="false">Engagement Halo</button>
            <button type="button" data-ebook-effect-button="cinematic" aria-pressed="false">Cinematic</button>
          </div>
        </div>
      </div>
      <div>
        <p class="ebook-kicker" data-anim="reveal">{evergreen.kicker}</p>
        <h2 id="ebook-evergreen-title" data-anim="reveal">{evergreen.heading}</h2>
        <p data-anim="reveal" data-delay="0.08">{evergreen.text}</p>
      </div>
    </div>
  </section>

  <section class="ebook-bundle section is-alt" aria-labelledby="ebook-bundle-title">
    <div class="container">
      <div class="ebook-bundle__head text-center">
        <p class="ebook-kicker" data-anim="reveal">{bundle.kicker}</p>
        <h2 id="ebook-bundle-title" data-anim="reveal">{bundle.heading}</h2>
        <p data-anim="reveal" data-delay="0.08">{bundle.intro}</p>
      </div>
      <div class="ebook-bundle__grid">
        {bundle.items.map((item, index) => (
          <>
            {index > 0 && (
              <span
                class="ebook-bundle__plus"
                aria-hidden="true"
                data-anim="reveal"
                data-delay={String(index * 0.1 - 0.04)}
              >+</span>
            )}
            <article
              class:list={['ebook-bundle-card', { 'is-book': index === 0 }]}
              data-anim="reveal"
              data-delay={String(index * 0.1)}
            >
              <div class="ebook-bundle-card__visual">
                <CmsImage
                  image={item.image}
                  widths={[320, 480, 640, 800, 1000]}
                  sizes="(max-width: 991px) 76vw, 25vw"
                  format={index === 0 ? 'webp' : 'png'}
                  quality={index === 0 ? 90 : 100}
                />
              </div>
              <div class="ebook-bundle-card__content">
                <p class="ebook-bundle-card__eyebrow">{item.eyebrow}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <div class="ebook-bundle-card__price">
                  <span>Wert <s>{item.value}</s></span>
                  <strong>{item.price}</strong>
                </div>
              </div>
            </article>
          </>
        ))}
      </div>
      <div class="ebook-price" data-anim="reveal">
        <div>
          <p>{bundle.totalLabel}</p>
          <s>{bundle.totalValue}</s>
        </div>
        <div>
          <p>{bundle.priceLabel}</p>
          <strong>{bundle.price}</strong>
        </div>
        <GlowButton label={bundle.ctaLabel} href={BUY_URL} />
      </div>
    </div>
  </section>

  <section class="ebook-audience section" aria-labelledby="ebook-audience-title">
    <div class="container">
      <div class="ebook-section-head">
        <div>
          <p class="ebook-kicker" data-anim="reveal">{audience.kicker}</p>
          <h2 id="ebook-audience-title" data-anim="reveal">{audience.heading}</h2>
        </div>
      </div>
      <div class="ebook-audience__grid">
        {audience.items.map((audienceItem, index) => (
          <article data-anim="reveal" data-delay={String(index * 0.08)}>
            <CmsImage
              class="ebook-audience__image"
              image={audienceItem.image}
              widths={[480, 720, 960]}
              sizes="(max-width: 991px) 94vw, 31vw"
              format="webp"
              quality={82}
            />
            <span class="ebook-audience__number" aria-hidden="true">0{index + 1}</span>
            <div class="ebook-audience__content">
              <h3>{audienceItem.title}</h3>
              <p>{audienceItem.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ebook-reviews section is-alt" aria-labelledby="ebook-reviews-title">
    <div class="container">
      <div class="ebook-reviews__head text-center">
        <p class="ebook-kicker" data-anim="reveal">{reviews.kicker}</p>
        <h2 id="ebook-reviews-title" data-anim="reveal">{reviews.heading}</h2>
      </div>
      <div class="ebook-reviews__grid">
        {reviews.items.map((review, index) => (
          <figure class:list={['ebook-review', { 'is-featured': index === 0 }]} data-anim="reveal" data-delay={String(index * 0.08)}>
            <div class="ebook-review__stars" aria-label="5 von 5 Sternen">★★★★★</div>
            <blockquote>„{review.text}“</blockquote>
            <figcaption>
              <CmsImage image={review.image} alt="" width={56} height={56} format="webp" quality={82} />
              <span><strong>{review.name}</strong><small>{review.role}</small></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="ebook-final section" aria-labelledby="ebook-final-title">
    <div class="container ebook-final__inner">
      <p class="ebook-kicker" data-anim="reveal">{finalCta.kicker}</p>
      <h2 id="ebook-final-title" data-anim="reveal">{finalCta.heading}</h2>
      <p data-anim="reveal" data-delay="0.08">{finalCta.text}</p>
      <div class="ebook-final__price" data-anim="reveal" data-delay="0.12">
        <span>{finalCta.pricePrefix}</span><strong>{finalCta.price}</strong><s>{finalCta.totalValue}</s>
      </div>
      <div data-anim="reveal" data-delay="0.16">
        <GlowButton label={finalCta.ctaLabel} href={BUY_URL} />
      </div>
    </div>
  </section>

  <FaqSection section={ebookFaq} />
</div>

<script>
  import '../scripts/ebook-carousel';
  import '../scripts/ebook-count-up';
  import '../scripts/ebook-mobile-benefits';

  // Kampagnen- und Affiliate-Parameter bis zum bestehenden Systeme.io-
  // Bestellformular mitnehmen. So bleiben bereits verschickte Links mit
  // utm_*/sa/etc. auch nach dem Austausch der Landingpage auswertbar.
  const preserveCheckoutParameters = () => {
    if (!window.location.search) return;
    const sourceParameters = new URLSearchParams(window.location.search);

    document.querySelectorAll<HTMLAnchorElement>('a[href="/bestellen/"]').forEach((link) => {
      const target = new URL(link.href);
      sourceParameters.forEach((value, key) => {
        if (!target.searchParams.has(key)) target.searchParams.append(key, value);
      });
      link.href = `${target.pathname}${target.search}${target.hash}`;
    });
  };

  preserveCheckoutParameters();
  document.addEventListener('astro:page-load', preserveCheckoutParameters);
</script>
