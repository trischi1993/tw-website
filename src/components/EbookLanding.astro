---
import { Image } from 'astro:assets';
import GlowButton from './sections/GlowButton';
import FaqSection from './sections/FaqSection';
import type { SectionFaq } from '../lib/content/types';
import heroImage from '../assets/images/ebook/hero-v5.png';
import heroPhoneInsightsImage from '../assets/images/ebook/hero-phone-insights-gold.png';
import bookMockupImage from '../assets/images/ebook/book-mockup-v3.png';
import authorImage from '../assets/images/ebook/author.jpg';
import chaptersImage from '../assets/images/ebook/chapters.png';
import bioCreatorImage from '../assets/images/ebook/insta-bio-creator-v2.png';
import bonusDownloadsImage from '../assets/images/ebook/bonus-downloads-v2.png';
import pressVinschgerwindImage from '../assets/images/ebook/press-vinschgerwind-transparent.png';
import pressSuedtirolHeuteImage from '../assets/images/ebook/press-suedtirol-heute-transparent.png';
import pressRadioSuedtirolImage from '../assets/images/ebook/press-radio-suedtirol-1-transparent.png';
import pressDerVinschgerImage from '../assets/images/ebook/press-der-vinschger-transparent.png';
import pressZettImage from '../assets/images/ebook/press-zett-am-sonntag-transparent.png';
import pressRaiSuedtirolImage from '../assets/images/ebook/press-rai-suedtirol-transparent.png';
import resultOneImage from '../assets/images/ebook/result-insight-1.png';
import resultTwoImage from '../assets/images/ebook/result-insight-2.png';
import resultThreeImage from '../assets/images/ebook/result-insight-3.png';
import resultFourImage from '../assets/images/ebook/result-insight-4.png';
import resultFiveImage from '../assets/images/ebook/result-insight-5.png';
import resultSixImage from '../assets/images/ebook/result-insight-6.png';
import audienceSelfEmployedImage from '../assets/images/ebook/audience-self-employed.jpg';
import audienceCreatorImage from '../assets/images/ebook/audience-creator.jpg';
import audienceCompanyImage from '../assets/images/ebook/audience-company.jpg';
import barbaraImage from '../assets/images/testimonials/barbara-prantl.webp';
import naomiImage from '../assets/images/testimonials/naomi-kircher.avif';
import buonomemesImage from '../assets/images/testimonials/buonomemes.avif';
import '../styles/ebook.css';

const BUY_URL = '/bestellen/';

const benefits = [
  {
    number: '01',
    icon: 'insights',
    title: 'Exklusive Einblicke',
    text: 'Praxisbeispiele aus 8+ Jahren Social Media – ehrlich, verständlich und auf den Punkt gebracht.',
  },
  {
    number: '02',
    icon: 'strategy',
    title: 'Nachhaltige Strategien',
    text: 'Bewährte Methoden für organische Reichweite, echte Follower und eine langfristige Monetarisierung.',
  },
  {
    number: '03',
    icon: 'steps',
    title: 'Step-by-Step-Guide',
    text: 'Ein klarer Weg von deiner Vision und Positionierung bis zu Community, Erfolgsmessung und Umsatz.',
  },
  {
    number: '04',
    icon: 'learnings',
    title: 'Meine größten Learnings',
    text: 'Die Fehler und Erkenntnisse, die dir Umwege ersparen und dich schneller ins konsequente Umsetzen bringen.',
  },
];

const pressItems = [
  {
    image: pressVinschgerwindImage,
    alt: 'Vinschgerwind',
  },
  {
    image: pressSuedtirolHeuteImage,
    alt: 'Südtirol Heute',
  },
  {
    image: pressRadioSuedtirolImage,
    alt: 'Radio Südtirol 1',
  },
  {
    image: pressDerVinschgerImage,
    alt: 'Der Vinschger',
  },
  {
    image: pressZettImage,
    alt: 'Zett am Sonntag',
  },
  {
    image: pressRaiSuedtirolImage,
    alt: 'Rai Südtirol',
  },
];

const resultScreens = [
  {
    image: resultOneImage,
    alt: 'Instagram-Ergebnis: über 15 Millionen erreichte Konten in 30 Tagen',
  },
  {
    image: resultFiveImage,
    alt: 'Instagram-Ergebnis: 61.137 Profilaktivitäten und 1.096 Klicks auf den externen Link',
  },
  {
    image: resultTwoImage,
    alt: 'Instagram-Ergebnis: über 10 Millionen Aufrufe für ein Reel',
  },
  {
    image: resultThreeImage,
    alt: 'Instagram-Ergebnis: 138.208 Follower und starkes organisches Wachstum',
  },
  {
    image: resultFourImage,
    alt: 'Instagram-Insight mit einem erfolgreichen Social-Media-Ergebnis',
  },
  {
    image: resultSixImage,
    alt: 'Instagram-Insight mit starkem Community-Wachstum',
  },
];

const chapters = [
  ['01', 'Deine Vision', 'Das Fundament für deinen Erfolg'],
  ['02', 'Zielgruppe & Positionierung', 'Erreiche dein Wunschpublikum'],
  ['03', 'Social Media Branding', 'So bleibt deine Marke im Kopf'],
  ['04', 'Social Media Strategien', 'Mit System statt Zufall'],
  ['05', 'Kontinuität', 'Der Schlüssel zu nachhaltigem Wachstum'],
  ['06', 'Social Media Trends', 'Erkennen und richtig nutzen'],
  ['07', 'Erfolgsmessung', 'Daten analysieren und optimieren'],
  ['08', 'Stories', 'Erzähle Geschichten, die bewegen'],
  ['09', 'BrandFace', 'Mehr Authentizität, Vertrauen und Engagement'],
  ['10', 'Community', 'Echte Verbindungen und loyale Follower'],
  ['11', 'Monetarisierung', 'So wird deine Reichweite zu Umsatz'],
  ['Bonus', 'Meine größten Fehler', 'Und wie du sie vermeidest'],
];

const bundle = [
  {
    eyebrow: 'Das E-Book',
    title: 'Die Instagram Erfolgsformel',
    text: '140 Seiten mit 11 Kapiteln, Bonuskapitel, Praxisbeispielen und direkt umsetzbaren Strategien.',
    value: '160 €',
    price: '27 €',
    image: bookMockupImage,
    alt: 'Das Buch Die Instagram Erfolgsformel',
  },
  {
    eyebrow: 'Bonus 01',
    title: 'Insta BIO Creator',
    text: 'Ein vorbereiteter ChatGPT-Prompt, mit dem du Schritt für Schritt deine perfekte Instagram-Bio erarbeitest.',
    value: '20 €',
    price: 'inklusive',
    image: bioCreatorImage,
    alt: 'Insta BIO Creator Bonus zum E-Book',
  },
  {
    eyebrow: 'Bonus 02',
    title: 'Bonus-Downloads',
    text: 'Zusätzliche ChatGPT-Prompts, hilfreiche Tools, Content-Tipps und weitere praktische Vorlagen.',
    value: '>100 €',
    price: 'inklusive',
    image: bonusDownloadsImage,
    alt: 'Bonus-Downloads mit Prompts, Tools und Content-Tipps',
  },
];

const audiences = [
  {
    title: 'Selbstständige',
    text: 'Mach deine Expertise sichtbar und nutze Social Media gezielt, um mehr Kunden und Umsatz zu gewinnen.',
    image: audienceSelfEmployedImage,
    alt: 'Selbstständiger beim Arbeiten in den Bergen',
  },
  {
    title: 'Influencer & Content Creator',
    text: 'Baue eine loyale Community auf, steigere deine Reichweite und lerne, wie du sie nachhaltig monetarisierst.',
    image: audienceCreatorImage,
    alt: 'Content Creator beim Fotografieren in der Natur',
  },
  {
    title: 'Unternehmen',
    text: 'Erreiche deine Zielgruppe authentisch und stärke mit einer klaren Strategie Sichtbarkeit und Markenbindung.',
    image: audienceCompanyImage,
    alt: 'Team bei der gemeinsamen Arbeit am Laptop',
  },
];

const reviews = [
  {
    name: 'Barbara Prantl',
    role: 'Hobbyköchin & Influencerin (170.000+ Follower)',
    text: 'Ich habe mir Tristans E-Book gekauft und bin auch im persönlichen Austausch mit ihm. Die Tipps sind verständlich erklärt, praxisnah und extrem hilfreich. Gerade die Kombination aus Strategie, echten Erfahrungen und konkreten Beispielen macht das Ganze zu einem richtig starken Werkzeug für alle, die Social Media nachhaltig aufbauen möchten.',
    image: barbaraImage,
  },
  {
    name: 'Naomi Kircher',
    role: 'Mentorin & Influencerin (18.000+ Follower)',
    text: 'Dank Tristans wertvoller Unterstützung konnte ich meine Reichweite innerhalb eines Jahres von 2.000 auf 18.000 Follower steigern – und damit erfolgreich den Grundstein für meine Selbstständigkeit legen.',
    image: naomiImage,
  },
  {
    name: 'Buonomemes',
    role: 'Comedian & Influencer (700.000+ Follower)',
    text: 'Tristan überzeugte uns mit präziser Arbeit, starker Strategie und einem wertvollen Netzwerk. Sein Support war entscheidend für unseren erfolgreichen Launch – fachlich wie menschlich absolut empfehlenswert.',
    image: buonomemesImage,
  },
];

const ebookFaq: SectionFaq = {
  _type: 'sectionFaq',
  _key: 'ebook-faq',
  name: 'FAQs',
  heading: 'FAQs',
  items: [
    {
      _key: 'ebook-faq-platforms',
      question: 'Ist das E-Book nur für Instagram geeignet?',
      answer: [
        {
          _type: 'block',
          _key: 'ebook-faq-platforms-answer-1',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-platforms-answer-1-text',
              text: 'Der Fokus liegt klar auf Instagram, da hier die besten Möglichkeiten für organische Reichweite und nachhaltige Monetarisierung bestehen. Deshalb beziehen sich die konkreten Praxisbeispiele und Schritt-für-Schritt-Erklärungen im E-Book auf Instagram.',
              marks: [],
            },
          ],
        },
        {
          _type: 'block',
          _key: 'ebook-faq-platforms-answer-2',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-platforms-answer-2-text',
              text: 'Die vermittelten Strategien und Methoden lassen sich jedoch problemlos auch auf Plattformen wie Facebook, TikTok oder YouTube Shorts übertragen.',
              marks: [],
            },
          ],
        },
      ],
    },
    {
      _key: 'ebook-faq-evergreen',
      question: 'Ist das E-Book nicht bald veraltet, weil sich Social Media ständig verändert?',
      answer: [
        {
          _type: 'block',
          _key: 'ebook-faq-evergreen-answer-1',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-evergreen-answer-1-text',
              text: 'Social Media entwickelt sich laufend weiter. Genau deshalb konzentriert sich das E-Book nicht auf kurzfristige Trends oder einzelne Algorithmus-Tricks, sondern auf bewährte Evergreen-Strategien. Diese grundlegenden Prinzipien funktionieren seit Jahren und werden auch künftig die Basis für nachhaltigen Reichweitenaufbau, eine starke Community und erfolgreiche Monetarisierung bilden.',
              marks: [],
            },
          ],
        },
        {
          _type: 'block',
          _key: 'ebook-faq-evergreen-answer-2',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-evergreen-answer-2-text',
              text: 'Ein wichtiger Bestandteil ist dabei die Erfolgsmessung: Durch regelmäßige Analysen erkennst du, was aktuell funktioniert, und kannst deine Strategie gezielt optimieren. Dadurch bleibt dein Vorgehen zeitgemäß und berücksichtigt automatisch Veränderungen der Plattformen, Algorithmen und des Nutzerverhaltens.',
              marks: [],
            },
          ],
        },
        {
          _type: 'block',
          _key: 'ebook-faq-evergreen-answer-3',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-evergreen-answer-3-text',
              text: 'Einzelne Funktionen können sich verändern – das strategische Grundgerüst bleibt jedoch relevant, anpassungsfähig und langfristig nutzbar.',
              marks: [],
            },
          ],
        },
      ],
    },
    {
      _key: 'ebook-faq-ads',
      question: 'Behandelt das E-Book auch bezahlte Werbeanzeigen?',
      answer: [
        {
          _type: 'block',
          _key: 'ebook-faq-ads-answer-1',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-ads-answer-1-text',
              text: 'Der Fokus des E-Books liegt bewusst auf dem organischen Social-Media-Aufbau. Du lernst, wie du dir mit nachhaltigen Strategien Reichweite, eine starke Community und Möglichkeiten zur Monetarisierung aufbaust – ohne von einem Werbebudget abhängig zu sein.',
              marks: [],
            },
          ],
        },
        {
          _type: 'block',
          _key: 'ebook-faq-ads-answer-2',
          style: 'normal',
          markDefs: [],
          children: [
            {
              _type: 'span',
              _key: 'ebook-faq-ads-answer-2-text',
              text: 'Bezahlte Werbeanzeigen werden im E-Book nicht direkt behandelt. Sie können bei Bedarf jedoch optimal auf diesem stabilen organischen Fundament aufbauen und deine bestehenden Maßnahmen gezielt verstärken.',
              marks: [],
            },
          ],
        },
      ],
    },
  ],
};
---

<div class="ebook">
  <section class="ebook-hero" aria-labelledby="ebook-hero-title" data-ebook-hero>
    <div class="ebook-hero__ambient is-one" aria-hidden="true"></div>
    <div class="ebook-hero__ambient is-two" aria-hidden="true"></div>
    <div class="container ebook-hero__grid">
      <div class="ebook-hero__content">
        <div data-ebook-heading>
          <p class="ebook-eyebrow">Social Media mit System</p>
          <h1 id="ebook-hero-title">
            Die Instagram
            <strong>Erfolgsformel</strong>
          </h1>
        </div>
        <div data-ebook-intro>
          <p class="ebook-hero__lead">Für mehr Reichweite, Follower &amp; Umsatz.</p>
          <p class="ebook-hero__copy">
            Deine kompakte Anleitung aus 8+ Jahren Praxis und der Erfahrung aus dem Aufbau von
            Accounts mit bis zu 200.000 Followern.
          </p>
        </div>
        <ul class="ebook-hero__facts" role="list" aria-label="E-Book-Umfang" data-ebook-facts>
          <li><strong>140</strong><span>Seiten</span></li>
          <li><strong>11 + 1</strong><span>Kapitel</span></li>
          <li><strong>2</strong><span>Boni</span></li>
        </ul>
        <div class="ebook-hero__action" data-ebook-buttons>
          <GlowButton label="Jetzt E-Book sichern" href={BUY_URL} />
          <p><span>Gesamtwert &gt;280 €</span><strong>aktuell für nur 27 €</strong></p>
        </div>
      </div>

      <div class="ebook-hero__visual" data-ebook-visual>
        <span class="ebook-hero__stamp" aria-hidden="true">8+ Jahre<br />Praxis</span>
        <Image
          src={heroImage}
          alt="Die Instagram Erfolgsformel mit E-Book, Smartphone und Beispielseiten"
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 991px) 92vw, 50vw"
          format="webp"
          quality={84}
          decoding="async"
          loading="eager"
          fetchpriority="auto"
        />
        <div class="ebook-hero-phone-screen" aria-hidden="true">
          <Image
            class="ebook-hero-phone-screen__image"
            src={heroPhoneInsightsImage}
            alt=""
            widths={[180, 300, 480]}
            sizes="(max-width: 991px) 16vw, 9vw"
            format="webp"
            quality={90}
          />
          <span class="ebook-hero-phone-screen__island"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="ebook-trust" aria-labelledby="ebook-press-title">
    <div class="container ebook-trust__head">
      <p id="ebook-press-title">Bekannt aus:</p>
    </div>
    <div class="ebook-trust__viewport">
      <div class="ebook-trust__track">
        {[0, 1, 2].map((copy) => (
          <div class="ebook-trust__sequence" aria-hidden={copy > 0 ? 'true' : undefined}>
            {pressItems.map((item) => (
              <span class="ebook-trust__logo">
                <Image
                  src={item.image}
                  alt={copy === 0 ? item.alt : ''}
                  widths={[160, 240, 320]}
                  sizes="160px"
                  format="webp"
                  quality={90}
                />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ebook-intro section" aria-labelledby="ebook-intro-title">
    <div class="container">
      <p class="ebook-kicker" data-anim="reveal">Wachstum beginnt mit Klarheit</p>
      <h2
        id="ebook-intro-title"
        data-anim="lines"
        data-delay="0.2"
        data-stagger="0.5"
      >
        Du brauchst keine 100.000 Follower, um über Social Media etwas zu bewegen.{' '}
        <span>Du brauchst eine klare Strategie.</span>
      </h2>
      <p class="ebook-intro__copy" data-anim="reveal" data-delay="0.16">
        Dieses E-Book verbindet echte Erfahrungen mit konkreten Schritten. So verstehst du, was
        hinter nachhaltigem Wachstum steckt und weißt endlich, was als Nächstes zu tun&nbsp;ist.
      </p>
    </div>
  </section>

  <section class="ebook-benefits section is-alt" aria-labelledby="ebook-benefits-title">
    <div class="container">
      <div class="ebook-section-head">
        <div>
          <p class="ebook-kicker" data-anim="reveal">Das erwartet dich</p>
          <h2 id="ebook-benefits-title" data-anim="reveal">Praxiswissen, das du direkt anwenden kannst.</h2>
        </div>
        <p data-anim="reveal">
          Kein Theorie-Marathon, sondern ein klarer Leitfaden für deinen Social-Media-Aufbau.
        </p>
      </div>
      <div class="ebook-benefits__grid">
        {benefits.map((benefit, index) => (
          <article
            class="ebook-benefit"
            data-anim="reveal"
            data-delay={String(index * 0.06)}
            data-ebook-mobile-benefit
          >
            <div class="ebook-benefit__top">
              <span class="ebook-benefit__icon" aria-hidden="true">
                {benefit.icon === 'insights' && (
                  <svg viewBox="0 0 48 48">
                    <rect x="5.75" y="6.75" width="36.5" height="34.5" rx="6" />
                    <path d="m11 33 8-8 6 4 11-13" />
                    <path d="M29.5 16H36v6.5" />
                    <path d="M11 14h8" />
                  </svg>
                )}
                {benefit.icon === 'strategy' && (
                  <svg viewBox="0 0 48 48">
                    <circle cx="34" cy="14" r="8" />
                    <circle cx="34" cy="14" r="3" />
                    <path d="M7 38c0-7 4-11 11-11h7c5 0 9-4 9-9" />
                    <circle cx="7" cy="38" r="2.5" />
                    <path d="M13 38h7" />
                  </svg>
                )}
                {benefit.icon === 'steps' && (
                  <svg viewBox="0 0 48 48">
                    <rect x="7" y="8" width="34" height="32" rx="6" />
                    <circle cx="15" cy="17" r="2.5" />
                    <circle cx="15" cy="31" r="2.5" />
                    <path d="M21 17h12M21 31h12M15 19.5v9" />
                    <path d="m29 23 2.5 2.5L37 20" />
                  </svg>
                )}
                {benefit.icon === 'learnings' && (
                  <svg viewBox="0 0 48 48">
                    <path d="M15 24.5a12 12 0 1 1 18 0c-2.5 2.2-3.7 4.1-3.7 6.5H18.7c0-2.4-1.2-4.3-3.7-6.5Z" />
                    <path d="M19 36h10M21.5 41h5" />
                    <path d="m20 19 3 3 5.5-6" />
                    <path d="M24 4V1M9.5 10 7 7.5M38.5 10 41 7.5" />
                  </svg>
                )}
              </span>
              <small>{benefit.number}</small>
            </div>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
      <div class="ebook-section-cta" data-anim="reveal" data-delay="0.12">
        <p>140 Seiten Praxiswissen – kompakt, verständlich und direkt umsetzbar.</p>
        <GlowButton label="Praxiswissen holen" href={BUY_URL} />
      </div>
    </div>
  </section>

  <section class="ebook-author section" aria-labelledby="ebook-author-title">
    <div class="container ebook-author__grid">
      <div class="ebook-author__media" data-anim="reveal">
        <Image
          src={authorImage}
          alt="Tristan Weithaler, Autor der Instagram Erfolgsformel"
          widths={[480, 720, 960]}
          sizes="(max-width: 991px) 90vw, 45vw"
          format="webp"
          quality={82}
        />
        <p>Social Media Business Coach<br /><strong>mit Herz &amp; Hands-on-Mentalität.</strong></p>
      </div>
      <div class="ebook-author__content">
        <p class="ebook-kicker" data-anim="reveal">Kurz zu mir, dem Autor</p>
        <h2 id="ebook-author-title" data-anim="reveal">Hi, ich bin Tristan.</h2>
        <div class="ebook-author__copy" data-anim="reveal" data-delay="0.08">
          <p>
            Ich komme aus einem kleinen Dorf in Südtirol und habe meinen sicheren Bürojob gegen
            kreative Freiheit getauscht – mit dem Ziel, eigene Visionen zu verwirklichen.
          </p>
          <p>
            Ohne Studienabschluss, aber mit viel Praxiserfahrung, Neugier und Leidenschaft habe
            ich mich zum Social-Media-Unternehmer entwickelt. Mit meinen Projekten und Marken
            habe ich über 200.000 Follower aufgebaut und mehr als 150 Millionen Views generiert.
          </p>
          <p>
            Die Strategien, Fehler und Learnings aus diesem Weg teile ich in meinem E-Book:
            praxisnah, ehrlich und direkt umsetzbar.
          </p>
        </div>
        <dl class="ebook-author__stats" data-anim="reveal" data-delay="0.14">
          <div><dt data-ebook-count="8" data-ebook-count-suffix="+" aria-label="mehr als 8">8+</dt><dd>Jahre Erfahrung</dd></div>
          <div><dt data-ebook-count="200" data-ebook-count-suffix="K+" aria-label="mehr als 200.000">200K+</dt><dd>Follower aufgebaut</dd></div>
          <div><dt data-ebook-count="150" data-ebook-count-suffix="M+" aria-label="mehr als 150 Millionen">150M+</dt><dd>organische Views</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="ebook-chapters section is-alt" aria-labelledby="ebook-chapters-title">
    <div class="container">
      <div class="ebook-chapters__head">
        <div>
          <p class="ebook-kicker" data-anim="reveal">E-Book-Inhalt</p>
          <h2 id="ebook-chapters-title" data-anim="reveal">Von deiner Vision bis zur Monetarisierung.</h2>
        </div>
        <p data-anim="reveal">
          11 aufeinander aufbauende Kapitel und ein Bonuskapitel führen dich Schritt für Schritt
          durch die wichtigsten Bereiche einer erfolgreichen Social-Media-Marke.
        </p>
      </div>
      <div class="ebook-chapters__layout">
        <div class="ebook-chapters__visual" data-anim="reveal">
          <div class="ebook-chapters__mockup">
            <Image
              class="ebook-chapters__base"
              src={chaptersImage}
              alt="Auswahl verschiedener Seiten aus der Instagram Erfolgsformel"
              widths={[420, 640, 843]}
              sizes="(max-width: 991px) 84vw, 36vw"
              format="webp"
              quality={82}
            />
            <div class="ebook-chapters-phone-screen" aria-hidden="true">
              <Image
                class="ebook-chapters-phone-screen__image"
                src={heroPhoneInsightsImage}
                alt=""
                widths={[120, 180, 260]}
                sizes="(max-width: 991px) 16vw, 7vw"
                format="webp"
                quality={90}
              />
              <span class="ebook-chapters-phone-screen__island"></span>
            </div>
          </div>
