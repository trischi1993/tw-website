---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaModal from '../components/CtaModal.astro';
import AioModal from '../components/AioModal.astro';
// In Produktion eine leere Komponente (No-op); nur der Vorschau-Build biegt
// diesen Subpath auf die Visual-Editing-Brücke um (History/Overlay/Refresh).
import PreviewExtras from '#preview-extras';
import { getSiteSettings } from '../lib/content';
import { HTML_LANG, UI } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Seiten-Slug als CSS-Haken auf <main> (z. B. seiten-spezifische Overrides). */
  route?: string;
  /** Hält Navigation und Legal-Links auf der separaten E-Book-Domain korrekt. */
  navigationContext?: 'main' | 'ebook';
}
const {
  title,
  description,
  image,
  canonical,
  noindex,
  type,
  jsonLd,
  route,
  navigationContext = 'main',
} = Astro.props;
const settings = await getSiteSettings();

// Organization auf jeder Seite: macht die Marke für Google/AI zur eindeutigen
// Entität. name/logo/url generisch aus den SiteSettings; sameAs nur, wenn echte
// Social-Profile gepflegt sind (sonst weglassen statt Platzhalter zu verlinken).
const sameAs = settings.social
  .map((s) => s.href)
  .filter((href) => /^https?:\/\//.test(href));
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteName,
  url: Astro.site?.href,
  logo: Astro.site ? new URL('/apple-touch-icon.png', Astro.site).href : undefined,
  ...(sameAs.length ? { sameAs } : {}),
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdArray = [orgJsonLd, ...pageJsonLd];
---
<!doctype html>
<html
  lang={HTML_LANG}
  class:list={{
    'is-ebook-route': route === 'e-book',
    'is-aio-route': route === 'all-in-one-coaching',
  }}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Pre-Paint-Motion-Flag: setzt html.has-motion VOR dem First Paint, damit
         die CSS-Ausgangszustände der Ladechoreo (global.css) schon im ersten
         Frame stehen und nichts aufblitzt (FOUC). Bei prefers-reduced-motion /
         ohne JS bleibt alles sichtbar. Failsafe: initialisiert das Motion-Bundle
         nicht (JS-Fehler), wird has-motion nach kurzer Frist entfernt → Inhalt
         sichtbar statt dauerhaft versteckt. */
      (function () {
        var el = document.documentElement;
        el.classList.add('has-js');
        var isMobileAioPage =
          el.classList.contains('is-aio-route') &&
          window.matchMedia('(max-width: 991px)').matches;
        /* Eine Scroll-Wiederherstellung ist eine Navigation. Die globale
           Smooth-Scroll-Regel wuerde deshalb den Weg von 0 zur gespeicherten
           Position sichtbar machen; auf der langen mobilen AIO-Seite fiel das
           besonders deutlich auf. Die Klasse steht schon vor dem ersten Paint
           und wird unmittelbar nach Safaris Restore-Signal wieder entfernt.
           Header, Menue und Motion bleiben vollstaendig unberuehrt. */
        var navigationEntry = performance.getEntriesByType('navigation')[0];
        var isScrollRestore =
          !!navigationEntry &&
          (navigationEntry.type === 'reload' || navigationEntry.type === 'back_forward');

        /* Safari wartet auf der langen AIO-Seite mit seiner nativen
           Reload-Wiederherstellung bis `load/pageshow`. Die Position des
           aktuellen Tabs wird deshalb synchron gespeichert und bei einem
           echten Reload derselben mobilen Geometrie noch vor dem ersten
           nutzbaren Paint selbst wiederhergestellt. Andere Seiten,
           Erstaufrufe, Reloads am Seitenanfang und Back/Forward bleiben beim
           Browser-Standard. */
        if (isMobileAioPage) {
          var aioScrollKey = 'tw:aio-scroll-position:v1';
          var aioLocationKey = window.location.pathname + window.location.search;
          var aioOrientation = window.innerWidth > window.innerHeight ? 'landscape' : 'portrait';
          var aioRestoreTarget = 0;

          if (navigationEntry && navigationEntry.type === 'reload' && !window.location.hash) {
            try {
              var savedAioScroll = JSON.parse(window.sessionStorage.getItem(aioScrollKey) || 'null');
              var savedAioY = Number(savedAioScroll && savedAioScroll.y);
              var savedAioWidth = Number(savedAioScroll && savedAioScroll.width);
              if (
                savedAioScroll &&
                savedAioScroll.location === aioLocationKey &&
                savedAioScroll.orientation === aioOrientation &&
                Number.isFinite(savedAioY) &&
                savedAioY > 4 &&
                Number.isFinite(savedAioWidth) &&
                Math.abs(savedAioWidth - window.innerWidth) <= 4
              ) {
                aioRestoreTarget = Math.max(0, Math.round(savedAioY));
              }
            } catch (_error) {
              aioRestoreTarget = 0;
            }
          }

          if (aioRestoreTarget > 0) {
            if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
            el.dataset.aioRestoreY = String(aioRestoreTarget);
            el.style.setProperty(
              '--aio-restore-min-height',
              Math.ceil(aioRestoreTarget + window.innerHeight) + 'px'
            );
            el.classList.add('is-aio-scroll-restore-pending');

            /* Erst nach `pageshow` darf Safari für spätere History-Navigationen
               wieder selbst zuständig sein. Ein früheres `auto` würde seinen
               verspäteten zweiten Restore erneut auslösen. */
            var restoreAioHistoryAuto = function () {
              if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
            };
            window.addEventListener(
              'pageshow',
              function () {
                requestAnimationFrame(function () {
                  restoreAioHistoryAuto();
                  window.removeEventListener('beforeunload', restoreAioHistoryAuto);
                });
              },
              { once: true }
            );
            /* Verlaesst der Nutzer die Seite ueber das sofort bedienbare Menue
               noch vor dem spaeten AIO-pageshow, muss der aktuelle History-
               Eintrag ebenfalls wieder an Safari uebergeben werden. */
            window.addEventListener(
              'pagehide',
              restoreAioHistoryAuto,
              { once: true }
            );
            /* WebKit friert den Restoration-Mode fuer den verlassenen
               History-Eintrag bereits vor `pagehide` ein. Der Listener lebt
               deshalb nur bis pageshow und greift ausschliesslich, wenn der
               Nutzer die noch ladende Seite vorher wieder verlaesst. */
            window.addEventListener('beforeunload', restoreAioHistoryAuto, { once: true });

            /* Failsafe nur für einen unerwarteten Fehler im Restore-/Startmodul.
               Er hängt bewusst am fertig geparsten Dokument statt an einer
               willkürlichen Zeitgrenze, die auf langsamen Verbindungen zu früh
               ablaufen könnte. */
            document.addEventListener(
              'DOMContentLoaded',
              function () {
                window.setTimeout(function () {
                  if (!el.classList.contains('is-aio-scroll-restore-pending')) return;
                  window.scrollTo(0, aioRestoreTarget);
                  /* Falls eines der beiden kleinen AIO-Startmodule wider
                     Erwarten nicht geladen hat, darf weder die Blende noch ein
                     CSS-Ausgangszustand stehen bleiben. */
                  el.classList.remove(
                    'is-aio-scroll-restore-pending',
                    'has-motion',
                    'aio-mobile-motion'
                  );
                  el.style.removeProperty('--aio-restore-min-height');
                  delete el.dataset.aioRestoreY;
                  window.dispatchEvent(new Event('aio:scroll-restored'));
                }, 1500);
              },
              { once: true }
            );
          }

          var aioSaverStarted = false;
          var aioSaveTimer;
          var saveAioScroll = function () {
            if (aioSaveTimer) window.clearTimeout(aioSaveTimer);
            aioSaveTimer = undefined;
            try {
              window.sessionStorage.setItem(
                aioScrollKey,
                JSON.stringify({
                  location: window.location.pathname + window.location.search,
                  y: Math.max(0, window.scrollY),
                  width: window.innerWidth,
                  orientation:
                    window.innerWidth > window.innerHeight ? 'landscape' : 'portrait',
                })
              );
            } catch (_error) {
              /* SessionStorage kann im privaten Modus gesperrt sein. Dann
                 bleibt Safaris native Wiederherstellung als Fallback aktiv. */
            }
          };
          var queueAioScrollSave = function () {
            if (aioSaveTimer) window.clearTimeout(aioSaveTimer);
            aioSaveTimer = window.setTimeout(saveAioScroll, 120);
          };
          var startAioScrollSaver = function () {
            if (aioSaverStarted) return;
            aioSaverStarted = true;
            window.addEventListener('scroll', queueAioScrollSave, { passive: true });
            window.addEventListener('resize', queueAioScrollSave, { passive: true });
            window.addEventListener('pagehide', saveAioScroll);
            document.addEventListener('visibilitychange', function () {
              if (document.visibilityState === 'hidden') saveAioScroll();
            });
          };

          /* Das initiale y=0 des neuen Dokuments darf den noch ausstehenden
             Zielwert nicht überschreiben. */
          if (aioRestoreTarget > 0) {
            window.addEventListener('aio:scroll-restored', startAioScrollSaver, { once: true });
          } else {
            startAioScrollSaver();
            /* Ein echter neuer Aufruf beginnt sicher oben. Diesen Wert sofort
               festhalten, damit ein sehr schneller Reload nicht noch eine
               tiefe Position aus einem frueheren AIO-Aufruf desselben Tabs
               uebernimmt. Back/Forward und Reload schreiben vor Safaris
               eigener Wiederherstellung bewusst nichts. */
            if (!navigationEntry || navigationEntry.type === 'navigate') saveAioScroll();
          }
        }

        if (isScrollRestore) {
          el.classList.add('is-scroll-restoring');
          var released = false;
          var pageShown = false;
          var restoreScrollSeen = false;
          var safetyTimer;
          var releaseScrollRestore = function () {
            if (released) return;
            released = true;
            window.removeEventListener('scroll', onRestoredScroll);
            if (safetyTimer) window.clearTimeout(safetyTimer);
            el.classList.remove('is-scroll-restoring');
          };
          var releaseAfterPaint = function () {
            requestAnimationFrame(function () {
              requestAnimationFrame(releaseScrollRestore);
            });
          };
          var armRestoreFallback = function (delay) {
            if (safetyTimer) window.clearTimeout(safetyTimer);
            safetyTimer = window.setTimeout(releaseScrollRestore, delay);
          };
          var onRestoredScroll = function () {
            if (Math.abs(window.scrollY) <= 1) return;
            restoreScrollSeen = true;
            if (pageShown) releaseAfterPaint();
          };
          window.addEventListener('scroll', onRestoredScroll, { passive: true });
          window.addEventListener(
            'pageshow',
            function () {
              pageShown = true;
              if (restoreScrollSeen || Math.abs(window.scrollY) > 1) releaseAfterPaint();
              else armRestoreFallback(250);
            },
            { once: true }
          );
          /* Der Fallback beginnt erst NACH dem Lifecycle-Signal. Der fruehere
             absolute 3-Sekunden-Timer lief auf der AIO-Seite noch vor Safaris
             spaetem `load/pageshow` ab und aktivierte Smooth-Scroll mitten im
             nativen Restore. */
          window.addEventListener(
            'load',
            function () {
              if (!pageShown) armRestoreFallback(1000);
            },
            { once: true }
          );
          armRestoreFallback(15000);
        }
        /* Ein Fragment bei einem neuen Seitenaufruf darf nicht den globalen
           Smooth-Scroll von ganz oben starten: Während dieses langen Scrolls
           ändern Widgets/Motion noch das Layout und die spätere
           Ankerkorrektur wird vom laufenden Browser-Scroll überschrieben.
           Gleichseitige Anchor-Klicks sind davon nicht betroffen und bleiben
           nach der Korrektur weiterhin weich. */
        if (window.location.hash) {
          /* Das Fragment bleibt bewusst in der URL und sein Ziel bleibt im
             Layout: So kann der Browser seine einmalige native Positionierung
             noch während des Ladens vollständig abschließen. Der Wert wird
             zusätzlich für die gezielt verzögerten Reveals gespeichert. */
          el.dataset.initialHash = window.location.hash;
          el.classList.add('has-initial-hash');
          window.addEventListener('load', function () {
            /* Failsafe, falls das Hash-Navigations-Bundle nicht lädt. */
            setTimeout(function () {
              delete el.dataset.initialHash;
              el.classList.remove(
                'has-initial-hash',
                'initial-hash-ready'
              );
            }, 3000);
          });
        }
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        el.classList.add('has-motion');
        /* Auf der mobilen E-Book- und AIO-Seite läuft nur die sichtbare Load-
           Choreo in einem kleinen browsernativen Modul. Bewegung und Timings
           bleiben unverändert, ohne dass das große seitenweite Motion-Bundle
           während der ersten Frames den Menü-Tap ausbremsen kann. */
        var useMobileEbookMotion =
          el.classList.contains('is-ebook-route') &&
          window.matchMedia('(max-width: 767px)').matches;
        var useMobileAioMotion =
          isMobileAioPage;
        if (useMobileEbookMotion || useMobileAioMotion) {
          var mobileMotionClass = useMobileEbookMotion
            ? 'ebook-mobile-motion'
            : 'aio-mobile-motion';
          el.classList.add(mobileMotionClass);
          window.addEventListener('load', function () {
            setTimeout(function () {
              if (!el.classList.contains('motion-ready')) {
                el.classList.remove('has-motion', mobileMotionClass);
              }
            }, 1500);
          });
          return;
        }
        window.addEventListener('load', function () {
          setTimeout(function () {
            if (!el.classList.contains('motion-ready')) el.classList.remove('has-motion');
          }, 1500);
        });
      })();
    </script>
    <meta name="theme-color" content="#0C0C0C" />
    <meta name="color-scheme" content="dark" />
    {/* Verbindung zum Sanity-Bild-CDN vorwaermen (DNS+TCP+TLS), damit das
        Hero-LCP-Bild ohne Handshake-Verzoegerung laedt. Ohne crossorigin, weil
        die <img>-Requests nicht als CORS laufen - sonst waere die vorgewaermte
        Verbindung nicht wiederverwendbar. */}
    <link rel="preconnect" href="https://cdn.sanity.io" />
    {
      route === 'all-in-one-coaching' && (
        <link rel="preconnect" href="https://tristan-website.b-cdn.net" />
      )
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/poppins-light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      type={type}
      siteName={settings.siteName}
    />
    {
      jsonLdArray.map((data) => (
        // `<` maskieren, damit ein CMS-String mit „</script>" das Script nicht
        // vorzeitig schließt (JSON.stringify escaped `<` nicht). `<` bleibt
        // gültiges JSON.
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
        />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <script is:inline>
      /* Die im <head> reservierte Mindesthoehe macht die gespeicherte
         AIO-Position schon beim Oeffnen des Body scrollbar. Dadurch kann
         Safari noch vor Header und Seiteninhalt dorthin springen. */
      (function () {
        var el = document.documentElement;
        if (!el.classList.contains('is-aio-scroll-restore-pending')) return;
        var target = Number(el.dataset.aioRestoreY);
        if (Number.isFinite(target) && target > 0) window.scrollTo(0, target);
      })();
    </script>
    <a href="#main" class="skip-link">{UI.skipToContent}</a>
    <Header context={navigationContext} />
    {/* tabindex=-1: macht das Sprung-Ziel per Skip-Link fokussierbar (sonst
        setzen manche Browser/AT den Fokus nicht zuverlässig auf <main>). */}
    <main id="main" tabindex="-1" data-route={route || undefined}>
      <slot />
    </main>
    <Footer context={navigationContext} />
    {/* Direkte Body-Kinder: die inert-Logik der Modals erwartet Top-Level. */}
    <CtaModal />
    <AioModal />
    <script is:inline>
      /* Zu diesem Zeitpunkt ist das komplette SSR-Layout geparst. Die
         Position wird vor den Modul-Imports final korrigiert. Die Blende bleibt
         noch bis zur Initialisierung der zwei kleinen AIO-Startmodule aktiv,
         damit ein tief sichtbarer Reveal-Text keinen einzelnen statischen
         Zwischenframe zeichnet. */
      (function () {
        var el = document.documentElement;
        if (!el.classList.contains('is-aio-scroll-restore-pending')) return;
        var savedTarget = Number(el.dataset.aioRestoreY);
        if (!Number.isFinite(savedTarget) || savedTarget <= 0) return;

        var finishPositioning = function () {
          el.dataset.aioRestorePositioned = '';
          window.dispatchEvent(new Event('aio:scroll-positioned'));
        };
        var restore = function () {
          var maximum = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
          var target = Math.min(savedTarget, maximum);
          window.scrollTo(0, target);
          return Math.abs(window.scrollY - target) <= 2;
        };

        if (restore()) {
          finishPositioning();
          return;
        }
        requestAnimationFrame(function () {
          restore();
          requestAnimationFrame(function () {
            restore();
            finishPositioning();
          });
        });
      })();
    </script>
    <script>
      // Interaktive Widgets (FAQ, Tabs, Read-More, Load-More, Video-Controls)
      // laufen auf jeder Seite. Das GSAP-Motion-Bundle ebenso: Footer-Reveal,
      // Underline-Wipes und der Glow-CTA im Header animieren auf jeder Seite
      // (IX2 a-87/a-91/a-141); eine Hook-Bedingung wäre immer wahr.
      const isMobileEbook = document.documentElement.classList.contains('ebook-mobile-motion');
      const isMobileAio = document.documentElement.classList.contains('aio-mobile-motion');
      const afterMobileHero = (load: () => Promise<unknown>): Promise<unknown> =>
        new Promise((resolve, reject) => {
          const remaining = Math.max(0, 2200 - performance.now());
          window.setTimeout(() => {
            const run = () => {
              const openedInTheMeantime = document.querySelector('[data-nav-toggle]')
                ?.getAttribute('aria-expanded') === 'true';
              if (openedInTheMeantime) {
                window.setTimeout(run, 250);
                return;
              }
              void load().then(resolve, reject);
            };
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(run, { timeout: 1000 });
            } else {
              run();
            }
          }, remaining);
        });
      const widgetsReady = isMobileEbook
        ? afterMobileHero(() => import('../scripts/widgets.ts'))
        : isMobileAio
          ? afterMobileHero(() => import('../scripts/widgets.ts'))
          : import('../scripts/widgets.ts');
      // Die AIO-Ergebnis-Slider liegen viele Viewports unterhalb des Einstiegs.
      // Auf Mobilgeraeten duerfen ihre Layout-Messungen, ResizeObserver und
      // Bild-Preloads deshalb nicht mit dem allerersten Menue-Tap konkurrieren.
      // Nach der sichtbaren Startchoreografie werden sie einmalig in einer
      // Browser-Idle-Phase initialisiert. Scroll-/Touch-Ereignisse verschieben
      // diesen Zeitpunkt nicht mehr unbestimmt nach hinten.
      const aioResultsReady = isMobileAio
        ? afterMobileHero(() => import('../scripts/aio-results-interactions.ts'))
        : import('../scripts/aio-results-interactions.ts');
      const aioMobileLoadReady = isMobileAio
        ? import('../scripts/aio-mobile-load.ts')
        : Promise.resolve();
      const aioMobileRevealsReady = isMobileAio
        ? import('../scripts/aio-mobile-reveals.ts')
        : Promise.resolve();
      const aioScrollPositionReady = document.documentElement.classList.contains(
        'is-aio-scroll-restore-pending',
      ) && !document.documentElement.hasAttribute('data-aio-restore-positioned')
        ? new Promise<void>((resolve) => {
            window.addEventListener('aio:scroll-positioned', () => resolve(), { once: true });
          })
        : Promise.resolve();
      // Fragmentziele erst nach dem Motion-Setup nachjustieren: ScrollTrigger
      // und Widgets verändern vor dem Ziel noch das Layout. Erst wenn beide
      // Initialisierungen abgeschlossen sind, wird der Anker final gesetzt.
      const motionReady = isMobileEbook
        ? Promise.all([
            import('../scripts/ebook-mobile-load.ts'),
            // Nach der mobilen Header-Choreografie das normale Motion-Bundle
            // nachladen. ebook-load erkennt diesen Sonderpfad und überspringt
            // ausschließlich den bereits abgespielten Header; alle Scroll-
            // Reveals und Animationen darunter bleiben identisch erhalten.
            afterMobileHero(() => import('../scripts/motion.ts')),
          ])
        : isMobileAio
          ? Promise.all([
              aioMobileLoadReady,
              // Scroll-Reveals muessen schon beim ersten direkten Wischen
              // bereitstehen. Nur die sichtbaren Entrance-Module laden hier;
              // das grosse ScrollTrigger-Paket bleibt bis zur Ruhephase
              // zurueckgestellt und initialisiert diese Elemente dank
              // idempotenter Module nicht ein zweites Mal.
              aioMobileRevealsReady,
              // Wie bei der stabilen E-Book-Seite folgt das Gesamtpaket einmalig
              // nach der sichtbaren Startchoreografie. Es wird nicht mehr durch
              // Scroll-/Touch-Ereignisse immer wieder nach hinten verschoben.
              afterMobileHero(() => import('../scripts/motion.ts')),
            ])
        : import('../scripts/motion.ts');

      /* Beim manuellen Deep-Reload wird die deckende Ebene erst entfernt,
         nachdem Header/Hero und die direkt sichtbaren Scroll-Reveals ihre
         echten Anfangszustaende gesetzt haben. Die Import-Promises loesen nach
         der synchronen Modul-Initialisierung, aber noch vor dem naechsten
         Paint; dadurch bleibt die originale Animation vollstaendig sichtbar. */
      const aioRestorePending = document.documentElement.classList.contains(
        'is-aio-scroll-restore-pending',
      );
      const finishAioScrollRestore = (disableMotion = false) => {
        const root = document.documentElement;
        const target = Number(root.dataset.aioRestoreY);
        if (Number.isFinite(target) && target > 0) {
          const maximum = Math.max(0, root.scrollHeight - window.innerHeight);
          window.scrollTo(0, Math.min(target, maximum));
        }
        root.classList.remove('is-aio-scroll-restore-pending');
        if (disableMotion) root.classList.remove('has-motion', 'aio-mobile-motion');
        root.style.removeProperty('--aio-restore-min-height');
        delete root.dataset.aioRestoreY;
        delete root.dataset.aioRestorePositioned;
        window.dispatchEvent(new Event('aio:scroll-restored'));
      };

      if (aioRestorePending) {
        if (isMobileAio) {
          Promise.all([
            aioMobileLoadReady,
            aioMobileRevealsReady,
            aioScrollPositionReady,
          ]).then(
            () => finishAioScrollRestore(),
            () => finishAioScrollRestore(true),
          );
        } else {
          // prefers-reduced-motion besitzt absichtlich keine AIO-Startmodule.
          // Dort reicht die fertige Scrollposition; die Blende darf sofort weg.
          void aioScrollPositionReady.then(() => finishAioScrollRestore());
        }
      }
      const homeProofCarouselReady = document.querySelector('[data-home-proof-carousel]')
        ? import('../scripts/home-results-carousel.ts')
        : Promise.resolve();
      // Die Kundenstimmen stehen schon serverseitig in ihrer finalen kurzen
      // Geometrie. Das winzige native Modul aktiviert lediglich „weiterlesen"
      // und braucht weder GSAP noch die verzögerte Widget-Initialisierung.
      const readMoreReady = import('../scripts/read-more.ts');
      Promise.allSettled([
        widgetsReady,
        aioResultsReady,
        motionReady,
        homeProofCarouselReady,
        readMoreReady,
      ]).then(() =>
        import('../scripts/hash-navigation.ts')
      );
    </script>
    <PreviewExtras />
  </body>
</html>
