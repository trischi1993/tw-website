---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaModal from '../components/CtaModal.astro';
import AioModal from '../components/AioModal.astro';
// In Produktion eine leere Komponente (No-op); nur der Vorschau-Build biegt
// diesen Subpath auf die Visual-Editing-Brücke um (History/Overlay/Refresh).
import PreviewExtras from '#preview-extras';
import { getSiteSettings } from '../lib/content';
import { HTML_LANG, UI } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Seiten-Slug als CSS-Haken auf <main> (z. B. seiten-spezifische Overrides). */
  route?: string;
  /** Hält Navigation und Legal-Links auf der separaten E-Book-Domain korrekt. */
  navigationContext?: 'main' | 'ebook';
}
const {
  title,
  description,
  image,
  canonical,
  noindex,
  type,
  jsonLd,
  route,
  navigationContext = 'main',
} = Astro.props;
const settings = await getSiteSettings();

// Organization auf jeder Seite: macht die Marke für Google/AI zur eindeutigen
// Entität. name/logo/url generisch aus den SiteSettings; sameAs nur, wenn echte
// Social-Profile gepflegt sind (sonst weglassen statt Platzhalter zu verlinken).
const sameAs = settings.social
  .map((s) => s.href)
  .filter((href) => /^https?:\/\//.test(href));
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteName,
  url: Astro.site?.href,
  logo: Astro.site ? new URL('/apple-touch-icon.png', Astro.site).href : undefined,
  ...(sameAs.length ? { sameAs } : {}),
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdArray = [orgJsonLd, ...pageJsonLd];
---
<!doctype html>
<html
  lang={HTML_LANG}
  class:list={{
    'is-ebook-route': route === 'e-book',
    'is-aio-route': route === 'all-in-one-coaching',
  }}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Pre-Paint-Motion-Flag: setzt html.has-motion VOR dem First Paint, damit
         die CSS-Ausgangszustände der Ladechoreo (global.css) schon im ersten
         Frame stehen und nichts aufblitzt (FOUC). Bei prefers-reduced-motion /
         ohne JS bleibt alles sichtbar. Failsafe: initialisiert das Motion-Bundle
         nicht (JS-Fehler), wird has-motion nach kurzer Frist entfernt → Inhalt
         sichtbar statt dauerhaft versteckt. */
      (function () {
        var el = document.documentElement;
        /* iOS Safari stellt die Scrollposition bei einem Reload selbst wieder
           her. Auf der sehr langen AIO-Seite darf das Motion-Bundle diesen
           Vorgang nicht durch seine erste ScrollTrigger-Vermessung
           unterbrechen. Die Markierung wird weiter unten ausschließlich für
           diesen Reload-Fall ausgewertet; normale Seitenwechsel und andere
           Seiten behalten ihr bisheriges Timing. */
        var navigationEntry = performance.getEntriesByType('navigation')[0];
        var isReload = navigationEntry && navigationEntry.type === 'reload';
        var isTouchDevice =
          navigator.maxTouchPoints > 0 ||
          window.matchMedia('(hover: none) and (pointer: coarse)').matches;
        var isMobileAioViewport =
          el.classList.contains('is-aio-route') &&
          window.matchMedia('(max-width: 991px)').matches;
        var shouldDeferAioReload =
          isMobileAioViewport &&
          isReload &&
          isTouchDevice;
        if (shouldDeferAioReload) {
          if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
        }

        if (isMobileAioViewport) {
          /* Die Reload-Maske schuetzt nur Safaris automatische
             Positionswiederherstellung. Sobald der Nutzer selbst beruehrt oder
             scrollt, muss der echte Seiteninhalt sofort uebernehmen. Gleichzeitig
             wird eine noch ausstehende Browser-Wiederherstellung angehalten,
             damit sie den bereits begonnenen Nutzer-Scroll nicht auf eine alte
             Position zuruecksetzt. Nach der Motion-Initialisierung wird wieder
             auf `auto` umgestellt. */
          var releaseAioReloadForInput = function () {
            if (
              document.readyState !== 'complete' &&
              'scrollRestoration' in history
            ) {
              history.scrollRestoration = 'manual';
            }
            el.classList.remove('is-aio-mobile-reload');
          };
          window.addEventListener('touchstart', releaseAioReloadForInput, {
            once: true,
            passive: true,
            capture: true,
          });
          window.addEventListener('pointerdown', releaseAioReloadForInput, {
            once: true,
            passive: true,
            capture: true,
          });
          window.addEventListener('wheel', releaseAioReloadForInput, {
            once: true,
            passive: true,
            capture: true,
          });
        }
        /* Ein Fragment bei einem neuen Seitenaufruf darf nicht den globalen
           Smooth-Scroll von ganz oben starten: Während dieses langen Scrolls
           ändern Widgets/Motion noch das Layout und die spätere
           Ankerkorrektur wird vom laufenden Browser-Scroll überschrieben.
           Gleichseitige Anchor-Klicks sind davon nicht betroffen und bleiben
           nach der Korrektur weiterhin weich. */
        if (window.location.hash) {
          /* Das Fragment bleibt bewusst in der URL und sein Ziel bleibt im
             Layout: So kann der Browser seine einmalige native Positionierung
             noch während des Ladens vollständig abschließen. Der Wert wird
             zusätzlich für die gezielt verzögerten Reveals gespeichert. */
          el.dataset.initialHash = window.location.hash;
          el.classList.add('has-initial-hash');
          window.addEventListener('load', function () {
            /* Failsafe, falls das Hash-Navigations-Bundle nicht lädt. */
            setTimeout(function () {
              delete el.dataset.initialHash;
              el.classList.remove(
                'has-initial-hash',
                'initial-hash-ready'
              );
            }, 3000);
          });
        }
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (shouldDeferAioReload) el.classList.add('is-aio-mobile-reload');
        el.classList.add('has-motion');
        /* Auf der mobilen E-Book- und AIO-Seite läuft nur die sichtbare Load-
           Choreo in einem kleinen browsernativen Modul. Bewegung und Timings
           bleiben unverändert, ohne dass das große seitenweite Motion-Bundle
           während der ersten Frames den Menü-Tap ausbremsen kann. */
        var useMobileEbookMotion =
          el.classList.contains('is-ebook-route') &&
          window.matchMedia('(max-width: 767px)').matches;
        var useMobileAioMotion =
          el.classList.contains('is-aio-route') &&
          window.matchMedia('(max-width: 991px)').matches;
        if (useMobileEbookMotion || useMobileAioMotion) {
          var mobileMotionClass = useMobileEbookMotion
            ? 'ebook-mobile-motion'
            : 'aio-mobile-motion';
          el.classList.add(mobileMotionClass);
          window.addEventListener('load', function () {
            setTimeout(function () {
              if (!el.classList.contains('motion-ready')) {
                el.classList.remove('has-motion', mobileMotionClass);
                el.classList.remove('is-aio-mobile-reload');
              }
            }, 1500);
          });
          return;
        }
        window.addEventListener('load', function () {
          setTimeout(function () {
            if (!el.classList.contains('motion-ready')) el.classList.remove('has-motion');
            /* Auch bei einem unerwarteten Bundle-Fehler darf die AIO-Seite
               nicht unsichtbar bleiben. */
            el.classList.remove('is-aio-mobile-reload');
          }, 1500);
        });
      })();
    </script>
    <style is:inline>
      /* Verhindert ausschließlich beim mobilen AIO-Reload, dass Safari den
         Seiteninhalt vor seiner nativen Positionswiederherstellung zeichnet.
         Kopfzeile und Fullscreen-Menü bleiben davon bewusst ausgenommen: Sie
         müssen bereits während dieser Phase echt sichtbar und anklickbar sein,
         statt nur als nicht interaktive Safari-Altschicht stehen zu bleiben. */
      html.is-aio-mobile-reload body > :not(.navbar):not(.menu) {
        visibility: hidden;
      }
    </style>
    <meta name="theme-color" content="#0C0C0C" />
    <meta name="color-scheme" content="dark" />
    {/* Verbindung zum Sanity-Bild-CDN vorwaermen (DNS+TCP+TLS), damit das
        Hero-LCP-Bild ohne Handshake-Verzoegerung laedt. Ohne crossorigin, weil
        die <img>-Requests nicht als CORS laufen - sonst waere die vorgewaermte
        Verbindung nicht wiederverwendbar. */}
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/poppins-light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      type={type}
      siteName={settings.siteName}
    />
    {
      jsonLdArray.map((data) => (
        // `<` maskieren, damit ein CMS-String mit „</script>" das Script nicht
        // vorzeitig schließt (JSON.stringify escaped `<` nicht). `<` bleibt
        // gültiges JSON.
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
        />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{UI.skipToContent}</a>
    <Header context={navigationContext} />
    {/* tabindex=-1: macht das Sprung-Ziel per Skip-Link fokussierbar (sonst
        setzen manche Browser/AT den Fokus nicht zuverlässig auf <main>). */}
    <main id="main" tabindex="-1" data-route={route || undefined}>
      <slot />
    </main>
    <Footer context={navigationContext} />
    {/* Direkte Body-Kinder: die inert-Logik der Modals erwartet Top-Level. */}
    <CtaModal />
    <AioModal />
    <script>
      // Interaktive Widgets (FAQ, Tabs, Read-More, Load-More, Video-Controls)
      // laufen auf jeder Seite. Das GSAP-Motion-Bundle ebenso: Footer-Reveal,
      // Underline-Wipes und der Glow-CTA im Header animieren auf jeder Seite
      // (IX2 a-87/a-91/a-141); eine Hook-Bedingung wäre immer wahr.
      const isMobileEbook = document.documentElement.classList.contains('ebook-mobile-motion');
      const isMobileAio = document.documentElement.classList.contains('aio-mobile-motion');
      const isAioMobileReload = document.documentElement.classList.contains(
        'is-aio-mobile-reload',
      );
      const afterMobileHero = (load: () => Promise<unknown>): Promise<unknown> =>
        new Promise((resolve, reject) => {
          const remaining = Math.max(0, 2200 - performance.now());
          window.setTimeout(() => {
            const run = () => {
              const openedInTheMeantime = document.querySelector('[data-nav-toggle]')
                ?.getAttribute('aria-expanded') === 'true';
              if (openedInTheMeantime) {
                window.setTimeout(runWhenHeaderIsFree, 250);
                return;
              }
              void load().then(resolve, reject);
            };
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(run, { timeout: 1000 });
            } else {
              run();
            }
          }, remaining);
        });
      const afterAioScrollIdle = (
        load: () => Promise<unknown>,
        initialDelay: number,
        waitForPageShow = false,
      ): Promise<unknown> =>
        new Promise((resolve, reject) => {
          const SCROLL_IDLE_MS = 260;
          let started = false;
          let touchActive = false;
          let lastScrollAt = performance.now();
          let earliestStartAt = lastScrollAt + initialDelay;
          let pageShown = !waitForPageShow || document.readyState === 'complete';
          let retryTimer: number | undefined;
          let pageShowFallback: number | undefined;

          const cleanup = () => {
            if (retryTimer !== undefined) window.clearTimeout(retryTimer);
            if (pageShowFallback !== undefined) window.clearTimeout(pageShowFallback);
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('touchstart', onTouchStart);
            window.removeEventListener('touchend', onTouchEnd);
            window.removeEventListener('touchcancel', onTouchEnd);
            window.removeEventListener('pointerdown', onPointerDown);
            window.removeEventListener('wheel', onScroll);
            window.removeEventListener('pageshow', onPageShow);
          };

          const schedule = (minimumDelay = 0) => {
            if (started) return;
            if (retryTimer !== undefined) window.clearTimeout(retryTimer);
            const now = performance.now();
            const quietWait = Math.max(0, SCROLL_IDLE_MS - (now - lastScrollAt));
            const phaseWait = Math.max(0, earliestStartAt - now);
            retryTimer = window.setTimeout(attempt, Math.max(minimumDelay, quietWait, phaseWait));
          };

          const run = () => {
            if (started) return;
            const menuIsOpen = document.querySelector('[data-nav-toggle]')
              ?.getAttribute('aria-expanded') === 'true';
            const scrollIsQuiet = performance.now() - lastScrollAt >= SCROLL_IDLE_MS;
            if (!pageShown || touchActive || menuIsOpen || !scrollIsQuiet) {
              schedule(menuIsOpen ? 250 : 60);
              return;
            }

            started = true;
            cleanup();
            const finish = () => {
              if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
            };
            void load().then(
              (value) => {
                finish();
                resolve(value);
              },
              (error) => {
                finish();
                reject(error);
              },
            );
          };

          const attempt = () => {
            if (started) return;
            const now = performance.now();
            if (!pageShown || touchActive || now < earliestStartAt) {
              schedule(60);
              return;
            }
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(run, { timeout: 1000 });
            } else {
              run();
            }
          };

          const onScroll = () => {
            lastScrollAt = performance.now();
            schedule();
          };
          const onTouchStart = () => {
            touchActive = true;
            lastScrollAt = performance.now();
            if (retryTimer !== undefined) window.clearTimeout(retryTimer);
          };
          const onTouchEnd = () => {
            touchActive = false;
            lastScrollAt = performance.now();
            schedule();
          };
          const onPointerDown = (event: PointerEvent) => {
            if (event.pointerType === 'touch') return;
            lastScrollAt = performance.now();
            schedule();
          };
          const onPageShow = () => {
            if (pageShown) return;
            pageShown = true;
            if (pageShowFallback !== undefined) {
              window.clearTimeout(pageShowFallback);
              pageShowFallback = undefined;
            }
            earliestStartAt = Math.max(earliestStartAt, performance.now() + initialDelay);
            lastScrollAt = performance.now();
            schedule();
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('touchstart', onTouchStart, { passive: true });
          window.addEventListener('touchend', onTouchEnd, { passive: true });
          window.addEventListener('touchcancel', onTouchEnd, { passive: true });
          window.addEventListener('pointerdown', onPointerDown, { passive: true });
          window.addEventListener('wheel', onScroll, { passive: true });

          if (waitForPageShow && !pageShown) {
            window.addEventListener('pageshow', onPageShow, { once: true });
            // Sicherheitsnetz fuer aeltere WebKit-Versionen: `pageshow` ist
            // Standard, darf den Inhalt aber bei einem Browserfehler nicht
            // dauerhaft blockieren.
            pageShowFallback = window.setTimeout(onPageShow, 1250);
          }
          schedule();
        });

      const afterAioInitialPhase = (load: () => Promise<unknown>): Promise<unknown> =>
        // Relativ zu diesem Modul warten: Die lange AIO-Seite kann auf einem
        // Handy erst nach >2,2 s fertig geparst sein. Danach startet die schwere
        // Vermessung nur in einer echten Scroll-Ruhephase.
        afterAioScrollIdle(load, 1900);

      const afterNativeScrollRestore = async (
        load: () => Promise<unknown>,
      ): Promise<unknown> => {
        try {
          // Weder Safaris automatische Wiederherstellung noch der erste echte
          // Nutzer-Wisch darf durch die ScrollTrigger-Initialisierung laufen.
          return await afterAioScrollIdle(load, 250, true);
        } finally {
          if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
          document.documentElement.classList.remove('is-aio-mobile-reload');
        }
      };
      const widgetsReady = isMobileEbook
        ? afterMobileHero(() => import('../scripts/widgets.ts'))
        : import('../scripts/widgets.ts');
      // Die AIO-Ergebnis-Slider sind funktionale Bedienelemente. Sie laden
      // bewusst als kleines natives Modul unabhaengig vom grossen GSAP-Bundle,
      // damit sie auf iOS/LAN auch bei einem Fehler in einer anderen Motion-
      // Animation sofort und zuverlaessig initialisiert werden.
      const aioResultsReady = import('../scripts/aio-results-interactions.ts');
      // Fragmentziele erst nach dem Motion-Setup nachjustieren: ScrollTrigger
      // und Widgets verändern vor dem Ziel noch das Layout. Erst wenn beide
      // Initialisierungen abgeschlossen sind, wird der Anker final gesetzt.
      const motionReady = isMobileEbook
        ? Promise.all([
            import('../scripts/ebook-mobile-load.ts'),
            // Nach der mobilen Header-Choreografie das normale Motion-Bundle
            // nachladen. ebook-load erkennt diesen Sonderpfad und überspringt
            // ausschließlich den bereits abgespielten Header; alle Scroll-
            // Reveals und Animationen darunter bleiben identisch erhalten.
            afterMobileHero(() => import('../scripts/motion.ts')),
          ])
        : isMobileAio
          ? Promise.all([
              import('../scripts/aio-mobile-load.ts'),
              // Die sichtbare AIO-Startchoreografie bleibt unverändert. Das
              // große Scroll-/Reveal-Paket beginnt erst danach, damit der
              // Menübutton direkt nach dem Laden zuverlässig reagieren kann.
              isAioMobileReload
                ? afterNativeScrollRestore(() => import('../scripts/motion.ts'))
                : afterAioInitialPhase(() => import('../scripts/motion.ts')),
            ])
        : isAioMobileReload
          ? afterNativeScrollRestore(() => import('../scripts/motion.ts'))
          : import('../scripts/motion.ts');
      const homeProofCarouselReady = document.querySelector('[data-home-proof-carousel]')
        ? import('../scripts/home-results-carousel.ts')
        : Promise.resolve();
      Promise.allSettled([
        widgetsReady,
        aioResultsReady,
        motionReady,
        homeProofCarouselReady,
      ]).then(() =>
        import('../scripts/hash-navigation.ts')
      );
    </script>
    <PreviewExtras />
  </body>
</html>
