---
import BaseLayout from '../layouts/BaseLayout.astro';
import EbookLanding from '../components/EbookLanding.astro';
import ogImage from '../assets/images/ebook/og.png';

const EBOOK_ORIGIN = new URL('https://ebook.tristanweithaler.com');
const BUY_URL = new URL('/bestellen/', EBOOK_ORIGIN).href;
const title = 'Die Instagram Erfolgsformel – E-Book';
const description =
  'Lerne mit erprobten Strategien und echter Praxiserfahrung, wie du deinen Instagram-Account erfolgreich und nachhaltig aufbaust – inklusive exklusiver Boni.';
const imageUrl = new URL(ogImage.src, EBOOK_ORIGIN).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'Die Instagram Erfolgsformel',
  description,
  image: imageUrl,
  author: {
    '@type': 'Person',
    name: 'Tristan Weithaler',
  },
  inLanguage: 'de',
  numberOfPages: 140,
  bookFormat: 'https://schema.org/EBook',
  offers: {
    '@type': 'Offer',
    url: BUY_URL,
    price: '27.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  canonical={EBOOK_ORIGIN.href}
  route="e-book"
  navigationContext="ebook"
  jsonLd={jsonLd}
>
  <EbookLanding />
</BaseLayout>
