---
import BaseLayout from '../layouts/BaseLayout.astro';
import EbookLanding from '../components/EbookLanding.astro';
import { getEbook } from '../lib/content';
import { ogImageUrl } from '../lib/content/images';

const EBOOK_ORIGIN = new URL('https://ebook.tristanweithaler.com');
const BUY_URL = new URL('/bestellen/', EBOOK_ORIGIN).href;
const ebook = await getEbook();
const { product } = ebook;
const title = ebook.seo.title;
const description = ebook.seo.description;
const image = ogImageUrl(ebook.seo.image);
const imageUrl = image ? new URL(image, EBOOK_ORIGIN).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: product.name,
  description,
  image: imageUrl,
  author: {
    '@type': 'Person',
    name: 'Tristan Weithaler',
  },
  inLanguage: 'de',
  numberOfPages: product.pageCount,
  bookFormat: 'https://schema.org/EBook',
  offers: {
    '@type': 'Offer',
    url: BUY_URL,
    price: product.price.toFixed(2),
    priceCurrency: product.priceCurrency,
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  canonical={EBOOK_ORIGIN.href}
  noindex={ebook.seo.noindex}
  route="e-book"
  navigationContext="ebook"
  jsonLd={jsonLd}
>
  <EbookLanding content={ebook} />
</BaseLayout>
