---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionsHost from '#sections-host';
import Img from '../components/sections/Img';
import GlowButton from '../components/sections/GlowButton';
import { getEbook, getHome } from '../lib/content';
import type { SectionServicesTabs, ServiceItem } from '../lib/content/types';
import result3 from '../assets/images/results-3.avif';
import ebookBookMockup from '../assets/images/ebook/book-mockup-v3.png';

const heroImage =
  'https://cdn.sanity.io/images/45zc9nhz/production/039eb7cd9c80101ec27f627910a9e04e7e3c321b-2440x1816.avif?w=2440&q=90&auto=format&fit=max';
const ownResults = [
  {
    src: '/images/motion-study/own-reach.webp',
    metric: '15,1 Mio. Reichweite',
    detail: 'in 30 Tagen',
    pin: 'bottom-left',
    alt: '15.134.213 erreichte Konten in dreißig Tagen',
  },
  {
    src: '/images/motion-study/own-krampus.webp',
    metric: '10,7 Mio. Views',
    detail: 'mit einem Reel',
    pin: 'top-right',
    alt: 'Reel mit mehr als zehn Millionen Wiedergaben',
  },
  {
    src: result3.src,
    metric: '+7.926 Follower',
    detail: 'an einem Tag',
    pin: 'center-right',
    alt: 'Instagram-Wachstum auf 138.208 Follower',
  },
  {
    src: '/images/motion-study/own-santorini.webp',
    metric: '11 Mio. Views',
    detail: 'mit einem Reel',
    pin: 'top-left',
    alt: 'Reel-Ergebnis mit elf Millionen Aufrufen',
  },
  {
    src: '/images/motion-study/own-mindful-screen.webp',
    metric: '115.000 Follower',
    detail: 'Mindful Stays',
    pin: 'bottom-left',
    alt: 'Mindful Stays mit 115.000 Followern',
  },
  {
    src: '/images/motion-study/own-account-screen.webp',
    metric: '8.500+ Follower',
    detail: '61.137 Profilaktivitäten',
    pin: 'top-right',
    alt: 'Eigener Account mit mehr als 8.500 Followern und 61.137 Profilaktivitäten',
  },
];
const ownOrbit = [
  ownResults[0],
  ownResults[1],
  ownResults[3],
  {
    src: '/images/motion-study/own-backpack-cropped.webp',
    metric: '+2.000 Follower',
    detail: 'mit einem Reel',
    pin: 'top-right',
    alt: 'Reel mit 1.766.701 Aufrufen und 2.000 neu gewonnenen Followern',
  },
  ownResults[5],
  {
    src: '/images/motion-study/own-carousel-leads.webp',
    metric: '300+ Leads',
    detail: 'mit nur einem Carousel-Post',
    pin: 'top-left',
    alt: 'Carousel-Beitrag mit mehr als 300 generierten Leads',
  },
  {
    ...ownResults[4],
    pin: 'top-right',
  },
  {
    src: '/images/motion-study/own-ramp.webp',
    metric: '19 Mio. Views',
    detail: 'Mindful Stays',
    pin: 'top-right',
    alt: 'Reel mit 19 Millionen Aufrufen',
  },
];
const customerResults = [
  {
    src: '/images/aio-results/friedrich-profile-reels.jpg',
    metric: '600.000 Views',
    detail: '+1.200 Follower in 4 Tagen',
    pin: 'center-top',
    format: 'device',
    alt: 'Friedrich Moosmair mit 600.000 Reel-Views und 1.200 neuen Followern in vier Tagen',
  },
  {
    src: '/images/aio-results/steffi-result.jpg',
    metric: '1,0 Mio. Aufrufe',
    detail: 'in 30 Tagen',
    pin: 'top-left',
    format: 'panel',
    alt: 'Steffi mit einer Million Aufrufen innerhalb von dreißig Tagen',
  },
  {
    src: '/images/aio-results/chalet-lefiro-result.jpg',
    metric: '+17.900 Follower',
    detail: 'in 6 Monaten',
    pin: 'top-right',
    format: 'panel',
    alt: 'Chalet Lefiro gewann in sechs Monaten 17.900 Follower',
  },
  {
    src: '/images/aio-results/naomi-before.jpg',
    secondarySrc: '/images/aio-results/naomi-after.jpg',
    metric: '2.175 → 26.800',
    detail: 'Follower',
    pin: 'bottom-left',
    format: 'comparison',
    alt: 'Naomis Follower-Wachstum von 2.175 auf 26.800',
  },
  {
    src: '/images/aio-results/christina-profile.jpg',
    secondarySrc: '/images/aio-results/christina-growth.jpg',
    metric: '+79.000 Follower',
    detail: 'von 50.000 auf 129.000',
    pin: 'bottom-right',
    format: 'comparison',
    alt: 'Christina Starke mit 79.000 neu gewonnenen Followern',
  },
  {
    src: '/images/aio-results/alpin-arena-result.jpg',
    metric: '66.078 Views',
    detail: 'organisch · 41.487 Konten',
    pin: 'top-left',
    format: 'phone',
    alt: 'Alpin Arena mit 66.078 organischen Reel-Aufrufen und 41.487 erreichten Konten',
  },
  {
    src: '/images/aio-results/steffi-profile.jpg',
    metric: '+4.500 Follower',
    detail: 'organisch aufgebaut',
    pin: 'top-right',
    format: 'panel',
    alt: 'Steffis Profil mit 4.500 neu gewonnenen Followern',
  },
  {
    src: '/images/aio-results/chalet-views.jpg',
    metric: '1,4 Mio. Aufrufe',
    detail: 'mit einem Reel',
    pin: 'top-right',
    format: 'panel',
    alt: 'Chalet Lefiro mit 1,4 Millionen Aufrufen auf einem Reel',
  },
  {
    src: '/images/aio-results/friedrich-result.jpg',
    metric: '+1.200 Follower',
    detail: 'in nur 4 Tagen',
    pin: 'bottom-right',
    format: 'panel',
    alt: 'Friedrich Moosmair mit 1.200 neuen Followern in vier Tagen',
  },
  {
    src: '/images/aio-results/naturnser-alm-result.jpg',
    metric: '1.300 → 2.061',
    detail: 'Follower',
    pin: 'top-left',
    format: 'phone',
    alt: 'Naturnser Alm wuchs von circa 1.300 auf 2.061 Follower',
  },
  {
    src: '/images/aio-results/untermarzoner-result.jpg',
    metric: '84.000+ Views',
    detail: 'auf einem TikTok',
    pin: 'top-right',
    format: 'panel',
    alt: 'Die Küche by Untermarzoner mit mehr als 84.000 TikTok-Aufrufen',
  },
];
const home = await getHome();
const ebook = await getEbook();
const continuationSections = home.sections.filter(
  (section) => section._type !== 'sectionHomeHero' && section._type !== 'sectionResults',
);
const statementSections = continuationSections.filter(
  (section) => section._type === 'sectionValueStatement',
);
const aioOfferSections = continuationSections.filter(
  (section) => section._type === 'sectionSplitCta' && section._key === 'aio-teaser',
);
const specificOfferSection = continuationSections.find(
  (section) => section._type === 'sectionServicesTabs',
) as SectionServicesTabs | undefined;
const remainingSections = continuationSections.filter(
  (section) =>
    section._type !== 'sectionValueStatement' &&
    section._type !== 'sectionServicesTabs' &&
    !(section._type === 'sectionSplitCta' && section._key === 'aio-teaser'),
);
const serviceLimit = specificOfferSection?.limit && specificOfferSection.limit > 0
  ? specificOfferSection.limit
  : Infinity;
const personalServices = specificOfferSection?.services
  .filter((service) => service.category === 'personal')
  .slice(0, serviceLimit) ?? [];
const businessServices = specificOfferSection?.services
  .filter((service) => service.category === 'business')
  .slice(0, serviceLimit) ?? [];
const serviceGroups = specificOfferSection
  ? [
      {
        id: 'personal',
        label: specificOfferSection.tabLabelPersonal,
        items: personalServices,
      },
      {
        id: 'business',
        label: specificOfferSection.tabLabelBusiness,
        items: businessServices,
      },
    ]
  : [];
const serviceResultLines: Record<string, string> = {
  'personal:Vision & berufliche Ausrichtung': 'Klarheit über Vision, Berufung und den nächsten Schritt',
  'personal:Zielgruppe & Positionierung': 'Eine klare Positionierung für die richtigen Kunden',
  'business:Zielgruppe & Positionierung': 'Eine klare Positionierung für die richtigen Kunden',
  'personal:Social Media Account Optimierung': 'Ein professioneller, klarer und unverwechselbarer Auftritt',
  'business:Social Media Account Optimierung': 'Ein professioneller, klarer und unverwechselbarer Auftritt',
  'personal:Strategien für mehr Reichweite & Follower': 'Organische Strategien für Reichweite und Community-Wachstum',
  'business:Strategien für mehr Reichweite & Follower': 'Organische Strategien für Reichweite und Community-Wachstum',
  'personal:Angebote, Produkte & Freebies': 'Eine stimmige Produktkette mit echtem Umsatzpotenzial',
  'personal:Kundengewinnung & Monetarisierung': 'Planbare Kundenanfragen mit System statt Druck',
  'business:Kundengewinnung & Monetarisierung': 'Effizientere und langfristig skalierbare Kundengewinnung',
  'personal:Content Erstellung & Bearbeitung': 'Hochwertiger Content, der performt und effizient entsteht',
  'business:Content Erstellung & Bearbeitung': 'Ein effizienter Prozess für authentischen, starken Content',
  'personal:Erfolgs-Mindset für Wachstum': 'Mehr Klarheit, Fokus und Freude an Social Media',
  'business:Allgemeine Social Media Beratung': 'Ein klarer Social-Media-Fahrplan für euren Betrieb',
  'business:Influencer Marketing Beratung': 'Passende Partner, klare Konditionen und messbarer Erfolg',
  'business:Mitarbeiter-Ausbildung': 'Social-Media-Kompetenz nachhaltig im Unternehmen aufbauen',
};
const serviceResultLine = (service: ServiceItem) =>
  serviceResultLines[`${service.category}:${service.name}`] ?? service.formName;
---

<BaseLayout
  title="Hero Phone Match Cut | Tristan Weithaler"
  description="Lokaler Prototyp für einen hochauflösenden Match-Cut vom Hero-Foto zu den Ergebnissen."
  noindex={true}
  route="motion-study"
>
  <main
    class="match-study"
    data-match-study=""
    data-active-world="accounts"
    data-bridge-phase="held"
    data-lift-enabled="false"
    data-journey-state="arrival"
  >
    <div class="match-study__track" data-match-track="">
      <div class="match-study__sticky">
        <header class="match-study__copy" data-match-copy="">
          <h1>
            <span>Südtirols erster</span>
            Social Media<br />Business Coach
          </h1>
          <span class="match-study__button">Coaching anfragen</span>
        </header>

        <figure class="match-study__photo" data-match-photo="">
          <div class="match-study__photo-entry" data-match-photo-entry="">
            <div class="match-study__photo-plane" data-match-photo-plane="">
              <img
                data-match-photo-image=""
                src={heroImage}
                alt="Tristan Weithaler hält ein Smartphone in der Hand"
                width="2440"
                height="1816"
                loading="eager"
                fetchpriority="high"
              />

              <!-- Eine einzige Mockup-Ebene bleibt von der Hand bis in die
                   Ergebniswelt erhalten. Anfangs ist nur ihre Displayfläche
                   sichtbar; beim Pull-in öffnet sich dieselbe Ebene vollständig. -->
              <div class="match-study__bridge-wrap" data-match-bridge-wrap="">
                <span class="match-study__bridge-motion" data-match-bridge-motion="">
                  <span class="match-study__bridge-center">
                    <span class="match-study__bridge-focus">
                      <img
                        class="match-study__phone match-study__phone--bridge"
                        data-match-phone="bridge"
                        src={ownResults[2].src}
                        alt={ownResults[2].alt}
                        width="806"
                        height="1625"
                        loading="eager"
                      />
                      <span class="match-study__result-pin match-study__own-center-pin" data-match-center-pin="">
                        <strong>{ownResults[2].metric}</strong>
                        <small>{ownResults[2].detail}</small>
                      </span>
                    </span>
                  </span>
                </span>
              </div>
            </div>
          </div>
          <span class="match-study__photo-grade" data-match-grade="" aria-hidden="true"></span>
          <div class="match-study__iris" data-match-iris="" aria-hidden="true"></div>
        </figure>

        <section class="match-study__results" data-match-results="" data-active-world="accounts" id="proof">
          <p class="match-study__eyebrow eyebrow" data-match-meta="">
            <span data-world-label="accounts">Meine Erfolge</span>
            <span data-world-label="customers" aria-hidden="true">Kundenerfolge</span>
          </p>

          <div class="match-study__world match-study__world--accounts" data-world="accounts">
            {ownOrbit.map((result, index) => (
              <button
                class="match-study__world-card match-study__world-card--own"
                data-world-card="accounts"
                data-orbit={index}
                data-pin={result.pin}
                type="button"
                aria-label={result.alt}
              >
                <span class="match-study__world-card-visual match-study__own-proof">
                  <span class="match-study__own-media">
                    <img src={result.src} alt={result.alt} loading="eager" />
                  </span>
                  <span class="match-study__result-pin match-study__own-pin">
                    <strong>{result.metric}</strong>
                    <small>{result.detail}</small>
                  </span>
                </span>
              </button>
            ))}
          </div>

          <div class="match-study__world match-study__world--customers" data-world="customers" aria-hidden="true">
            {customerResults.map((result, index) => (
              <button
                class="match-study__world-card match-study__world-card--customer"
                data-world-card="customers"
                data-orbit={index}
                data-format={result.format}
                data-pin={result.pin}
                type="button"
                aria-label={result.alt}
                tabindex={index === 0 ? -1 : undefined}
              >
                {result.format === 'device' ? (
                  <span class="match-study__world-card-visual match-study__customer-device">
                    <img class="match-study__customer-device-frame" src={ownResults[2].src} alt="" aria-hidden="true" />
                    <span class="match-study__customer-device-screen">
                      <img src={result.src} alt={result.alt} loading="lazy" />
                    </span>
                    <span class="match-study__result-pin match-study__customer-pin">
                      <strong>{result.metric}</strong>
                      <small>{result.detail}</small>
                    </span>
                  </span>
                ) : (
                  <span class={`match-study__world-card-visual match-study__customer-proof match-study__customer-proof--${result.format}`}>
                    {result.format === 'phone' && <span class="match-study__customer-speaker" aria-hidden="true"></span>}
                    <span class="match-study__customer-media">
                      <img src={result.src} alt={result.alt} loading="lazy" />
                      {'secondarySrc' in result && result.secondarySrc && <img src={result.secondarySrc} alt="" loading="lazy" />}
                    </span>
                    <span class="match-study__result-pin match-study__customer-pin">
                      <strong>{result.metric}</strong>
                      <small>{result.detail}</small>
                    </span>
                  </span>
                )}
              </button>
            ))}
          </div>

        </section>

        <div class="match-study__card-lift" data-match-card-lift="" aria-hidden="true"></div>

        <p class="match-study__hint" data-match-hint="" aria-hidden="true">
          Scroll · Match Cut
        </p>
      </div>
    </div>
  </main>

  <div class="match-study__continuation" data-match-continuation="">
    <SectionsHost
      sections={statementSections}
      document={{ id: home.documentId, type: 'homePage' }}
    />

    <section id="angebote" class="offers-intro" aria-labelledby="offers-heading">
      <div class="container">
        <p class="offers-intro__eyebrow eyebrow">Meine Angebote</p>

        <div class="ebook-offer">
          <div class="ebook-offer__visual" aria-hidden="true">
            <span class="ebook-offer__halo"></span>
            <img
              src={ebookBookMockup.src}
              width={ebookBookMockup.width}
              height={ebookBookMockup.height}
              alt=""
              loading="lazy"
            />
          </div>
          <div class="ebook-offer__copy">
            <h2 id="offers-heading">{ebook.product.name}</h2>
            <div class="ebook-offer__details">
              <p>{ebook.hero.text}</p>
              <p class="ebook-offer__meta">
                {ebook.product.pageCount} Seiten · {ebook.product.chapterCount} Kapitel · {ebook.product.bonusCount} Boni
              </p>
              <div class="ebook-offer__cta">
                <GlowButton label="Zum E-Book" href="/e-book/" />
              </div>
            </div>
          </div>
        </div>

        <div class="offers-intro__divider" aria-hidden="true"></div>
      </div>
    </section>

    <SectionsHost
      sections={aioOfferSections}
      document={{ id: home.documentId, type: 'homePage' }}
    />

    {specificOfferSection && (
      <section
        id={specificOfferSection.anchor || undefined}
        class="specific-coachings"
        aria-labelledby="specific-coachings-heading"
      >
        <div class="container">
          <header class="specific-coachings__head">
            <h2 id="specific-coachings-heading">{specificOfferSection.heading}</h2>
            {specificOfferSection.subtext && <p>{specificOfferSection.subtext}</p>}
          </header>

          <div class="specific-coachings__tabs" data-coaching-tabs="">
            <div class="specific-coachings__audience">
              <span class="specific-coachings__audience-label">Coaching für</span>
              <div class="specific-coachings__tablist" role="tablist" aria-label="Zielgruppe auswählen">
                {serviceGroups.map((group, index) => (
                  <button
                    type="button"
                    class:list={['specific-coachings__tab', { 'is-active': index === 0 }]}
                    role="tab"
                    id={`coaching-tab-${group.id}`}
                    aria-label={group.label}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-controls={`coaching-panel-${group.id}`}
                    data-coaching-tab={group.id}
                  >
                    {group.label.replace(/^Für\s+/, '')}
                  </button>
                ))}
              </div>
            </div>

            {serviceGroups.map((group, groupIndex) => (
              <div
                class="specific-coachings__panel"
                role="tabpanel"
                id={`coaching-panel-${group.id}`}
                aria-labelledby={`coaching-tab-${group.id}`}
                data-coaching-panel={group.id}
                hidden={groupIndex !== 0}
              >
                <div
                  class="specific-coachings__choices"
                  role="tablist"
                  aria-label={`${group.label}: Coaching auswählen`}
                >
                  {group.items.map((service, serviceIndex) => {
                    const panelId = `coaching-detail-${group.id}-${serviceIndex}`;
                    return (
                      <button
                        type="button"
                        class:list={['specific-coachings__choice', { 'is-active': serviceIndex === 0 }]}
                        role="tab"
                        id={`coaching-choice-${group.id}-${serviceIndex}`}
                        aria-selected={serviceIndex === 0 ? 'true' : 'false'}
                        aria-controls={panelId}
                        data-coaching-choice=""
                      >
                        <span class="specific-coachings__summary">
                          <strong>{service.name}</strong>
                          <span>{serviceResultLine(service)}</span>
                        </span>
                      </button>
                    );
                  })}
                </div>

                <div class="specific-coachings__details">
                  {group.items.map((service, serviceIndex) => {
                    const panelId = `coaching-detail-${group.id}-${serviceIndex}`;
                    return (
                      <article
                        class="specific-coachings__detail"
                        role="tabpanel"
                        id={panelId}
                        aria-labelledby={`coaching-choice-${group.id}-${serviceIndex}`}
                        data-coaching-detail=""
                        hidden={serviceIndex !== 0}
                      >
                        <span class="specific-coachings__detail-image">
                          <Img image={service.image} sizes="(max-width: 767px) 90vw, 18rem" />
                        </span>
                        <div class="specific-coachings__detail-copy">
                          <h3>{service.name}</h3>
                          <p>{service.description}</p>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>

          <div class="specific-coachings__footer">
            <GlowButton label={specificOfferSection.ctaModalLabel || 'Coaching anfragen'} action="modal" />
          </div>
        </div>
      </section>
    )}

    <SectionsHost
      sections={remainingSections}
      document={{ id: home.documentId, type: 'homePage' }}
    />
  </div>
</BaseLayout>

<script>
  import { gsap, ScrollTrigger } from '../scripts/motion/util';

  const root = document.querySelector<HTMLElement>('[data-match-study]');
  const track = root?.querySelector<HTMLElement>('[data-match-track]');
  const sticky = root?.querySelector<HTMLElement>('.match-study__sticky');
  const copy = root?.querySelector<HTMLElement>('[data-match-copy]');
  const photo = root?.querySelector<HTMLElement>('[data-match-photo]');
  const photoEntry = root?.querySelector<HTMLElement>('[data-match-photo-entry]');
  const photoPlane = root?.querySelector<HTMLElement>('[data-match-photo-plane]');
  const photoImage = root?.querySelector<HTMLElement>('[data-match-photo-image]');
  const grade = root?.querySelector<HTMLElement>('[data-match-grade]');
  const iris = root?.querySelector<HTMLElement>('[data-match-iris]');
  const results = root?.querySelector<HTMLElement>('[data-match-results]');
  const metas = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-match-meta]')) : [];
  const bridgeWrap = root?.querySelector<HTMLElement>('[data-match-bridge-wrap]');
  const bridgeMotion = root?.querySelector<HTMLElement>('[data-match-bridge-motion]');
  const bridgeFocus = root?.querySelector<HTMLElement>('.match-study__bridge-focus');
  const bridge = root?.querySelector<HTMLElement>('[data-match-phone="bridge"]');
  const centerPin = root?.querySelector<HTMLElement>('[data-match-center-pin]');
  const ownCards = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-world-card="accounts"]')) : [];
  const customerCards = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-world-card="customers"]')) : [];
  const customerHero = customerCards.find((card) => card.dataset.orbit === '0');
  const customerSatellites = customerCards.filter((card) => card.dataset.orbit !== '0');
  const worlds = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-world]')) : [];
  const accountsWorld = root?.querySelector<HTMLElement>('[data-world="accounts"]');
  const customersWorld = root?.querySelector<HTMLElement>('[data-world="customers"]');
  const worldLabels = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-world-label]')) : [];
  const accountsLabel = root?.querySelector<HTMLElement>('[data-world-label="accounts"]');
  const customersLabel = root?.querySelector<HTMLElement>('[data-world-label="customers"]');
  const liftLayer = root?.querySelector<HTMLElement>('[data-match-card-lift]');
  const liftableCards = root
    ? Array.from(root.querySelectorAll<HTMLElement>('.match-study__world-card:not(.match-study__world-card--customer[data-orbit="0"])'))
    : [];
  const hint = root?.querySelector<HTMLElement>('[data-match-hint]');

  if (
    root &&
    track &&
    sticky &&
    copy &&
    photo &&
    photoEntry &&
    photoPlane &&
    photoImage &&
    grade &&
    iris &&
    results &&
    bridgeWrap &&
    bridgeMotion &&
    bridgeFocus &&
    bridge &&
    centerPin &&
    accountsWorld &&
    customersWorld &&
    accountsLabel &&
    customersLabel &&
    liftLayer &&
    hint
  ) {
    const mm = gsap.matchMedia();
    type WorldName = 'accounts' | 'customers';
    type JourneyState =
      | 'arrival'
      | 'accounts-ready'
      | 'transition'
      | 'customers-ready'
      | 'leaving';
    let activeWorld: WorldName | null = null;
    let journeyState: JourneyState = 'arrival';
    let liftTimer = 0;
    let liftedSource: HTMLElement | null = null;
    let liftEnabled = false;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const restoreLiftSource = (source: HTMLElement | null) => {
      liftLayer.replaceChildren();
      root.dataset.liftOpen = 'false';

      if (!source?.isConnected) return;

      /* Klon und Ursprung werden innerhalb desselben Renderframes übergeben.
         Die temporär deaktivierten Transitions verhindern, dass die echte
         Karte nach der Landung noch einmal aufblitzt oder nachfadet. */
      source.classList.add('is-lift-handoff');
      source.classList.remove('is-lift-source');
      source.getBoundingClientRect();
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          source.classList.remove('is-lift-handoff');
        });
      });
    };

    const clearLift = (animate = true) => {
      window.clearTimeout(liftTimer);
      const liftedCard = liftLayer.firstElementChild as HTMLElement | null;
      const sourceToRestore = liftedSource;
      liftableCards.forEach((card) => card.setAttribute('aria-pressed', 'false'));
      liftedSource = null;
      if (!liftedCard || !animate) {
        liftLayer.replaceChildren();
        root.dataset.liftOpen = 'false';
        liftableCards.forEach((card) => card.classList.remove('is-lift-source'));
        return;
      }

      let returnFinished = false;
      const finishReturn = () => {
        if (returnFinished) return;
        returnFinished = true;
        window.clearTimeout(liftTimer);
        liftedCard.removeEventListener('transitionend', handleReturnEnd);
        restoreLiftSource(sourceToRestore);
      };
      const handleReturnEnd = (event: TransitionEvent) => {
        if (event.target === liftedCard && event.propertyName === 'transform') {
          finishReturn();
        }
      };

      liftedCard.addEventListener('transitionend', handleReturnEnd);
      liftedCard.classList.add('is-returning');
      liftedCard.getBoundingClientRect();
      window.requestAnimationFrame(() => {
        if (!liftedCard.isConnected) return;
        const sourceRect = sourceToRestore?.getBoundingClientRect();
        const layerRect = liftLayer.getBoundingClientRect();
        const baseWidth = Math.max(liftedCard.offsetWidth, 1);
        const liveReturnX = sourceRect
          ? sourceRect.left + sourceRect.width / 2 - (layerRect.left + layerRect.width / 2)
          : Number.parseFloat(liftedCard.style.getPropertyValue('--lift-return-x')) || 0;
        const liveReturnY = sourceRect
          ? sourceRect.top + sourceRect.height / 2 - (layerRect.top + layerRect.height / 2)
          : Number.parseFloat(liftedCard.style.getPropertyValue('--lift-return-y')) || 0;
        const liveReturnScale = sourceRect
          ? Math.min(0.96, Math.max(0.24, sourceRect.width / baseWidth))
          : Number.parseFloat(liftedCard.style.getPropertyValue('--lift-return-scale')) || 0.4;

        liftedCard.style.setProperty(
          '--lift-x',
          `${liveReturnX}px`,
        );
        liftedCard.style.setProperty(
          '--lift-y',
          `${liveReturnY}px`,
        );
        liftedCard.style.setProperty(
          '--lift-scale',
          String(liveReturnScale),
        );
        liftedCard.style.setProperty(
          '--lift-rotation',
          liftedCard.style.getPropertyValue('--lift-return-rotation') || '0deg',
        );
      });
      liftTimer = window.setTimeout(finishReturn, 760);
    };

    const liftCard = (card: HTMLElement) => {
      if (!liftEnabled) return;
      if (liftedSource === card) return;
      clearLift(false);

      const clone = card.cloneNode(true) as HTMLElement;
      clone.classList.add('is-lifted');
      clone.removeAttribute('data-world-card');
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      clone.removeAttribute('aria-pressed');
      clone.addEventListener('click', () => clearLift());
      const sourceVisual = card.querySelector<HTMLElement>('.match-study__world-card-visual');
      const sourceOpacity = sourceVisual ? getComputedStyle(sourceVisual).opacity : '0.52';
      const sourceFilter = sourceVisual ? getComputedStyle(sourceVisual).filter : 'brightness(0.68) saturate(0.8)';
      card.classList.add('is-lift-source');
      card.setAttribute('aria-pressed', 'true');
      liftLayer.replaceChildren(clone);
      liftedSource = card;
      root.dataset.liftOpen = 'true';

      /* Die Fokuskarte startet exakt an der sichtbaren Position ihres
         Satelliten und fährt anschließend in dieselbe ruhige Leseposition.
         So gibt es weder einen Sprung noch unterschiedlich starke Zooms. */
      const sourceRect = card.getBoundingClientRect();
      const targetRect = clone.getBoundingClientRect();
      const sourceRotation = getComputedStyle(card).getPropertyValue('--orbit-rotation').trim() || '0deg';
      const sourceScale = Math.min(
        0.96,
        Math.max(0.24, sourceRect.width / Math.max(targetRect.width, 1)),
      );
      const returnX = sourceRect.left + sourceRect.width / 2 - (targetRect.left + targetRect.width / 2);
      const returnY = sourceRect.top + sourceRect.height / 2 - (targetRect.top + targetRect.height / 2);

      /* Der Fokus wird gegen eine echte Safe-Area gerechnet: Navigation oben,
         kleine Außenabstände auf allen Seiten und das Badge zählen vollständig
         zur benötigten Fläche. Dadurch passt jedes Seitenverhältnis in jede
         Viewport-Höhe, ohne unter der Kopfzeile oder am Rand abgeschnitten zu
         werden. */
      const visual = clone.querySelector<HTMLElement>('.match-study__world-card-visual');
      const pin = clone.querySelector<HTMLElement>('.match-study__result-pin');
      const contentRects = [visual, pin]
        .filter((element): element is HTMLElement => Boolean(element))
        .map((element) => element.getBoundingClientRect());
      const contentBounds = contentRects.reduce(
        (bounds, rect) => ({
          left: Math.min(bounds.left, rect.left),
          top: Math.min(bounds.top, rect.top),
          right: Math.max(bounds.right, rect.right),
          bottom: Math.max(bounds.bottom, rect.bottom),
        }),
        {
          left: targetRect.left,
          top: targetRect.top,
          right: targetRect.right,
          bottom: targetRect.bottom,
        },
      );
      const navbarBottom = document.querySelector<HTMLElement>('.navbar')?.getBoundingClientRect().bottom ?? 0;
      const safeInset = Math.max(14, Math.min(28, window.innerWidth * 0.025));
      const safeLeft = safeInset;
      const safeRight = window.innerWidth - safeInset;
      const safeTop = Math.max(safeInset, navbarBottom + safeInset);
      const safeBottom = window.innerHeight - safeInset;
      const contentWidth = Math.max(1, contentBounds.right - contentBounds.left);
      const contentHeight = Math.max(1, contentBounds.bottom - contentBounds.top);
      const focusScale = Math.min(
        1,
        ((safeRight - safeLeft) / contentWidth) * 0.985,
        ((safeBottom - safeTop) / contentHeight) * 0.985,
      );
      const targetCenterX = targetRect.left + targetRect.width / 2;
      const targetCenterY = targetRect.top + targetRect.height / 2;
      const contentCenterX = (contentBounds.left + contentBounds.right) / 2;
      const contentCenterY = (contentBounds.top + contentBounds.bottom) / 2;
      const scaledContentCenterX = targetCenterX + (contentCenterX - targetCenterX) * focusScale;
      const scaledContentCenterY = targetCenterY + (contentCenterY - targetCenterY) * focusScale;
      const focusX = (safeLeft + safeRight) / 2 - scaledContentCenterX;
      const focusY = (safeTop + safeBottom) / 2 - scaledContentCenterY;

      clone.style.setProperty('--lift-return-x', `${returnX}px`);
      clone.style.setProperty('--lift-return-y', `${returnY}px`);
      clone.style.setProperty('--lift-return-scale', String(sourceScale));
      clone.style.setProperty('--lift-return-rotation', sourceRotation);
      clone.style.setProperty('--lift-return-opacity', sourceOpacity);
      clone.style.setProperty('--lift-return-filter', sourceFilter);
      clone.style.setProperty('--lift-x', `${returnX}px`);
      clone.style.setProperty('--lift-y', `${returnY}px`);
      clone.style.setProperty('--lift-scale', String(sourceScale));
      clone.style.setProperty('--lift-rotation', sourceRotation);
      clone.getBoundingClientRect();

      window.requestAnimationFrame(() => {
        if (liftedSource !== card || !clone.isConnected) return;
        clone.classList.add('is-lift-ready');
        clone.style.setProperty('--lift-x', `${focusX}px`);
        clone.style.setProperty('--lift-y', `${focusY}px`);
        clone.style.setProperty('--lift-scale', String(focusScale));
        clone.style.setProperty('--lift-rotation', '0deg');
      });
    };

    const setLiftEnabled = (enabled: boolean) => {
      if (liftEnabled === enabled) return;
      liftEnabled = enabled;
      root.dataset.liftEnabled = String(enabled);

      if (!enabled && liftedSource) {
        clearLift(false);
      }
    };

    const setJourneyState = (nextState: JourneyState) => {
      if (journeyState === nextState) return;
      journeyState = nextState;
      root.dataset.journeyState = nextState;

      const readyWorld =
        nextState === 'accounts-ready'
          ? 'accounts'
          : nextState === 'customers-ready'
            ? 'customers'
            : null;
      setLiftEnabled(readyWorld !== null);
      liftableCards.forEach((card) => {
        const cardWorld = card.closest<HTMLElement>('[data-world]')?.dataset.world;
        card.setAttribute('aria-disabled', String(cardWorld !== readyWorld));
      });
    };

    liftableCards.forEach((card) => {
      card.setAttribute('aria-pressed', 'false');
      card.setAttribute('aria-disabled', 'true');
      card.addEventListener('click', () => {
        if (!liftEnabled) {
          clearLift(false);
          return;
        }
        if (liftedSource === card) clearLift();
        else liftCard(card);
      });
    });

    liftLayer.addEventListener('click', (event) => {
      if (event.target === liftLayer && liftedSource) clearLift();
    });

    const setWorld = (nextWorld: WorldName) => {
      if (activeWorld === nextWorld) return;
      if (liftedSource) clearLift(false);
      activeWorld = nextWorld;
      root.dataset.activeWorld = nextWorld;
      results.dataset.activeWorld = nextWorld;

      worlds.forEach((world) => {
        const isActive = world.dataset.world === nextWorld;
        world.setAttribute('aria-hidden', String(!isActive));
        (world as HTMLElement & { inert: boolean }).inert = !isActive;
      });

      worldLabels.forEach((label) => {
        label.setAttribute('aria-hidden', String(label.dataset.worldLabel !== nextWorld));
      });
    };
    setWorld('accounts');

    const build = ({
      mobile,
      compact,
    }: {
      mobile: boolean;
      compact: boolean;
    }) => {
      const fastMotion = mobile || compact;
      const stagedWorldTransition = mobile || compact;
      const tallViewport = sticky.clientWidth / Math.max(sticky.clientHeight, 1) <= 1.35;
      /* Auf dem schmalen Mobil-Viewport darf der Weltenwechsel nicht wie das
         Zusammenschieben zweier kompletter Desktop-Buehnen wirken. Eine
         kuerzere horizontale Strecke haelt das jeweils aktive Hauptmockup im
         Fokus; die eigentliche Staffelung folgt unten in der Timeline. */
      const worldSlideDistance = stagedWorldTransition ? 34 : tallViewport ? 30 : 38;
      const getRenderedImage = (frame: {
        left: number;
        top: number;
        width: number;
        height: number;
      }) => {
        const imageScale = Math.max(frame.width / 2440, frame.height / 1816);
        const width = 2440 * imageScale;
        const height = 1816 * imageScale;

        return {
          left: frame.left + (frame.width - width) / 2,
          top: frame.top + frame.height - height,
          width,
          height,
          imageScale,
        };
      };

      /* Die Bühne bleibt immer so groß wie der Viewport. Die Startspalte ist
         nur eine Maske plus ein Transform derselben Pixel – kein Resize. */
      const getEntryState = () => {
        const width = sticky.clientWidth;
        const height = sticky.clientHeight;

        /* Mobil startet das Foto als ruhiges, vollbreites Bildpanel unter der
           Hero-Aussage. Es wird nicht mehr wie eine verkleinerte zweite Bühne
           in Text und CTA hineingeschoben. Beim Scrollen fährt nur dieses
           Panel nach oben und öffnet sich zum identischen Vollbild. */
        if (mobile) {
          return {
            x: 0,
            y: height * 0.18,
            scale: 1,
          };
        }

        const fullFrame = { left: 0, top: 0, width, height };
        const entryFrame = compact
          ? { left: width * 0.52, top: 0, width: width * 0.48, height }
          : { left: width * 0.6, top: 0, width: width * 0.4, height };
        const fullImage = getRenderedImage(fullFrame);
        const entryImage = getRenderedImage(entryFrame);
        const scale = entryImage.imageScale / fullImage.imageScale;

        return {
          x:
            entryImage.left -
            fullImage.left * scale +
            (mobile ? 0 : sticky.clientWidth * (compact ? 0.025 : 0.03)),
          y: entryImage.top - fullImage.top * scale,
          scale,
        };
      };

      const zoomAmount = mobile ? 1.42 : compact ? 1.24 : 1.28;
      const centerPinViewportScale = mobile
        ? Math.min(0.92, 0.76 + (sticky.clientWidth / 550) * 0.1)
        : compact
          ? Math.min(0.9, 0.72 + (sticky.clientHeight / 1000) * 0.2)
          : 1;
      /* Das eigene Badge liegt innerhalb der gezoomten Fotoebene, das
         Kunden-Badge dagegen außerhalb. Gleiche den übergeordneten Zoom aus,
         damit nicht nur die CSS-Werte, sondern die sichtbare Größe identisch
         ist. */
      root.style.setProperty('--match-center-pin-viewport-scale', String(centerPinViewportScale));
      centerPin.style.setProperty('--match-center-pin-scale', String(centerPinViewportScale / zoomAmount));
      /* Das Handy wird ausschließlich in Koordinaten des 2440 × 1816 px
         großen Originalfotos beschrieben. Seine sichtbare Startgeometrie
         liegt unten vollständig in CSS-Containerkoordinaten, damit sie ohne
         gerundete JS-Zwischenwerte exakt dieselbe Bewegung wie das Foto erbt.
         Diese Funktion wird nur noch für das spätere Lösen aus der Hand
         benötigt. */
      const heroPhoneSource = {
        x: 1104,
        y: 878,
        height: 146,
      } as const;
      const getPhoneGeometry = () => {
        const photoBounds = photo.getBoundingClientRect();
        const renderedImage = getRenderedImage({
          left: 0,
          top: 0,
          width: photoBounds.width,
          height: photoBounds.height,
        });

        return {
          x: renderedImage.left + heroPhoneSource.x * renderedImage.imageScale,
          y: renderedImage.top + heroPhoneSource.y * renderedImage.imageScale,
          height: heroPhoneSource.height * renderedImage.imageScale,
        };
      };
      const getInitialBridgeHeight = () => getPhoneGeometry().height;
      const getFinalBridgeHeight = () => {
        if (mobile) return Math.min(sticky.clientHeight * 0.62, sticky.clientWidth * 1.34, 526);
        if (compact) {
          /* Nur wirklich flache Querformate brauchen die kleinere 36vw-Buehne.
             Ein fast quadratisches Tablet-/Browserfenster darf nicht wie ein
             420px hohes Handy behandelt werden, sonst springt die zentrale
             Mockup-Groesse beim Wechsel der Ergebniswelt. */
          return sticky.clientHeight <= 620
            ? Math.min(sticky.clientHeight * 0.72, sticky.clientWidth * 0.36, 400)
            : Math.min(sticky.clientHeight * 0.63, sticky.clientWidth * 1.34, 526);
        }
        if (tallViewport) return Math.min(sticky.clientHeight * 0.64, 680);
        return Math.min(sticky.clientHeight * 0.72, 768);
      };
      const getPhotoOrigin = () => {
        const [x = '0', y = '0'] = getComputedStyle(photoPlane).transformOrigin.split(' ');
        return { x: Number.parseFloat(x), y: Number.parseFloat(y) };
      };
      const getBridgeDestination = () => {
        const initial = getPhoneGeometry();
        const origin = getPhotoOrigin();
        const finalHeight = getFinalBridgeHeight() / zoomAmount;
        const finalWidth = finalHeight * (806 / 1625);
        const centerX = origin.x + (sticky.clientWidth / 2 - origin.x) / zoomAmount;
        const centerY = origin.y + (sticky.clientHeight / 2 - origin.y) / zoomAmount;

        return {
          x: centerX - initial.x - finalWidth / 2,
          y: centerY - initial.y - finalHeight / 2,
        };
      };
      /* GSAP speichert den Ausgangswert eines normalen Transform-Tweens.
         Nach einem Resize wäre das die Geometrie des vorherigen Viewports.
         Deshalb animieren wir nur einen normierten Fortschritt und leiten die
         sichtbare Transform-Matrix bei jedem Render erneut vom Originalfoto ab. */
      const bridgeReleaseState = { progress: 0 };
      const renderBridgeFocus = () => {
        const remaining = 1 - bridgeReleaseState.progress;

        gsap.set(bridgeFocus, {
          x: 0,
          y: 0,
          rotation: 22 * remaining,
          skewX: -2 * remaining,
          scaleX: 1 + 0.02 * remaining,
          scaleY: 1,
          transformOrigin: '0 0',
          /* Solange das Mockup in der Hand sitzt, bleibt es in derselben
             2D-Rasterebene wie das Foto. Eine eigene GPU-Textur würde beim
             Scroll-Scrub minimal anders nachgerastert und als Flackern
             beziehungsweise Nachziehen sichtbar. */
          force3D: bridgeReleaseState.progress > 0,
        });
      };
      const renderBridgeRelease = () => {
        const progress = bridgeReleaseState.progress;

        if (progress <= 0) {
          root.dataset.bridgePhase = 'held';
          gsap.set(bridgeMotion, { x: 0, y: 0, force3D: false });
          bridge.style.removeProperty('height');
          renderBridgeFocus();
          return;
        }

        root.dataset.bridgePhase = 'moving';

        const destination = getBridgeDestination();
        const initialHeight = getInitialBridgeHeight();
        const finalHeight = getFinalBridgeHeight() / zoomAmount;

        gsap.set(bridgeMotion, {
          x: destination.x * progress,
          y: destination.y * progress,
          force3D: true,
        });
        gsap.set(bridge, {
          height: initialHeight + (finalHeight - initialHeight) * progress,
        });
        renderBridgeFocus();
      };
      let bridgeResizeFrame = 0;
      const bridgeResizeObserver = new ResizeObserver(() => {
        window.cancelAnimationFrame(bridgeResizeFrame);
        bridgeResizeFrame = window.requestAnimationFrame(() => {
          /* In der Hand (progress 0) übernimmt CSS ohne Zwischenframe. Nach
             dem Lösen wird die aktuelle Position noch vor dem nächsten Paint
             aus der neuen Bühne berechnet. Während des Weltenwechsels gehört
             die horizontale Bewegung bereits dem nachfolgenden Tween. */
          if (
            bridgeReleaseState.progress > 0 &&
            journeyState !== 'transition' &&
            journeyState !== 'leaving'
          ) {
            renderBridgeRelease();
          }
        });
      });
      bridgeResizeObserver.observe(photo);
      bridgeResizeObserver.observe(sticky);

      gsap.set(photoPlane, {
        scale: 1,
      });
      gsap.set(photoImage, { opacity: 1, filter: 'blur(0px)' });
      gsap.set(grade, { opacity: 0 });
      gsap.set(iris, { opacity: 0 });
      gsap.set(results, { autoAlpha: 0 });
      gsap.set(metas, { opacity: 0, y: '1rem' });
      gsap.set(centerPin, { opacity: 0 });
      gsap.set(ownCards, { opacity: 0 });
      gsap.set(bridgeMotion, {
        x: 0,
        y: 0,
        force3D: false,
      });
      if (!mobile && !compact) {
        gsap.set(photo, {
          width: '40%',
          left: 'auto',
          right: 0,
          clipPath: 'inset(0% 0% 0% 0%)',
        });
      }
      renderBridgeFocus();
      gsap.set(bridge, {
        opacity: 1,
        clipPath: 'inset(0% 0% 0% 0% round 12% / 6%)',
        scale: 1,
        rotation: 0,
        force3D: false,
      });
      gsap.set(hint, { opacity: 0.34 });
      gsap.set(accountsWorld, { opacity: 1, xPercent: 0, scale: 1, force3D: true });
      gsap.set(customersWorld, { opacity: 0, xPercent: worldSlideDistance, scale: 0.985, force3D: true });
      if (customerHero) gsap.set(customerHero, { opacity: 1 });
      gsap.set(customerSatellites, { opacity: 0 });
      gsap.set(accountsLabel, { opacity: 1, x: 0, force3D: true });
      gsap.set(customersLabel, { opacity: 0, x: 26, force3D: true });

      // Die eigene Erfolgswelt bleibt kurz erkundbar, ohne in einer langen
      // Haltephase festzuhängen, bevor die Kundenerfolge in Bewegung kommen.
      const worldTransitionStart = fastMotion ? 68 : 76;
      const worldTransitionDuration = fastMotion ? 13 : 14;
      const worldHoldDuration = fastMotion ? 11 : 10;
      const worldTransitionEnd = worldTransitionStart + worldTransitionDuration;
      const worldTimelineDuration = worldTransitionEnd + worldHoldDuration;
      const worldHandoffProgress = (worldTransitionStart + worldTransitionDuration / 2) / worldTimelineDuration;
      const outgoingWorldDuration = stagedWorldTransition
        ? worldTransitionDuration * 0.6
        : worldTransitionDuration;
      const incomingWorldStart = stagedWorldTransition
        ? worldTransitionStart + worldTransitionDuration * 0.28
        : worldTransitionStart;
      const incomingWorldDuration = stagedWorldTransition
        ? worldTransitionDuration * 0.72
        : worldTransitionDuration;
      const fullFrameMoment = fastMotion ? 29 : 37;
      const blackoutDuration = fastMotion ? 12 : 14;
      const blackoutStart = fullFrameMoment - blackoutDuration;
      const cameraPullStart = fullFrameMoment;
      const resultsRevealStart = fullFrameMoment + 4;
      const bridgeReleaseStart = fullFrameMoment;
      const bridgeReleaseDuration = fastMotion ? 16 : 18;
      const orbitRevealStart = fullFrameMoment + (fastMotion ? 7 : 9);
      const metaRevealStart = fullFrameMoment + (fastMotion ? 18 : 21);
      const irisReleaseStart = fullFrameMoment + 2;
      const accountsLiftStart = Math.max(
        orbitRevealStart + 13 + Math.max(ownCards.length - 1, 0) * 0.45,
        metaRevealStart + 9,
      );
      const customerSatelliteRevealStart = worldTransitionStart + worldTransitionDuration * (mobile ? 0.35 : 0.12);
      const customerSatelliteRevealDuration = worldTransitionDuration * (mobile ? 0.45 : 0.68);
      const customerSatelliteStagger = 0.035;
      const customerLiftStart = Math.max(
        worldTransitionEnd,
        customerSatelliteRevealStart +
          customerSatelliteRevealDuration +
          Math.max(customerSatellites.length - 1, 0) * customerSatelliteStagger,
      );
      const accountsReadyStartProgress = accountsLiftStart / worldTimelineDuration;
      const accountsTransitionStartProgress = worldTransitionStart / worldTimelineDuration;
      const customersReadyStartProgress = customerLiftStart / worldTimelineDuration;
      const leavingStartProgress =
        (worldTimelineDuration - Math.max(2, worldHoldDuration * 0.2)) / worldTimelineDuration;
      const accountsRestProgress =
        (worldTransitionStart - 1.5) / worldTimelineDuration;
      const customersRestProgress =
        (worldTransitionEnd + 1.5) / worldTimelineDuration;
      /* Die erste Magnetzone beginnt bewusst schon kurz vor dem vollständig
         aufgebauten Account-Universum. Visuell ist die Welt zu diesem
         Zeitpunkt bereits eindeutig erkennbar; wer hier aufhört zu scrollen,
         wird sanft in die fertige Ruheposition geführt statt in einem
         unfertigen Zwischenzustand stehen zu bleiben. */
      const snapActivationStart = Math.max(
        0,
        accountsReadyStartProgress - (fastMotion ? 0.11 : 0.12),
      );
      const snapActivationEnd = leavingStartProgress;
      const snapDecisionProgress = (accountsRestProgress + customersRestProgress) / 2;
      let lastTimelineProgress = -1;

      const getJourneyState = (progress: number): JourneyState => {
        if (progress < accountsReadyStartProgress) return 'arrival';
        if (progress < accountsTransitionStartProgress) return 'accounts-ready';
        if (progress < customersReadyStartProgress) return 'transition';
        if (progress < leavingStartProgress) return 'customers-ready';
        return 'leaving';
      };

      setLiftEnabled(false);
      setJourneyState('arrival');

      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: track,
          start: 'top top',
          end: 'bottom bottom',
          scrub: fastMotion ? 0.35 : 0.55,
          snap: {
            snapTo: (progress: number) => {
              if (
                prefersReducedMotion ||
                progress < snapActivationStart ||
                progress > snapActivationEnd
              ) {
                return progress;
              }

              return progress < snapDecisionProgress
                ? accountsRestProgress
                : customersRestProgress;
            },
            /* Beide Welten verwenden dieselbe ruhige Magnetik. Der etwas
               längere Auslauf verhindert das bisher hektische Nachziehen,
               ohne dass sich die Navigation träge anfühlt. */
            duration: {
              min: fastMotion ? 0.38 : 0.44,
              max: fastMotion ? 0.72 : 0.82,
            },
            delay: fastMotion ? 0.16 : 0.18,
            ease: 'sine.inOut',
            inertia: false,
          },
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (
              liftedSource &&
              lastTimelineProgress >= 0 &&
              Math.abs(self.progress - lastTimelineProgress) > 0.0005
            ) {
              clearLift();
            }
            lastTimelineProgress = self.progress;
            setWorld(self.progress >= worldHandoffProgress ? 'customers' : 'accounts');
            setJourneyState(getJourneyState(self.progress));
          },
          onLeave: () => setJourneyState('leaving'),
          onLeaveBack: () => setJourneyState('arrival'),
        },
      });

      if (!mobile && !compact) {
        /* Exakt dieselbe Grundbewegung wie auf der Live-Startseite: Die
           rechte Bildspalte wächst als echte 40-%-Spalte auf volle Breite.
           Kein skalierter Ersatz-Ausschnitt und keine verschobene Bildbühne. */
        timeline.fromTo(
          photo,
          {
            width: '40%',
            left: 'auto',
            right: 0,
            clipPath: 'inset(0% 0% 0% 0%)',
          },
          {
            width: '100%',
            duration: fullFrameMoment,
          },
          0,
        );
        timeline.set(photoEntry, { x: 0, y: 0, scale: 1 }, 0);
      } else {
        timeline
          .fromTo(
            photo,
            {
              clipPath: mobile
                ? 'inset(52% 4vw 3% 4vw round 1.15rem)'
                : 'inset(0% 0% 0% 52%)',
            },
            { clipPath: 'inset(0% 0% 0% 0%)', duration: fullFrameMoment },
            0,
          )
          .fromTo(
            photoEntry,
            {
              x: () => getEntryState().x,
              y: () => getEntryState().y,
              scale: () => getEntryState().scale,
              transformOrigin: '0 0',
            },
            {
              x: 0,
              y: 0,
              scale: 1,
              duration: fullFrameMoment,
            },
            0,
          );
      }

      timeline
        /* Wie im Live-Hero bleibt die Aussage vollständig stehen und wird von
           der wachsenden, deckenden Bildspalte überfahren. Erst wenn das Foto
           wirklich die ganze Bühne abdeckt, wird der nun unsichtbare Text
           abgeschaltet, damit er beim Öffnen der Ergebniswelt nicht wieder
           durchscheinen kann. */
        .set(copy, { opacity: 0 }, fullFrameMoment)
        /* Fotoöffnung und Abdunklung treffen sich am selben Endpunkt. Das
           eingesetzte Handy bleibt bis dahin unverändert in der Hand; erst im
           vollständig schwarzen Bild beginnt ohne Zwischenpause der Pull-in. */
        .to(
          photoPlane,
          {
            scale: zoomAmount,
            duration: resultsRevealStart - cameraPullStart,
            ease: 'power2.in',
          },
          cameraPullStart,
        )
        .to(
          photoImage,
          {
            opacity: 0,
            duration: blackoutDuration,
            ease: 'power2.in',
          },
          blackoutStart,
        )
        .to(grade, { opacity: 1, duration: blackoutDuration, ease: 'power2.in' }, blackoutStart)
        .to(iris, { opacity: 1, duration: blackoutDuration, ease: 'power3.in' }, blackoutStart)
        /* Direkt nach dem schwarzen Match-Punkt öffnet sich bereits die Tiefe
           der Ergebniswelt. Die Bühne bleibt dadurch nicht leer, während das
           Handy zur finalen Größe gezogen wird. */
        .to(results, { autoAlpha: 1, duration: 6, ease: 'power2.inOut' }, resultsRevealStart)
        .to(photo, { backgroundColor: 'rgba(8, 8, 8, 0)', duration: 6, ease: 'power2.inOut' }, resultsRevealStart)
        .to(grade, { opacity: 0, duration: 6 }, resultsRevealStart)
        .to(iris, { opacity: 0, duration: 7, ease: 'power2.out' }, irisReleaseStart)
        /* Erst am gemeinsamen Schwarz-/Vollbild-Endpunkt löst sich das Mockup
           aus der Hand. Der Pull-in schließt direkt an, überlagert das sichtbare
           Foto aber zu keinem Zeitpunkt. */
        .to(
          bridgeReleaseState,
          {
            progress: 1,
            duration: bridgeReleaseDuration,
            ease: 'power2.out',
            onUpdate: renderBridgeRelease,
          },
          bridgeReleaseStart,
        )
        /* Die Kennzahl ist Teil des ankommenden Mockups und kein später
           aufgesetzter Einzel-Effekt. Sie erscheint während der letzten
           Bewegungsetappe gemeinsam mit dem Handy. */
        .to(
          centerPin,
          {
            opacity: 1,
            duration: 6,
            ease: 'power2.out',
          },
          bridgeReleaseStart + bridgeReleaseDuration - 6,
        )
        .to(
          ownCards,
          {
            opacity: 1,
            duration: 13,
            stagger: 0.45,
            ease: 'power3.out',
          },
          orbitRevealStart,
        )
        .to(metas, { opacity: 1, y: 0, duration: 9, ease: 'power2.out' }, metaRevealStart)
        .to(hint, { opacity: 0, duration: 8 }, fastMotion ? 43 : 51)
        /* Beide Konstellationen überlappen sich während des seitlichen
           Wechsels. Die Satelliten bleiben Teil derselben Erfolgswelt, statt
           vor dem nächsten Zentrum vollständig zu verschwinden. */
        .to(
          accountsWorld,
          {
            opacity: 0,
            xPercent: -worldSlideDistance,
            scale: 0.985,
            duration: outgoingWorldDuration,
            ease: 'sine.inOut',
          },
          worldTransitionStart,
        )
        .to(
          bridgeFocus,
          {
            opacity: 0,
            x: `-${worldSlideDistance}vw`,
            duration: outgoingWorldDuration,
            ease: 'sine.inOut',
          },
          worldTransitionStart,
        )
        .to(
          accountsLabel,
          {
            opacity: 0,
            x: -26,
            duration: worldTransitionDuration * 0.42,
            ease: 'sine.inOut',
          },
          worldTransitionStart,
        )
        .to(
          customersWorld,
          {
            opacity: 1,
            xPercent: 0,
            scale: 1,
            duration: incomingWorldDuration,
            ease: stagedWorldTransition ? 'power2.out' : 'sine.inOut',
          },
          incomingWorldStart,
        )
        .to(
          customerSatellites,
          {
            opacity: 1,
            duration: customerSatelliteRevealDuration,
            stagger: customerSatelliteStagger,
            ease: 'power2.out',
          },
          customerSatelliteRevealStart,
        )
        .to(
          customersLabel,
          {
            opacity: 1,
            x: 0,
            duration: worldTransitionDuration * 0.42,
            ease: 'sine.inOut',
          },
          worldTransitionStart + worldTransitionDuration * 0.58,
        )
        /* Kurzer, aber klar wahrnehmbarer Halt der Kundenwelt vor dem
           fließenden Übergang in den nächsten Seitenabschnitt. */
        .to({}, { duration: worldHoldDuration }, worldTransitionEnd);

      return () => {
        root.dataset.bridgePhase = 'held';
        setLiftEnabled(false);
        setJourneyState('arrival');
        timeline.kill();
        bridgeResizeObserver.disconnect();
        window.cancelAnimationFrame(bridgeResizeFrame);
        root.style.removeProperty('--match-center-pin-viewport-scale');
        bridgeFocus.style.removeProperty('transform');
        gsap.set(
          [photo, photoEntry, photoPlane, photoImage, copy, grade, iris, results, bridgeWrap, bridgeMotion, bridgeFocus, bridge, centerPin, accountsWorld, customersWorld, accountsLabel, customersLabel, ...ownCards, ...customerCards, ...metas, hint],
          { clearProps: 'all' },
        );
      };
    };

    mm.add('(min-width: 992px)', () => build({ mobile: false, compact: false }));

    mm.add('(max-width: 991px) and (orientation: portrait)', () => build({ mobile: true, compact: false }));

    mm.add('(max-width: 991px) and (orientation: landscape)', () => build({ mobile: false, compact: true }));

    window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
  }
</script>

<script>
  const coachingTabs = document.querySelector<HTMLElement>('[data-coaching-tabs]');

  if (coachingTabs) {
    const tabButtons = Array.from(
      coachingTabs.querySelectorAll<HTMLButtonElement>('[data-coaching-tab]'),
    );
    const tabPanels = Array.from(
      coachingTabs.querySelectorAll<HTMLElement>('[data-coaching-panel]'),
    );

    const activateChoice = (button: HTMLButtonElement) => {
      const panel = button.closest<HTMLElement>('[data-coaching-panel]');
      if (!panel) return;
      const choices = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-coaching-choice]'));
      const details = Array.from(panel.querySelectorAll<HTMLElement>('[data-coaching-detail]'));

      choices.forEach((choice) => {
        const active = choice === button;
        choice.classList.toggle('is-active', active);
        choice.setAttribute('aria-selected', String(active));
        choice.tabIndex = active ? 0 : -1;
      });
      details.forEach((detail) => {
        detail.hidden = detail.id !== button.getAttribute('aria-controls');
      });
    };

    tabPanels.forEach((panel) => {
      const choices = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-coaching-choice]'));
      choices.forEach((choice, index) => {
        choice.tabIndex = index === 0 ? 0 : -1;
        choice.addEventListener('click', () => activateChoice(choice));
        choice.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const next = choices[(index + direction + choices.length) % choices.length];
          if (!next) return;
          next.focus();
          activateChoice(next);
        });
      });
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.coachingTab;
        if (!target || button.classList.contains('is-active')) return;

        tabButtons.forEach((tab) => {
          const active = tab === button;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
        });
        tabPanels.forEach((panel) => {
          panel.hidden = panel.dataset.coachingPanel !== target;
        });
      });
    });

    tabButtons.forEach((button, index) => {
      button.tabIndex = index === 0 ? 0 : -1;
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabButtons[(index + direction + tabButtons.length) % tabButtons.length];
        next?.focus();
        next?.click();
      });
    });
  }
</script>

