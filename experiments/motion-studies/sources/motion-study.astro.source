    .specific-coachings__choices {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-right: 0;
      border-bottom: 1px solid var(--paper-2);
    }

    .specific-coachings__choice {
      display: flex;
      align-items: center;
      min-height: 5.4rem;
      padding: 0.9rem 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--paper-2);
    }

    .specific-coachings__choice:nth-child(n + 5) {
      border-bottom: 1px solid var(--paper-2);
    }

    .specific-coachings__choice:nth-child(odd) {
      border-right: 1px solid var(--paper-2);
    }

    .specific-coachings__choice:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .specific-coachings__choice:nth-child(even):nth-last-child(2) {
      border-bottom: 1px solid var(--paper-2);
    }

    .specific-coachings__summary strong {
      font-size: clamp(0.88rem, 3.8vw, 1rem);
    }

    .specific-coachings__summary > span {
      display: none;
    }

    .specific-coachings__details {
      min-height: 0;
      padding: 1.5rem;
    }

    .specific-coachings__detail {
      grid-template-columns: 7.25rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: center;
    }

    .specific-coachings__detail-copy {
      display: contents;
    }

    .specific-coachings__detail h3 {
      grid-row: 1;
      grid-column: 2;
    }

    .specific-coachings__detail p {
      grid-row: 2;
      grid-column: 1 / -1;
      margin-top: 1.5rem;
      font-size: 0.92rem;
      line-height: 1.6;
    }
  }

  .match-study__track {
    position: relative;
    height: 355vh;
  }

  .match-study__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    overflow: clip;
    background: #080808;
    isolation: isolate;
  }

  .match-study__copy {
    position: absolute;
    top: 50%;
    left: 7vw;
    z-index: 1;
    width: min(44vw, 40rem);
    transform: translateY(-50%);
    will-change: transform, opacity;
  }

  .match-study__copy h1 {
    margin: 0;
    font-size: clamp(3.5rem, 5.5vw, 5.5rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
  }

  .match-study__copy h1 span {
    display: block;
    font-size: 0.54em;
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.45;
  }

  .match-study__button {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    margin-top: 2.5rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid rgba(154, 122, 51, 0.6);
    border-radius: 999px;
    background: linear-gradient(110deg, rgba(255,255,255,0.02), rgba(154,122,51,0.55));
    font-size: 0.95rem;
  }

  .match-study__photo {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: clip;
    margin: 0;
    background: #080808;
    --match-focus-x: calc(50cqw - 6.663cqh);
    --match-focus-y: 52.54cqh;
    container-name: match-photo;
    container-type: size;
    pointer-events: none;
    will-change: clip-path;
  }

  .match-study__photo-entry {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .match-study__photo-plane {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform-origin: var(--match-focus-x) var(--match-focus-y);
    will-change: transform;
  }

  .match-study__photo-plane > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .match-study__photo-grade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at var(--match-focus-x) var(--match-focus-y), transparent 0 6%, rgba(8,8,8,0.08) 15%, rgba(8,8,8,0.7) 68%),
      linear-gradient(180deg, rgba(0,0,0,0.04), rgba(0,0,0,0.38));
    pointer-events: none;
    will-change: opacity;
  }

  .match-study__iris {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      circle at var(--match-focus-x) var(--match-focus-y),
      transparent 0 5%,
      rgba(8, 8, 8, 0.1) 13%,
      rgba(8, 8, 8, 0.78) 47%,
      #080808 82%
    );
    pointer-events: none;
    will-change: opacity;
  }

  .match-study__results {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: clip;
    background:
      radial-gradient(circle at 50% 50%, rgba(38, 39, 45, 0.22), transparent 35%),
      #080808;
    will-change: opacity;
  }

  .match-study__phone {
    max-width: none;
    object-fit: contain;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .match-study__bridge-wrap .match-study__phone--bridge {
    position: relative;
    top: 0;
    left: 0;
    width: auto;
    height: var(--match-held-phone-height);
    display: block;
    filter: brightness(0.94) saturate(0.92);
    will-change: auto;
  }

  .match-study__bridge-wrap {
    position: absolute;
    /* Top-left und Höhe des eingesetzten Mockups werden direkt aus den
       Originalbildkoordinaten (2440 × 1816) abgeleitet. Container-Units
       laufen synchron mit der echten Fotospalte – auch während eines
       laufenden Resizes und ohne einen nachlaufenden JS-Refresh. */
    --match-held-phone-height: 8.039648cqh;
    top: 48.348018cqh;
    left: calc(50cqw - 6.387665cqh);
    z-index: 4;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  @container match-photo (min-aspect-ratio: 2440 / 1816) {
    .match-study__bridge-wrap {
      --match-held-phone-height: 5.983607cqw;
      top: calc(100cqh - 38.442623cqw);
      left: 45.245902cqw;
    }
  }

  .match-study__bridge-motion {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 0;
    height: 0;
    will-change: auto;
  }

  .match-study__bridge-center {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
  }

  .match-study__bridge-focus {
    position: relative;
    display: block;
    width: max-content;
    transform-origin: 0 0;
    transition: filter 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: auto;
  }

  /* Erst nach dem Match-Punkt löst sich das Mockup aus dem Foto und erhält
     eigene Compositor-Layer. In der Handphase bleibt es bewusst mit den
     Fotopixeln zusammen gerastert, damit beide beim Scrub exakt gleich
     reagieren und kein Mikroflackern entsteht. */
  .match-study[data-bridge-phase='moving'] .match-study__bridge-motion,
  .match-study[data-bridge-phase='moving'] .match-study__bridge-focus {
    will-change: transform;
  }

  .match-study[data-bridge-phase='moving'] .match-study__phone--bridge {
    will-change: height, clip-path;
  }

  @media (min-aspect-ratio: 2440 / 1816) {
    .match-study__photo {
      --match-focus-x: 45.041cqw;
      --match-focus-y: calc(100cqh - 35.323cqw);
    }
  }

  .match-study__eyebrow {
    position: absolute;
    z-index: 7;
    bottom: 4.25rem;
    margin: 0;
    color: rgba(245, 245, 242, 0.54);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    will-change: transform, opacity;
  }

  .match-study__eyebrow {
    display: grid;
    left: max(5vw, calc((100vw - var(--container)) / 2));
    color: var(--accent-fg);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .match-study__eyebrow span {
    display: block;
    grid-area: 1 / 1;
    will-change: transform, opacity;
  }

  .match-study__eyebrow span[data-world-label='customers'] {
    opacity: 0;
    transform: translateX(1.625rem);
  }

  .match-study__world {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    transform: scale(0.985);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .match-study__world--accounts {
    opacity: 1;
    transform: scale(1) translateX(0);
  }

  .match-study__results[data-active-world='accounts'] .match-study__world--accounts,
  .match-study__results[data-active-world='customers'] .match-study__world--customers {
    pointer-events: auto;
  }

  .match-study__world-card {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: block;
    width: auto;
    margin: 0;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    transform:
      translate(-50%, -50%)
      translate(var(--orbit-x), var(--orbit-y))
      rotate(var(--orbit-rotation))
      scale(var(--orbit-scale));
    cursor: default;
    pointer-events: none;
    appearance: none;
  }

  .match-study__world-card:focus-visible {
    outline: none;
  }

  .match-study__world-card:focus-visible .match-study__world-card-visual {
    outline: 1px solid rgba(154, 122, 51, 0.72);
    outline-offset: 0.28rem;
  }

  .match-study__world-card-visual {
    position: relative;
    display: block;
    width: clamp(8rem, 16vw, 14rem);
    opacity: 0.44;
    filter: brightness(0.6) saturate(0.76);
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, filter, opacity;
  }

  .match-study__card-lift {
    position: absolute;
    inset: 0;
    z-index: 6;
    overflow: clip;
    pointer-events: none;
  }

  .match-study[data-lift-open='true'] .match-study__card-lift {
    pointer-events: auto;
  }

  .match-study__world-card.is-lifted {
    top: 50%;
    left: 50%;
    z-index: 1;
    opacity: 1 !important;
    visibility: visible !important;
    transform:
      translate(-50%, -50%)
      translate3d(var(--lift-x, 0px), var(--lift-y, 0px), 0)
      rotate(var(--lift-rotation, 0deg))
      scale(var(--lift-scale, 1));
    cursor: zoom-out;
    pointer-events: auto;
    isolation: isolate;
  }

  .match-study__world-card.is-lifted.is-lift-ready {
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .match-study__world-card.is-lifted .match-study__world-card-visual {
    opacity: 1 !important;
    filter: brightness(1) saturate(1) !important;
    transform: translateY(-1%);
  }

  .match-study__world-card.is-lifted.is-returning .match-study__world-card-visual {
    opacity: var(--lift-return-opacity, 0.52) !important;
    filter: var(--lift-return-filter, brightness(0.68) saturate(0.8)) !important;
    transform: translateY(0);
    transition-duration: 560ms;
  }

  .match-study__world-card.is-lifted.is-returning {
    opacity: 1 !important;
    pointer-events: none;
    transition: transform 580ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .match-study__world-card.is-lift-source {
    visibility: hidden !important;
    pointer-events: none;
  }

  .match-study__world-card.is-lift-source .match-study__world-card-visual {
    opacity: 0 !important;
    transform: none !important;
  }

  .match-study__world-card.is-lift-handoff,
  .match-study__world-card.is-lift-handoff .match-study__world-card-visual,
  .match-study__world-card.is-lift-handoff .match-study__result-pin {
    transition: none !important;
  }

  .match-study[data-lift-open='true'] .match-study__bridge-focus {
    filter: brightness(0.32) saturate(0.62);
  }

  .match-study[data-lift-open='true'] .match-study__own-center-pin {
    opacity: 0 !important;
  }

  .match-study[data-lift-open='true'] .match-study__results .match-study__world-card:not(.is-lift-source) .match-study__world-card-visual {
    opacity: 0.22 !important;
    filter: brightness(0.48) saturate(0.68);
  }

  /* Orbit cards close to a viewport edge grow back into the composition.
     Their outer edge therefore stays fixed instead of being clipped on hover. */
  .match-study__world-card--own:is([data-orbit='2'], [data-orbit='3']) .match-study__world-card-visual,
  .match-study__world-card--customer:is([data-orbit='3'], [data-orbit='4'], [data-orbit='7'], [data-orbit='8'], [data-orbit='11']) .match-study__world-card-visual {
    transform-origin: 50% 100%;
  }

  .match-study__world-card--own:is([data-orbit='4'], [data-orbit='5'], [data-orbit='6'], [data-orbit='7']) .match-study__world-card-visual,
  .match-study__world-card--customer:is([data-orbit='1'], [data-orbit='2'], [data-orbit='9'], [data-orbit='10']) .match-study__world-card-visual {
    transform-origin: 50% 0%;
  }

  .match-study__own-proof {
    width: clamp(10rem, 18vw, 17rem);
    overflow: visible;
    padding: 0.32rem;
    border: 1px solid rgba(164, 168, 191, 0.34);
    border-radius: 1.25rem;
    color: #f5f5f2;
    background: linear-gradient(155deg, rgba(27, 28, 33, 0.96), rgba(4, 4, 5, 0.98));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03),
      0 2rem 3rem rgba(0, 0, 0, 0.7);
  }

  .match-study__own-media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0.95rem;
    background: #050506;
  }

  .match-study__own-media > img {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    object-fit: contain;
  }

  .match-study__world-card[data-orbit='0'] {
    z-index: 3;
    --orbit-x: -30vw;
    --orbit-y: -3vh;
    --orbit-rotation: -4deg;
    --orbit-scale: 0.7;
  }

  .match-study__world-card[data-orbit='1'] {
    z-index: 3;
    --orbit-x: 30vw;
    --orbit-y: -4vh;
    --orbit-rotation: 4deg;
    --orbit-scale: 0.68;
  }

  .match-study__world-card[data-orbit='2'] {
    z-index: 3;
    --orbit-x: -34vw;
    --orbit-y: 23vh;
    --orbit-rotation: -3deg;
    --orbit-scale: 0.52;
  }

  .match-study__world-card[data-orbit='3'] {
    z-index: 3;
    --orbit-x: 34vw;
    --orbit-y: 23vh;
    --orbit-rotation: 3deg;
    --orbit-scale: 0.48;
  }

  .match-study__world-card[data-orbit='4'] {
    z-index: 1;
    --orbit-x: 20vw;
    --orbit-y: -29vh;
    --orbit-rotation: 2deg;
    --orbit-scale: 0.42;
  }

  .match-study__world-card[data-orbit='5'] {
    z-index: 4;
    --orbit-x: -24vw;
    --orbit-y: -27vh;
    --orbit-rotation: -2deg;
    --orbit-scale: 0.58;
  }

  .match-study__world-card[data-orbit='6'] {
    z-index: 1;
    --orbit-x: -44vw;
    --orbit-y: -17vh;
    --orbit-rotation: -4deg;
    --orbit-scale: 0.32;
  }

  .match-study__world-card[data-orbit='7'] {
    z-index: 1;
    --orbit-x: 44vw;
    --orbit-y: -17vh;
    --orbit-rotation: 4deg;
    --orbit-scale: 0.32;
  }

  .match-study__world-card--own:is([data-orbit='0'], [data-orbit='1'], [data-orbit='2'], [data-orbit='3'], [data-orbit='5']) .match-study__world-card-visual {
    opacity: 0.72;
    filter: brightness(0.76) saturate(0.86);
  }

  .match-study__world-card--customer[data-orbit='0'] {
    z-index: 6;
    --orbit-x: 0;
    --orbit-y: 0;
    --orbit-rotation: 0deg;
    --orbit-scale: 1;
    cursor: default;
    pointer-events: none;
  }

  .match-study__world-card--customer[data-orbit='1'] {
    z-index: 3;
    --orbit-x: -28vw;
    --orbit-y: -19vh;
    --orbit-rotation: -3deg;
    --orbit-scale: 0.68;
  }

  .match-study__world-card--customer[data-orbit='2'] {
    z-index: 3;
    --orbit-x: 29vw;
    --orbit-y: -19vh;
    --orbit-rotation: 3deg;
    --orbit-scale: 0.68;
  }

  .match-study__world-card--customer[data-orbit='3'] {
    z-index: 3;
    --orbit-x: -29vw;
    --orbit-y: 21vh;
    --orbit-rotation: -3deg;
    --orbit-scale: 0.6;
  }

  .match-study__world-card--customer[data-orbit='4'] {
    z-index: 3;
    --orbit-x: 28vw;
    --orbit-y: 20vh;
    --orbit-rotation: 3deg;
    --orbit-scale: 0.6;
  }

  .match-study__world-card--customer[data-orbit='5'] {
    z-index: 1;
    --orbit-x: -42vw;
    --orbit-y: -3vh;
    --orbit-rotation: -5deg;
    --orbit-scale: 0.42;
  }

  .match-study__world-card--customer[data-orbit='6'] {
    z-index: 1;
    --orbit-x: 41vw;
    --orbit-y: -3vh;
    --orbit-rotation: 5deg;
    --orbit-scale: 0.42;
  }

  .match-study__world-card--customer[data-orbit='7'] {
    z-index: 1;
    --orbit-x: -42vw;
    --orbit-y: 26vh;
    --orbit-rotation: -4deg;
    --orbit-scale: 0.34;
  }

  .match-study__world-card--customer[data-orbit='8'] {
    z-index: 1;
    --orbit-x: 42vw;
    --orbit-y: 26vh;
    --orbit-rotation: 4deg;
    --orbit-scale: 0.34;
  }

  .match-study__world-card--customer[data-orbit='9'] {
    z-index: 1;
    --orbit-x: -17vw;
    --orbit-y: -31vh;
    --orbit-rotation: -2deg;
    --orbit-scale: 0.34;
  }

  .match-study__world-card--customer[data-orbit='10'] {
    z-index: 1;
    --orbit-x: 17vw;
    --orbit-y: -31vh;
    --orbit-rotation: 2deg;
    --orbit-scale: 0.34;
  }

  .match-study__world-card--customer[data-orbit='11'] {
    z-index: 1;
    --orbit-x: 0;
    --orbit-y: 31vh;
    --orbit-rotation: 0deg;
    --orbit-scale: 0.3;
  }

  .match-study__world-card--customer[data-orbit='0'] .match-study__world-card-visual {
    opacity: 1;
    filter: brightness(0.96) saturate(0.94);
  }

  .match-study__world-card--customer .match-study__world-card-visual {
    opacity: 0.44;
    filter: brightness(0.6) saturate(0.76);
  }

  .match-study__world-card--customer:is([data-orbit='1'], [data-orbit='2'], [data-orbit='3'], [data-orbit='4']) .match-study__world-card-visual {
    opacity: 0.72;
    filter: brightness(0.76) saturate(0.86);
  }

  /* Die Screenshots werden erst in den beiden definierten Ruhepositionen
     interaktiv. Bewegung, Badges, Hover und Fokus folgen damit demselben
     Zustand statt voneinander abweichenden Scroll-Prozentwerten. */
  .match-study[data-journey-state='accounts-ready'] .match-study__world-card--own,
  .match-study[data-journey-state='customers-ready'] .match-study__world-card--customer:not([data-orbit='0']) {
    cursor: zoom-in;
    pointer-events: auto;
  }

  .match-study[data-journey-state='accounts-ready'] .match-study__world-card--own .match-study__world-card-visual,
  .match-study[data-journey-state='customers-ready'] .match-study__world-card--customer:not([data-orbit='0']) .match-study__world-card-visual {
    opacity: 0.52;
    filter: brightness(0.68) saturate(0.8);
  }

  .match-study[data-journey-state='accounts-ready'] .match-study__world-card--own:is([data-orbit='0'], [data-orbit='1'], [data-orbit='2'], [data-orbit='3'], [data-orbit='5']) .match-study__world-card-visual,
  .match-study[data-journey-state='customers-ready'] .match-study__world-card--customer:is([data-orbit='1'], [data-orbit='2'], [data-orbit='3'], [data-orbit='4']) .match-study__world-card-visual {
    opacity: 0.78;
    filter: brightness(0.82) saturate(0.9);
  }

  .match-study__world-card--customer[data-orbit='0'] .match-study__customer-device {
    opacity: 1;
    filter: brightness(0.96) saturate(0.94);
  }

  .match-study__customer-device {
    position: relative;
    display: block;
    width: min(35.712vh, 23.808rem);
    height: min(72vh, 48rem);
    aspect-ratio: 806 / 1625;
    filter: drop-shadow(0 2rem 4rem rgba(0, 0, 0, 0.76));
  }

  .match-study__customer-device-frame {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .match-study__customer-device-screen {
    position: absolute;
    inset: 2.35% 4.65% 2.4%;
    z-index: 3;
    display: block;
    overflow: hidden;
    border-radius: 12% / 6%;
    background: #050607;
  }

.match-study__customer-device-screen > img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  object-fit: contain;
  object-position: 50% 50%;
  background: #050607;
}

  .match-study__customer-proof {
    display: block;
    width: clamp(11.5rem, 20vw, 21rem);
    overflow: visible;
    padding: 0.42rem;
    border: 1px solid rgba(164, 168, 191, 0.38);
    border-radius: 1.35rem;
    color: #f5f5f2;
    background: linear-gradient(155deg, rgba(29, 30, 35, 0.98), rgba(4, 4, 5, 0.98));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.035),
      0 2rem 4rem rgba(0, 0, 0, 0.72);
  }

  .match-study__customer-proof--phone {
    width: clamp(9rem, 14vw, 15.5rem);
    padding: 0.44rem;
    border-color: rgba(164, 168, 191, 0.58);
    border-radius: 2rem;
  }

  .match-study__customer-media {
    position: relative;
    display: grid;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 0.95rem;
    background: #050506;
  }

  .match-study__customer-proof--panel .match-study__customer-media {
    aspect-ratio: 1.48 / 1;
  }

  .match-study__customer-proof--phone .match-study__customer-media {
    aspect-ratio: 806 / 1450;
    border-radius: 1.55rem 1.55rem 1.15rem 1.15rem;
  }

  .match-study__customer-proof--comparison .match-study__customer-media {
    grid-template-rows: 1fr 1fr;
    aspect-ratio: 1.3 / 1;
    gap: 0.3rem;
    padding: 0.3rem;
  }

  .match-study__customer-media > img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
  }

  .match-study__customer-proof--comparison .match-study__customer-media > img {
    border-radius: 0.65rem;
    object-fit: cover;
  }

  .match-study__result-pin {
    position: absolute;
    right: 0.35rem;
    bottom: -0.42rem;
    z-index: 6;
    display: grid;
    width: max-content;
    max-width: min(17rem, calc(100vw - 1.5rem));
    gap: 0.16rem;
    padding: 0.52rem 0.82rem 0.58rem;
    border: 1px solid rgba(245, 245, 242, 0.2);
    border-radius: 999px;
    text-align: left;
    color: #f5f5f2;
    background: rgba(11, 11, 12, 0.94);
    box-shadow: 0 0.7rem 1.6rem rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(12px);
    pointer-events: none;
    transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Nur die wichtigsten Satelliten zeigen ihre Kennzahl permanent.
     Weitere Belege bleiben als Tiefe sichtbar und geben ihren Badge erst bei
     bewusster Interaktion frei. */
  .match-study__world-card--own:is([data-orbit='4'], [data-orbit='6'], [data-orbit='7']) .match-study__result-pin,
  .match-study__world-card--customer:is([data-orbit='5'], [data-orbit='6'], [data-orbit='7'], [data-orbit='8'], [data-orbit='9'], [data-orbit='10'], [data-orbit='11']) .match-study__result-pin {
    opacity: 0;
  }

  /* Beim seitlichen Weltenwechsel bleiben nur die beiden Hauptbelege aktiv.
     Satelliten-Kennzahlen kommen erst zurück, sobald die jeweilige Welt
     eingerastet und damit auch wieder bewusst erkundbar ist. */
  .match-study:not([data-lift-enabled='true']) .match-study__world-card:not(.match-study__world-card--customer[data-orbit='0']) .match-study__result-pin {
    opacity: 0;
  }

  .match-study__world-card.is-lifted[data-orbit] .match-study__result-pin {
    opacity: 1;
  }

  .match-study__own-pin {
    right: 0.35rem;
    bottom: -0.42rem;
  }

  /* Badge-Anker werden redaktionell pro Beleg vergeben. Nur etwa ein Fünftel
     der Badge-Höhe liegt noch auf dem Screenshot; die relevante Kennzahl
     bleibt lesbar und die restliche Fläche öffnet sich zur freien Außenkante. */
  .match-study__world-card[data-pin='top-left'] .match-study__result-pin,
  .match-study__world-card[data-pin='top-right'] .match-study__result-pin {
    top: 0;
    bottom: auto;
    transform: translateY(-78%);
  }

  .match-study__world-card[data-pin='bottom-left'] .match-study__result-pin,
  .match-study__world-card[data-pin='bottom-right'] .match-study__result-pin {
    top: auto;
    bottom: 0;
    transform: translateY(78%);
  }

  .match-study__world-card[data-pin='top-left'] .match-study__result-pin,
  .match-study__world-card[data-pin='bottom-left'] .match-study__result-pin {
    right: auto;
    left: 0.35rem;
  }

  .match-study__world-card[data-pin='top-right'] .match-study__result-pin,
  .match-study__world-card[data-pin='bottom-right'] .match-study__result-pin {
    right: 0.35rem;
    left: auto;
  }

  .match-study__own-center-pin,
  .match-study__world-card--customer[data-orbit='0'] .match-study__customer-pin {
    --match-center-pin-top: 3%;
    --match-center-pin-bottom: auto;
    --match-center-pin-transform:
      translate(-50%, -50%)
      scale(var(--match-center-pin-viewport-scale, 1));
    top: var(--match-center-pin-top, auto);
    right: auto;
    bottom: var(--match-center-pin-bottom, 5%);
    left: 50%;
    width: max-content;
    min-width: 10.5rem;
    max-width: min(16rem, calc(100vw - 1.5rem));
    padding: 0.62rem 1rem 0.68rem;
    border-color: rgba(154, 122, 51, 0.58);
    transform: var(--match-center-pin-transform, translateX(-50%));
    box-shadow:
      0 0.8rem 2rem rgba(0, 0, 0, 0.52),
      0 0 1.4rem rgba(154, 122, 51, 0.12);
    white-space: normal;
  }

  .match-study__own-center-pin {
    --match-center-pin-transform:
      translate(24%, -58%)
      scale(var(--match-center-pin-scale, 1));
    --match-center-pin-top: 0%;
    top: var(--match-center-pin-top);
    right: 0.45rem;
    left: auto;
    transform-origin: 100% 50%;
  }

  .match-study__result-pin strong {
    display: block;
    min-width: 0;
    max-width: 100%;
    font-size: clamp(0.78rem, 1.05vw, 1.08rem);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .match-study__result-pin small {
    display: block;
    min-width: 0;
    max-width: 100%;
    color: rgba(245, 245, 242, 0.57);
    font-size: clamp(0.56rem, 0.66vw, 0.72rem);
    line-height: 1.2;
    letter-spacing: 0.035em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .match-study__customer-speaker {
    position: absolute;
    top: 0.74rem;
    left: 50%;
    z-index: 3;
    width: 28%;
    height: 0.36rem;
    border-radius: 999px;
    background: #030303;
    transform: translateX(-50%);
  }

  @media (hover: hover) {
    .match-study[data-lift-enabled='true']:not([data-lift-open='true']) .match-study__world-card:not(.match-study__world-card--customer[data-orbit='0']):is(:hover, :focus-visible) {
      z-index: 20;
    }

    .match-study[data-lift-enabled='true']:not([data-lift-open='true']) .match-study__world-card:not(.match-study__world-card--customer[data-orbit='0']):is(:hover, :focus-visible) .match-study__world-card-visual {
      opacity: 0.9;
      filter: brightness(0.9) saturate(0.94);
      transform: scale(1.055);
    }
  }

  /* Auch im Fokusmodus behält der Beleg seinen redaktionell gewählten Anker.
     Ein zentriertes Standard-Badge würde gerade bei langen Insight-Screens
     wieder die wichtigsten Zahlen am unteren Rand verdecken. */
  .match-study__card-lift .match-study__world-card.is-lifted .match-study__world-card-visual {
    opacity: 1;
    filter: brightness(1) saturate(1);
  }

  .match-study__card-lift .match-study__world-card.is-lifted .match-study__result-pin {
    opacity: 1;
  }

  @media (min-width: 992px) {
    .match-study__card-lift .match-study__world-card--own.is-lifted .match-study__own-proof {
      width: clamp(17rem, 23vw, 19rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof {
      width: clamp(19rem, 30vw, 23rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof--phone {
      width: clamp(12rem, 19vw, 15rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof--comparison {
      width: clamp(20rem, 28vw, 22rem);
    }
  }

  .match-study__hint {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 8;
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    will-change: opacity;
  }

  /* Bei hohen beziehungsweise fast quadratischen Desktop-Fenstern dürfen die
     Belege nicht wie weit entfernte Randdekorationen wirken. Die Bühne wird
     deshalb kompakter, ohne die klare Zentralhierarchie aufzugeben. */
  @media (min-width: 992px) and (max-aspect-ratio: 4 / 3) {
    .match-study__world-card[data-orbit='0'] {
      --orbit-x: -25vw;
      --orbit-y: -3vh;
      --orbit-scale: 0.78;
    }

    .match-study__world-card[data-orbit='1'] {
      --orbit-x: 25vw;
      --orbit-y: -4vh;
      --orbit-scale: 0.76;
    }

    .match-study__world-card[data-orbit='2'] {
      --orbit-x: -28vw;
      --orbit-y: 22vh;
      --orbit-scale: 0.62;
    }

    .match-study__world-card[data-orbit='3'] {
      --orbit-x: 28vw;
      --orbit-y: 23vh;
      --orbit-scale: 0.6;
    }

    .match-study__world-card[data-orbit='4'] {
      --orbit-x: 14vw;
      --orbit-y: -25vh;
      --orbit-scale: 0.55;
    }

    .match-study__world-card[data-orbit='5'] {
      --orbit-x: -22vw;
      --orbit-y: -27vh;
      --orbit-scale: 0.66;
    }

    .match-study__world-card[data-orbit='6'] {
      --orbit-x: -37vw;
      --orbit-y: -12vh;
      --orbit-scale: 0.42;
    }

    .match-study__world-card[data-orbit='7'] {
      --orbit-x: 39vw;
      --orbit-y: 5vh;
      --orbit-scale: 0.42;
    }

    .match-study__world-card--customer[data-orbit='0'] {
      --orbit-x: 0;
      --orbit-y: 0;
      --orbit-scale: 1;
    }

    .match-study__world-card--customer[data-orbit='1'] {
      --orbit-x: -26vw;
      --orbit-y: -18vh;
      --orbit-scale: 0.74;
    }

    .match-study__world-card--customer[data-orbit='2'] {
      --orbit-x: 26vw;
      --orbit-y: -18vh;
      --orbit-scale: 0.74;
    }

    .match-study__world-card--customer[data-orbit='3'] {
      --orbit-x: -27vw;
      --orbit-y: 21vh;
      --orbit-scale: 0.66;
    }

    .match-study__world-card--customer[data-orbit='4'] {
      --orbit-x: 27vw;
      --orbit-y: 21vh;
      --orbit-scale: 0.66;
    }

    .match-study__world-card--customer[data-orbit='5'] {
      --orbit-x: -36vw;
      --orbit-y: -2vh;
      --orbit-scale: 0.52;
    }

    .match-study__world-card--customer[data-orbit='6'] {
      --orbit-x: 36vw;
      --orbit-y: -2vh;
      --orbit-scale: 0.52;
    }

    .match-study__world-card--customer[data-orbit='7'] {
      --orbit-x: -35vw;
      --orbit-y: 28vh;
      --orbit-scale: 0.44;
    }

    .match-study__world-card--customer[data-orbit='8'] {
      --orbit-x: 35vw;
      --orbit-y: 28vh;
      --orbit-scale: 0.44;
    }

    .match-study__world-card--customer[data-orbit='9'] {
      --orbit-x: -14vw;
      --orbit-y: -30vh;
      --orbit-scale: 0.42;
    }

    .match-study__world-card--customer[data-orbit='10'] {
      --orbit-x: 14vw;
      --orbit-y: -30vh;
      --orbit-scale: 0.42;
    }

    .match-study__world-card--customer[data-orbit='11'] {
      --orbit-x: 0;
      --orbit-y: 31vh;
      --orbit-scale: 0.4;
    }

    .match-study__customer-device {
      width: min(31.744vh, 21.248rem);
      height: min(64vh, 42.5rem);
    }
  }

  @media (max-width: 991px) {
    .match-study__track { height: 315vh; }

    .match-study__copy {
      top: 7rem;
      left: 5vw;
      width: 90vw;
      transform: none;
    }

    .match-study__copy h1 {
      font-size: clamp(2.9rem, 12vw, 4.4rem);
      line-height: 1.12;
    }

    .match-study__button { margin-top: 1.6rem; }

    .match-study__photo-plane > img { object-position: 50% 100%; }

    .match-study__bridge-wrap .match-study__phone--bridge {
      width: auto;
    }

    .match-study__world-card-visual {
      width: clamp(6.8rem, 34vw, 11rem);
    }

    .match-study__world-card--own .match-study__own-proof {
      width: clamp(8.5rem, 42vw, 13rem);
    }

    .match-study__customer-proof {
      width: clamp(9rem, 52vw, 13rem);
    }

    .match-study__customer-proof--phone {
      width: clamp(7.2rem, 38vw, 10.5rem);
    }

    .match-study__customer-device {
      width: min(33.728vh, 72.912vw, 17.794rem);
      height: min(68vh, 147vw, 35.875rem);
    }

    .match-study__own-center-pin,
    .match-study__world-card--customer[data-orbit='0'] .match-study__customer-pin {
      top: var(--match-center-pin-top, auto);
      right: auto;
      bottom: var(--match-center-pin-bottom, 5%);
      left: 50%;
      max-width: min(11rem, 58vw);
      transform: var(--match-center-pin-transform, translateX(-50%));
    }

    .match-study__own-center-pin {
      --match-center-pin-top: 0%;
      top: var(--match-center-pin-top);
      right: 0.35rem;
      left: auto;
      transform: var(--match-center-pin-transform);
    }

    .match-study__world-card[data-orbit='0'] {
      --orbit-x: -25vw;
      --orbit-y: -3vh;
      --orbit-scale: 0.78;
    }

    .match-study__world-card[data-orbit='1'] {
      --orbit-x: 25vw;
      --orbit-y: -4vh;
      --orbit-scale: 0.76;
    }

    .match-study__world-card[data-orbit='2'] {
      --orbit-x: -28vw;
      --orbit-y: 23vh;
      --orbit-scale: 0.65;
    }

    .match-study__world-card[data-orbit='3'] {
      --orbit-x: 28vw;
      --orbit-y: 24vh;
      --orbit-scale: 0.63;
    }

    .match-study__world-card[data-orbit='4'] {
      --orbit-x: 14vw;
      --orbit-y: -25vh;
      --orbit-scale: 0.61;
    }

    .match-study__world-card[data-orbit='5'] {
      --orbit-x: -22vw;
      --orbit-y: -27vh;
      --orbit-scale: 0.7;
    }

    .match-study__world-card[data-orbit='6'] {
      --orbit-x: -35vw;
      --orbit-y: -13vh;
      --orbit-scale: 0.48;
    }

    .match-study__world-card[data-orbit='7'] {
      --orbit-x: 40vw;
      --orbit-y: 4vh;
      --orbit-scale: 0.48;
    }

    .match-study__world-card--customer[data-orbit='0'] {
      --orbit-x: 0;
      --orbit-y: 0;
      --orbit-scale: 1;
    }

    .match-study__world-card--customer[data-orbit='1'] {
      --orbit-x: -28vw;
      --orbit-y: -18vh;
      --orbit-scale: 0.64;
    }

    .match-study__world-card--customer[data-orbit='2'] {
      --orbit-x: 28vw;
      --orbit-y: -18vh;
      --orbit-scale: 0.64;
    }

    .match-study__world-card--customer[data-orbit='3'] {
      --orbit-x: -29vw;
      --orbit-y: 21vh;
      --orbit-scale: 0.6;
    }

    .match-study__world-card--customer[data-orbit='4'] {
      --orbit-x: 29vw;
      --orbit-y: 21vh;
      --orbit-scale: 0.6;
    }

    .match-study__world-card--customer[data-orbit='5'] {
      --orbit-x: -35vw;
      --orbit-y: -2vh;
      --orbit-scale: 0.5;
    }

    .match-study__world-card--customer[data-orbit='6'] {
      --orbit-x: 35vw;
      --orbit-y: -2vh;
      --orbit-scale: 0.5;
    }

    .match-study__world-card--customer[data-orbit='7'] {
      --orbit-x: -34vw;
      --orbit-y: 29vh;
      --orbit-scale: 0.44;
    }

    .match-study__world-card--customer[data-orbit='8'] {
      --orbit-x: 34vw;
      --orbit-y: 29vh;
      --orbit-scale: 0.44;
    }

    .match-study__world-card--customer[data-orbit='9'] {
      --orbit-x: -14vw;
      --orbit-y: -29vh;
      --orbit-scale: 0.42;
    }

    .match-study__world-card--customer[data-orbit='10'] {
      --orbit-x: 14vw;
      --orbit-y: -29vh;
      --orbit-scale: 0.42;
    }

    .match-study__world-card--customer[data-orbit='11'] {
      --orbit-x: 0;
      --orbit-y: 31vh;
      --orbit-scale: 0.4;
    }

    .match-study__eyebrow { bottom: 3.5rem; }
    .match-study__hint { display: none; }

    /* Kleine Ansichten verwenden eine fokussierte Abfolge statt einer
       verkleinerten Desktop-Collage. In Bewegung verschwinden die Satelliten
       als Gruppe; dadurch kreuzen sich nur noch die beiden Hauptmotive in
       einer kurzen, kontrollierten Uebergabe. In den Ruhepositionen kommen
       die Belege wieder zurueck und bleiben voll interaktiv. */
    .match-study[data-journey-state='transition'] .match-study__world-card--own .match-study__world-card-visual,
    .match-study[data-journey-state='transition'] .match-study__world-card--customer:not([data-orbit='0']) .match-study__world-card-visual {
      opacity: 0 !important;
      filter: brightness(0.38) saturate(0.62) !important;
      transform: scale(0.94);
      transition-duration: 260ms;
    }

    .match-study[data-journey-state='transition'] .match-study__own-center-pin,
    .match-study[data-journey-state='transition'] .match-study__world-card--customer[data-orbit='0'] .match-study__customer-pin {
      opacity: 0 !important;
      transition: opacity 220ms ease;
    }

    /* Wenige priorisierte Belege bilden die hellere erste Raumebene. Die
       restlichen erzeugen Tiefe und werden erst im Fokusmodus dominant. */
    .match-study[data-journey-state='accounts-ready'] .match-study__world-card--own .match-study__world-card-visual,
    .match-study[data-journey-state='customers-ready'] .match-study__world-card--customer:not([data-orbit='0']) .match-study__world-card-visual {
      opacity: 0.3;
      filter: brightness(0.56) saturate(0.72);
    }

    .match-study[data-journey-state='accounts-ready'] .match-study__world-card--own:is([data-orbit='0'], [data-orbit='1'], [data-orbit='4'], [data-orbit='5']) .match-study__world-card-visual,
    .match-study[data-journey-state='customers-ready'] .match-study__world-card--customer:is([data-orbit='1'], [data-orbit='2'], [data-orbit='3'], [data-orbit='4']) .match-study__world-card-visual {
      opacity: 0.58;
      filter: brightness(0.7) saturate(0.82);
    }

    .match-study[data-journey-state='accounts-ready'] .match-study__own-center-pin,
    .match-study[data-journey-state='customers-ready'] .match-study__world-card--customer[data-orbit='0'] .match-study__customer-pin {
      transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @media (max-width: 991px) and (orientation: landscape) {
    .match-study__copy {
      top: 50%;
      left: 4vw;
      width: 44vw;
      transform: translateY(-50%);
    }

    .match-study__copy h1 {
      font-size: clamp(2.2rem, 5vw, 4.2rem);
      line-height: 1.08;
    }

    .match-study__button { margin-top: 1.35rem; }
  }

  /* Auf Touch-Geräten wird der angetippte Satellit aus seiner kleinen
     Umlaufbahn in eine klar lesbare, aber weiterhin kompakte Vordergrundebene
     gesetzt. Unterschiedliche Formate behalten dabei ihr Seitenverhältnis. */
  @media (max-width: 991px) and (hover: none) {
    .match-study__card-lift {
      z-index: 9;
    }

    .match-study__card-lift .match-study__world-card.is-lifted {
      top: 50%;
      left: 50%;
      pointer-events: auto;
      cursor: zoom-out;
    }

    .match-study__card-lift .match-study__world-card.is-lifted .match-study__world-card-visual {
      opacity: 1;
      filter: brightness(1) saturate(1);
      transform: translateY(-1%);
    }

    .match-study__card-lift .match-study__world-card.is-lifted.is-returning .match-study__world-card-visual {
      opacity: var(--lift-return-opacity, 0.52);
      filter: brightness(0.68) saturate(0.8);
      transform: translateY(0);
    }

    .match-study__card-lift .match-study__world-card--own.is-lifted .match-study__own-proof {
      width: min(70vw, 18rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof {
      width: min(76vw, 19rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof--phone {
      width: min(54vw, 13.5rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof--comparison {
      width: min(78vw, 19.5rem);
    }
  }

  @media (max-width: 991px) and (hover: none) and (orientation: landscape) {
    .match-study__card-lift .match-study__world-card--own.is-lifted .match-study__own-proof {
      width: min(27vw, 13rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof {
      width: min(44vw, 20rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof--phone {
      width: min(22vw, 10.5rem);
    }

    .match-study__card-lift .match-study__world-card--customer.is-lifted .match-study__customer-proof--comparison {
      width: min(40vw, 18rem);
    }
  }

  @media (max-width: 767px) and (orientation: portrait) {
    .match-study__customer-device {
      width: min(30.752vh, 66.132vw, 16.368rem);
      height: min(62vh, 133.92vw, 32.75rem);
    }

    /* Auf Touch-Geräten würden mehrere permanente Kennzahlen zwangsläufig
       über dem zentralen Mockup liegen. Dort bleiben nur die beiden zentralen
       Kennzahlen sichtbar; Satelliten zeigen ihr Badge beim Antippen. */
    .match-study__world-card--own .match-study__result-pin,
    .match-study__world-card--customer:not([data-orbit='0']) .match-study__result-pin {
      opacity: 0;
    }

    .match-study__world-card.is-lifted[data-orbit] .match-study__result-pin {
      opacity: 1;
    }
  }

